<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Widgets\Timetable\Timetable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CoursePalette touches Avalonia.Media.Color; the widget itself keeps Avalonia private.
         The host assembly chain (touched while constructing the views) expects the Debug-only
         diagnostics hook and the Fluent theme that the app itself carries. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
