<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The real widget assemblies under test are referenced directly; several widgets need the
         Windows TFM, so the probe targets the same TFM as UiFoundationChecks. -->
