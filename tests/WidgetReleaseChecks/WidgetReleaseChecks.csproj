    <ProjectReference Include="..\..\src\Widgets\Clock\Clock.csproj" />
    <ProjectReference Include="..\..\src\Widgets\ControlCenter\ControlCenter.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Fixed\Fixed.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Folders\Folders.csproj" />
