<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM: some migrated widgets (Music) are platform-specific; the host and the
         remaining widgets are net10.0 and stay referenceable from here. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\..\src\DeskCanvas.Core\DeskCanvas.Core.csproj" />
    <ProjectReference Include="..\..\src\DeskCanvas\DeskCanvas.csproj" />
    <!-- The W4 scroll-ownership checks instantiate the REAL migrated settings pages. -->
    <ProjectReference Include="..\..\src\Widgets\Productivity\Timetable\Timetable.csproj" />
    <ProjectReference Include="..\..\src\Widgets\ClockCalendar\Clock\Clock.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Picture\Picture.csproj" />
    <!-- The W6 compound-input checks instantiate the REAL migrated colour rows. -->
    <ProjectReference Include="..\..\src\Widgets\Productivity\TimeProgress\TimeProgress.csproj" />
    <!-- The W5 icon-button/header checks instantiate the REAL migrated views/pages. -->
    <ProjectReference Include="..\..\src\Widgets\Utilities\Toolbox\Toolbox.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Productivity\Notes\Notes.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Music\Music.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Launcher\Search\Search.csproj" />
    <!-- W7–W10 instantiate the real popups / settings pages / host decoupling surfaces, so every
         widget assembly is referenceable up front (a package must never need to edit this file). -->
    <ProjectReference Include="..\..\src\Widgets\Weather\Weather\Weather.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Container\Stack\Stack.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Hitokoto\Hitokoto.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Productivity\Reminders\Reminders.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Map\Map.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Launcher\Folders\Folders.csproj" />
    <ProjectReference Include="..\..\src\Widgets\SystemStatus\Storage\Storage.csproj" />
    <ProjectReference Include="..\..\src\Widgets\SystemStatus\Batteries\Batteries.csproj" />
    <ProjectReference Include="..\..\src\Widgets\SystemStatus\Monitor\Monitor.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Container\Aggregate\Aggregate.csproj" />
    <ProjectReference Include="..\..\src\Widgets\ClockCalendar\Calendar\Calendar.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Productivity\Pomodoro\Pomodoro.csproj" />
    <ProjectReference Include="..\..\src\Widgets\SystemStatus\ControlCenter\ControlCenter.csproj" />
  </ItemGroup>

</Project>
