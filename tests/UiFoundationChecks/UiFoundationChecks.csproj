<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM: some migrated widgets (Music) are platform-specific; the host and the
         remaining widgets are net8.0 and stay referenceable from here. -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\..\src\DeskCanvas.Core\DeskCanvas.Core.csproj" />
    <ProjectReference Include="..\..\src\DeskCanvas\DeskCanvas.csproj" />
    <!-- The W4 scroll-ownership checks instantiate the REAL migrated settings pages. -->
    <ProjectReference Include="..\..\src\Widgets\Timetable\Timetable.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Clock\Clock.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Picture\Picture.csproj" />
    <!-- The W6 compound-input checks instantiate the REAL migrated colour rows. -->
    <ProjectReference Include="..\..\src\Widgets\Progress\Progress.csproj" />
    <!-- The W5 icon-button/header checks instantiate the REAL migrated views/pages. -->
    <ProjectReference Include="..\..\src\Widgets\Tools\Tools.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Notes\Notes.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Music\Music.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Search\Search.csproj" />
    <!-- W7–W10 instantiate the real popups / settings pages / host decoupling surfaces, so every
         widget assembly is referenceable up front (a package must never need to edit this file). -->
    <ProjectReference Include="..\..\src\Widgets\Weather\Weather.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Stack\Stack.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Hitokoto\Hitokoto.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Reminders\Reminders.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Map\Map.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Folders\Folders.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Storage\Storage.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Batteries\Batteries.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Monitor\Monitor.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Fixed\Fixed.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Calendar\Calendar.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Pomodoro\Pomodoro.csproj" />
    <ProjectReference Include="..\..\src\Widgets\ControlCenter\ControlCenter.csproj" />
  </ItemGroup>

</Project>
