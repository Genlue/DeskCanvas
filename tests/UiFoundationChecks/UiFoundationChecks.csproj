<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM: some migrated widgets (Music) are platform-specific; the host and the
         remaining widgets are net8.0 and stay referenceable from here. -->
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\..\src\DeskCanvas.Core\DeskCanvas.Core.csproj" />
    <ProjectReference Include="..\..\src\DeskCanvas\DeskCanvas.csproj" />
    <!-- The W4 scroll-ownership checks instantiate the REAL migrated settings pages. -->
    <ProjectReference Include="..\..\src\Widgets\Timetable\Timetable.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Clock\Clock.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Picture\Picture.csproj" />
    <!-- The W5 icon-button/header checks instantiate the REAL migrated views/pages. -->
    <ProjectReference Include="..\..\src\Widgets\Tools\Tools.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Notes\Notes.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Music\Music.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Search\Search.csproj" />
  </ItemGroup>

</Project>
