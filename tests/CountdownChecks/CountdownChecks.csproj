<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Widgets\Productivity\Countdown\Countdown.csproj" />
    <!-- The view model drives UpdateTimer (TimerService), which also listens to
         Microsoft.Win32.SystemEvents for the session-unlock refresh: the host project has to be
         referenced directly, because the widget's own reference to it is runtime-excluded. -->
    <ProjectReference Include="..\..\src\DeskCanvas\DeskCanvas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
