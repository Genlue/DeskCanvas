<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Music widget assembly targets net10.0-windows10.0.19041.0 (WinRT SMTC), so the
         probe must match that TFM to reference it. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <ProjectReference Include="..\..\src\DeskCanvas.Contracts\DeskCanvas.Contracts.csproj" />
    <ProjectReference Include="..\..\src\DeskCanvas.Runtime\DeskCanvas.Runtime.csproj" />
    <!-- The P8 batch E media/interaction widgets, checked by direct construction (no host pipeline). -->
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Picture\Picture.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Music\Music.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Lifestyle\Map\Map.csproj" />
    <ProjectReference Include="..\..\src\Widgets\Productivity\Pomodoro\Pomodoro.csproj" />
  </ItemGroup>
</Project>
