<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskCanvas.WinUI.Controls.SharedStatusPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 业务状态呈现（旧 SharedStatusPresenter 的 WinUI 版，报告 §3 第二步第七行）：
         加载 → ProgressRing；空/就绪 → 文本；过期 → 警告 InfoBar；错误 → 错误 InfoBar。

         文案由调用方注入（业务文案不从控件里长出来）。 -->
    <StackPanel x:Name="RootPanel" Spacing="8">
        <InfoBar x:Name="StatusBar"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Error">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Visibility="Collapsed" Click="OnRetryClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel x:Name="MessageRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <ProgressRing x:Name="LoadingRing"
                          Width="16" Height="16"
                          IsActive="False"
                          Visibility="Collapsed"
                          VerticalAlignment="Center" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Style="{StaticResource HostCaptionTextStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
