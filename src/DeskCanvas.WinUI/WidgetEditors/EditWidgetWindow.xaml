<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskCanvas.WinUI.WidgetEditors.EditWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 组件编辑窗口（报告 §3 第三步）：普通应用窗口、可调整大小；正文只有这一个滚动容器。
         标题/副标题、按钮文案全部由 code-behind 读 Locale 设置，XAML 里不留用户可见文案。-->
    <Grid Background="{ThemeResource HostPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Padding="{StaticResource HostPanelHeaderPadding}"
              ColumnSpacing="12"
              Background="{ThemeResource HostPageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource HostTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource HostCaptionTextStyle}" />
            </StackPanel>

            <Button x:Name="SaveButton" Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick" />
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="16,0,16,8"
                 Severity="Error" IsOpen="False" IsClosable="True" />

        <!-- 单一内容滚动容器：页面自己不再套 ScrollViewer（与旧 EditWidget 的 Host 滚动所有权一致）。
             横向永远禁用，页面只允许纵向增长。-->
        <ScrollViewer x:Name="ContentViewport" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled">
            <ContentPresenter x:Name="PageHost" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</Window>
