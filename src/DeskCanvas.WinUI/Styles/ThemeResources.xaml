<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      新 GUI 的语义资源集中处（报告 §3 第二步末行）。页面与控件一律引用这里的 Token，
      不在每页散落圆角/间距/字号/颜色字面量。


      命名约定：Host* = 软件 GUI 语义 Token（不跟随组件主题），控件自身只做布局与交互；
      需要按窗口主题覆盖时，窗口在自己的 Resources 里重定义同名键即可。

      颜色一律成对给出前景/背景，避免只改背景造成白字白底（报告 §4.1）。

    -->

    <!-- ===================== 语义画刷（按主题成对） ===================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- 表面与描边 -->
            <SolidColorBrush x:Key="HostPageBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="HostCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HostCardBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="HostSurfaceSubtleBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="HostDividerBrush" Color="#17000000" />
            <SolidColorBrush x:Key="HostPanelBackgroundBrush" Color="#FFF7F7F8" />
            <SolidColorBrush x:Key="HostPanelBorderBrush" Color="#1F000000" />

            <!-- 文本（与上面的表面成对） -->
            <SolidColorBrush x:Key="HostTextPrimaryBrush" Color="#FF1A1A1C" />
            <SolidColorBrush x:Key="HostTextSecondaryBrush" Color="#FF5F5F64" />
            <SolidColorBrush x:Key="HostTextTertiaryBrush" Color="#FF8A8A8F" />
            <SolidColorBrush x:Key="HostTextOnAccentBrush" Color="#FFFFFFFF" />

            <!-- 交互态 -->
            <SolidColorBrush x:Key="HostHoverBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="HostPressedBrush" Color="#17000000" />
            <SolidColorBrush x:Key="HostInputBorderBrush" Color="#26000000" />
            <SolidColorBrush x:Key="HostFocusBorderBrush" Color="#FF005FB8" />

            <!-- 强调色 / 状态色 -->
            <SolidColorBrush x:Key="HostAccentBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="HostAccentTextBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="HostErrorBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="HostWarningBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="HostSuccessBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="HostSelectionRingBrush" Color="#FF005FB8" />

            <!-- 徽标 -->
            <SolidColorBrush x:Key="HostBadgeBackgroundBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="HostBadgeForegroundBrush" Color="#FF5F5F64" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HostPageBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="HostCardBackgroundBrush" Color="#FF2C2C2E" />
            <SolidColorBrush x:Key="HostCardBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="HostSurfaceSubtleBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HostDividerBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="HostPanelBackgroundBrush" Color="#F22C2C2E" />
            <SolidColorBrush x:Key="HostPanelBorderBrush" Color="#26FFFFFF" />

            <SolidColorBrush x:Key="HostTextPrimaryBrush" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="HostTextSecondaryBrush" Color="#FFB4B4B9" />
            <SolidColorBrush x:Key="HostTextTertiaryBrush" Color="#FF8C8C92" />
            <SolidColorBrush x:Key="HostTextOnAccentBrush" Color="#FF000000" />

            <SolidColorBrush x:Key="HostHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HostPressedBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="HostInputBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="HostFocusBorderBrush" Color="#FF4CC2FF" />

            <SolidColorBrush x:Key="HostAccentBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="HostAccentTextBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="HostErrorBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="HostWarningBrush" Color="#FFFCE100" />
            <SolidColorBrush x:Key="HostSuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="HostSelectionRingBrush" Color="#FF4CC2FF" />

            <SolidColorBrush x:Key="HostBadgeBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="HostBadgeForegroundBrush" Color="#FFB4B4B9" />
        </ResourceDictionary>

        <!-- 高对比度：全部改用系统色，保证用户自定义配色下仍可读（报告 §6.7）。 -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HostPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HostCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HostCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostSurfaceSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HostDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HostPanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="HostTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostTextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="HostHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HostPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HostInputBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostFocusBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="HostAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HostAccentTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HostSelectionRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="HostBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HostBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================== 几何 / 字号 / 间距 Token ===================== -->

    <!-- 圆角：用 CornerRadius 类型（而不是 Double），这样可以直接赋给 CornerRadius 属性。 -->
    <CornerRadius x:Key="HostWindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="HostCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="HostControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="HostPanelCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="HostBadgeCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="HostSampleCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="HostSampleCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="HostIconButtonCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="HostIconButtonCompactCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="HostThemeSampleRingCornerRadius">12</CornerRadius>

    <Thickness x:Key="HostPagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="HostCardPadding">16</Thickness>
    <Thickness x:Key="HostRowPadding">16,12,16,12</Thickness>
    <Thickness x:Key="HostSectionHeaderMargin">0,12,0,4</Thickness>
    <Thickness x:Key="HostDividerMargin">0,8,0,8</Thickness>
    <Thickness x:Key="HostBadgePadding">7,2,7,2</Thickness>
    <Thickness x:Key="HostCardBorderThickness">1</Thickness>
    <Thickness x:Key="HostPanelContentPadding">16,14,16,12</Thickness>
    <Thickness x:Key="HostPanelHeaderPadding">16,12,16,10</Thickness>
    <Thickness x:Key="HostPanelFooterPadding">16,10,16,12</Thickness>
    <Thickness x:Key="HostThemeSampleButtonPadding">3</Thickness>
    <Thickness x:Key="HostThemeSampleCardMargin">0,0,14,14</Thickness>

    <x:Double x:Key="HostRowSpacing">12</x:Double>
    <x:Double x:Key="HostSectionSpacing">20</x:Double>
    <x:Double x:Key="HostRowGap">12</x:Double>
    <x:Double x:Key="HostIconGap">14</x:Double>
    <x:Double x:Key="HostEditorGap">8</x:Double>
    <x:Double x:Key="HostLabelMinWidth">160</x:Double>
    <x:Double x:Key="HostRowHysteresis">16</x:Double>

    <!-- 字号：与旧样式表 FontSizeCaption/Body/Title 同一档位，便于逐页对照搬迁。 -->
    <x:Double x:Key="HostFontSizeCaption">12</x:Double>
    <x:Double x:Key="HostFontSizeBadge">11</x:Double>
    <x:Double x:Key="HostFontSizeSectionHeader">13</x:Double>
    <x:Double x:Key="HostFontSizeBody">14</x:Double>
    <x:Double x:Key="HostFontSizeTitle">16</x:Double>
    <x:Double x:Key="HostFontSizeLargeTitle">20</x:Double>
    <x:Double x:Key="HostLabelGroupSpacing">3</x:Double>

    <!-- 控件尺寸 -->
    <x:Double x:Key="HostIconButtonSize">28</x:Double>
    <x:Double x:Key="HostIconButtonCompactSize">24</x:Double>
    <x:Double x:Key="HostSettingIconSize">20</x:Double>
    <x:Double x:Key="HostControlMinHeight">32</x:Double>
    <x:Double x:Key="HostColorSwatchWidth">30</x:Double>
    <x:Double x:Key="HostColorSwatchHeight">22</x:Double>
    <x:Double x:Key="HostColorHexMinWidth">112</x:Double>
    <x:Double x:Key="HostSliderValueMinWidth">44</x:Double>
    <x:Double x:Key="HostNumberBoxMinWidth">112</x:Double>
    <x:Double x:Key="HostDividerThickness">1</x:Double>
    <x:Double x:Key="HostThemeSampleWidth">120</x:Double>
    <x:Double x:Key="HostThemeSampleHeight">90</x:Double>
    <x:Double x:Key="HostThemeSampleCardSize">45</x:Double>
    <x:Double x:Key="HostSampleRadius">8</x:Double>
    <x:Double x:Key="HostThemeSampleFontSize">24</x:Double>

    <!-- 符号字体：Segoe MDL2 Assets 在 Windows 10/11 都存在；换 Segoe Fluent Icons 前先确认目标机。 -->
    <FontFamily x:Key="HostSymbolFont">Segoe MDL2 Assets</FontFamily>

    <!-- 常用图标字形（FontIcon.Glyph 用字符串资源；PathIcon 仍可自行写矢量） -->
    <x:String x:Key="HostGlyphAdd">&#xE710;</x:String>
    <x:String x:Key="HostGlyphDelete">&#xE74D;</x:String>
    <x:String x:Key="HostGlyphEdit">&#xE70F;</x:String>
    <x:String x:Key="HostGlyphRefresh">&#xE72C;</x:String>
    <x:String x:Key="HostGlyphSettings">&#xE713;</x:String>
    <x:String x:Key="HostGlyphClose">&#xE711;</x:String>
    <x:String x:Key="HostGlyphCheck">&#xE73E;</x:String>
    <x:String x:Key="HostGlyphChevronDown">&#xE70D;</x:String>
    <x:String x:Key="HostGlyphColor">&#xE790;</x:String>

    <!-- 主题样片的模拟桌面壁纸（与 App 主题无关：它展示的是“桌面上看这个材质”的效果）。 -->
    <LinearGradientBrush x:Key="HostSampleWallpaperBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5B8DEF" Offset="0" />
        <GradientStop Color="#FF7E6BEA" Offset="0.5" />
        <GradientStop Color="#FFF2A65B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HostSampleDimBrush" Color="#40000000" />
    <SolidColorBrush x:Key="HostAcrylicSampleBrush" Color="#B3FFFFFF" />
    <LinearGradientBrush x:Key="HostGlassSampleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#33FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HostFullColorDarkSampleBrush" Color="#E61C1C1E" />
    <SolidColorBrush x:Key="HostFullColorLightSampleBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="HostSampleTextLightBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HostSampleTextDarkBrush" Color="#FF1A1A1C" />
    <SolidColorBrush x:Key="HostSampleAccentTextBrush" Color="#FFFF453A" />
    <SolidColorBrush x:Key="HostSampleRimBrush" Color="#66FFFFFF" />

    <!-- ===================== 共享样式 ===================== -->

    <!-- 设置分组标题（原 SettingsSectionHeader.axaml 的等价物） -->
    <Style x:Key="HostSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeSectionHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HostAccentTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource HostSectionHeaderMargin}" />
    </Style>

    <!-- 设置行文本（SettingRow 由代码创建部件后套用这里，保证深浅主题成对） -->
    <Style x:Key="HostSettingTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource HostTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HostSettingSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource HostTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HostSettingHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource HostTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HostCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource HostTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HostTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HostTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 图标按钮（原 IconButton.axaml：圆角图标钮 / 紧凑工具钮）。

         只设尺寸与静止外观，hover/pressed/focus 仍由 Fluent 模板提供，避免复制模板。 -->
    <Style x:Key="HostIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource HostIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource HostIconButtonSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HostIconButtonCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="HostIconButtonCompactStyle" TargetType="Button" BasedOn="{StaticResource HostIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource HostIconButtonCompactSize}" />
        <Setter Property="Height" Value="{StaticResource HostIconButtonCompactSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource HostIconButtonCompactCornerRadius}" />
    </Style>
    <Style x:Key="HostToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HostControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 徽标（原 StatusBadge.axaml） -->
    <Style x:Key="HostBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HostBadgeBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource HostBadgeCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource HostBadgePadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="HostBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HostFontSizeBadge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HostBadgeForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片（原 CardBox.axaml） -->
    <Style x:Key="HostCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HostCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HostCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HostCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource HostCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource HostCardPadding}" />
    </Style>
    <Style x:Key="HostSubtleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource HostSurfaceSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HostControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource HostCardPadding}" />
    </Style>

    <!-- 分隔线 -->
    <Style x:Key="HostDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource HostDividerThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource HostDividerBrush}" />
        <Setter Property="Margin" Value="{StaticResource HostDividerMargin}" />
    </Style>

    <!-- 色块按钮（ColorInput 的拾色入口）：只提供点击区域与焦点，色块本身由控件画。 -->
    <Style x:Key="HostColorSwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource HostColorSwatchWidth}" />
        <Setter Property="Height" Value="{StaticResource HostColorSwatchHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HostControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 主题样片：整块可点，但静止/悬停外壳保持透明，选中环由控件自己画。 -->
    <Style x:Key="HostThemeSampleButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource HostThemeSampleButtonPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HostSampleCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>