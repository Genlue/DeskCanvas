<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared icon-button family. One canonical interaction contract — background,
         border, hover/pressed, disabled, keyboard focus, content alignment — split into the
         two shapes:
           - dc-icon-button      circle title/close button (28 DIP), optional .compact (24)
           - dc-toolbar-button   rectangular tool button (radius 6), natural size; .compact (24)
         Transition aliases:
           - Button.icon-btn      → the circle contract
           - Button.icon-button   → the compact toolbar contract (Music/Search settings) -->
    <Style Selector="Button.dc-icon-button, Button.icon-btn">
        <Setter Property="Width" Value="{DynamicResource IconButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <!-- Half of IconButtonSize: the circle. -->
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.dc-icon-button:pointerover, Button.icon-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.dc-icon-button:pressed, Button.icon-btn:pressed">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="Button.dc-icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.dc-icon-button:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="Button.dc-icon-button.compact">
        <Setter Property="Width" Value="{DynamicResource IconButtonCompactSize}" />
        <Setter Property="Height" Value="{DynamicResource IconButtonCompactSize}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Rectangular tool button: keeps the page's own size (no Width/Height), radius 6. -->
    <Style Selector="Button.dc-toolbar-button">
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- Transition alias: compact toolbar (24 DIP). -->
    <Style Selector="Button.icon-button">
        <Setter Property="Width" Value="{DynamicResource IconButtonCompactSize}" />
        <Setter Property="Height" Value="{DynamicResource IconButtonCompactSize}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.dc-toolbar-button:pointerover, Button.icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.dc-toolbar-button:pressed, Button.icon-button:pressed">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="Button.dc-toolbar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.dc-toolbar-button:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>
    <Style Selector="Button.dc-toolbar-button.compact">
        <Setter Property="Width" Value="{DynamicResource IconButtonCompactSize}" />
        <Setter Property="Height" Value="{DynamicResource IconButtonCompactSize}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Shared disabled + keyboard-focus feedback for both shapes and both aliases. -->
    <Style Selector="Button.dc-icon-button:disabled, Button.icon-btn:disabled, Button.dc-toolbar-button:disabled, Button.icon-button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.dc-icon-button:focus-visible, Button.icon-btn:focus-visible, Button.dc-toolbar-button:focus-visible, Button.icon-button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlFocusBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</Styles>
