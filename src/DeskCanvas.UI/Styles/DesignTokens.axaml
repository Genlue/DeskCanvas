<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared layout and control tokens. Keep these values stable when
         changing the visual theme so settings, menus and widget hosts remain
         aligned without duplicating literals across styles. -->
    <x:Double x:Key="ControlNumericMinWidth">115</x:Double>
    <Thickness x:Key="ControlNumericPadding">8,5,8,5</Thickness>

    <!-- Settings/form geometry (W1 batch): the single source for the settings row layout.
         SettingLayoutPanel consumes SettingsRowGap / SettingsRowLabelMinWidth; the rest are
         consumed by the migration batches that move pages onto the shared row/pane metrics.
         Keep the code constants (SettingLayoutPanel defaults, Setting.LabelMinWidth) in sync
         with these values. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <Thickness x:Key="SettingsRowPadding">16,12</Thickness>
    <x:Double x:Key="SettingsRowGap">12</x:Double>
    <x:Double x:Key="SettingsRowLabelMinWidth">160</x:Double>
    <Thickness x:Key="SettingsSectionHeaderMargin">0,12,0,4</Thickness>
    <x:Double x:Key="IconButtonSize">28</x:Double>
    <x:Double x:Key="IconButtonCompactSize">24</x:Double>
    <x:Double x:Key="ControlMinHeight">32</x:Double>
    <Thickness x:Key="SettingsPagePadding">0,2,8,10</Thickness>

    <!-- Secondary panel shell (W7): one card geometry for all nine popups. Panels inherit the
         opening widget's radius at runtime (SpawnCornerRadius); this is the shell's own default
         and matches every popup AXAML that declared its card locally. -->
    <CornerRadius x:Key="SecondaryPanelCornerRadius">18</CornerRadius>
    <Thickness x:Key="SecondaryPanelContentPadding">16,14,16,12</Thickness>

    <!-- Dialog shell: one card geometry for every WindowRole.Dialog window. The gutter is the
         TRANSPARENT room the card's shadow is drawn in — it must never carry a surface of its own
         (that was the old "card inside an acrylic window" ring). ContentPadding is the 16 DIP inset
         the small dialogs already used; the sheet-style ones raise it explicitly. -->
    <CornerRadius x:Key="DialogCornerRadius">14</CornerRadius>
    <Thickness x:Key="DialogContentPadding">16</Thickness>
    <Thickness x:Key="DialogShadowGutter">16</Thickness>
    <BoxShadows x:Key="DialogCardShadow">0 10 28 0 #43000000</BoxShadows>

    <!-- Typography scale used by host controls and settings surfaces. These
         are intentionally small, stable steps so individual views can opt in
         without inventing another font-size literal. -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>

    <Thickness x:Key="WidgetContentHostMargin">12</Thickness>
    <!-- Shared host surface contract. Component-specific cards keep their own
         radii; menus, flyouts and popup shells use this single radius. -->
    <CornerRadius x:Key="HostSurfaceCornerRadius">12</CornerRadius>
    <!-- Compatibility aliases retained for existing widget styles. -->
    <CornerRadius x:Key="MenuCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="WidgetContextMenuCornerRadius">12</CornerRadius>
    <Thickness x:Key="HostSurfaceBorderThickness">1</Thickness>
    <Thickness x:Key="WidgetContextMenuPadding">5</Thickness>
    <Thickness x:Key="WidgetContextMenuItemMargin">2,1</Thickness>
    <CornerRadius x:Key="ScrollBarThumbCornerRadius">999</CornerRadius>

    <!-- Card & Container Tokens (P10) -->
    <CornerRadius x:Key="CardSubtleCornerRadius">11</CornerRadius>
    <Thickness x:Key="CardSubtlePadding">12,10</Thickness>
    <Thickness x:Key="CardSubtleMargin">0,0,0,10</Thickness>
    <Thickness x:Key="CardSubtleBorderThickness">1</Thickness>

    <!-- Pill & Badge Tokens (P10) -->
    <CornerRadius x:Key="PillCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CapsulePillCornerRadius">999</CornerRadius>
    <x:Double x:Key="PillHeight">26</x:Double>
    <x:Double x:Key="PillCompactHeight">22</x:Double>
    <Thickness x:Key="PillPadding">10,3</Thickness>
    <Thickness x:Key="PillCompactPadding">7,2</Thickness>
    <x:Double x:Key="PillFontSize">12</x:Double>
    <CornerRadius x:Key="BadgeCornerRadius">6</CornerRadius>
    <Thickness x:Key="BadgePadding">7,2</Thickness>
    <x:Double x:Key="BadgeFontSize">11</x:Double>

    <!-- Semantic interaction brushes with theme variants (P10).
         NOTE: ControlHoverBrush / ControlPressedBrush / ControlFocusBorderBrush are ALSO
         defined in DeskCanvas/Styles/InteractionResources.axaml, which App.axaml merges
         AFTER this dictionary — there InteractionResources wins. These copies exist so the
         UI library stays usable standalone (e.g. SharedComponentCatalog merges only this
         file, and IconButton relies on the keys for its hover/pressed/focus states).
         Values are kept semantically identical by contract: hover/pressed use the same
         fixed greys, and the focus border binds to the live accent exactly like
         InteractionResources — so merge order can never produce a visible difference.
         Do not diverge the values between the two files. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="CardSubtleFill" Color="#000000" Opacity="0.05" />
            <SolidColorBrush x:Key="CardSubtleBorder" Color="#000000" Opacity="0.08" />
            <SolidColorBrush x:Key="PillBackground" Color="#000000" Opacity="0.06" />
            <SolidColorBrush x:Key="PillHoverBackground" Color="#000000" Opacity="0.10" />
            <SolidColorBrush x:Key="PillPressedBackground" Color="#000000" Opacity="0.14" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#000000" Opacity="0.08" />
            <SolidColorBrush x:Key="BadgeForeground" Color="#8A8A8E" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#000000" Opacity="0.05" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#000000" Opacity="0.09" />
            <SolidColorBrush x:Key="ControlFocusBorderBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.75" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CardSubtleFill" Color="#FFFFFF" Opacity="0.07" />
            <SolidColorBrush x:Key="CardSubtleBorder" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="PillBackground" Color="#FFFFFF" Opacity="0.09" />
            <SolidColorBrush x:Key="PillHoverBackground" Color="#FFFFFF" Opacity="0.14" />
            <SolidColorBrush x:Key="PillPressedBackground" Color="#FFFFFF" Opacity="0.20" />
            <SolidColorBrush x:Key="BadgeBackground" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="BadgeForeground" Color="#98989D" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFF" Opacity="0.08" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFFFFF" Opacity="0.12" />
            <SolidColorBrush x:Key="ControlFocusBorderBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.75" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
