<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:uWidgets.Locales"
        xmlns:views="clr-namespace:uWidgets.Views"
        xmlns:controls="clr-namespace:uWidgets.Views.Controls"
        xmlns:interfaces="clr-namespace:uWidgets.Core.Interfaces;assembly=uWidgets.Core"
        x:Class="uWidgets.Views.Widget"
        Background="Transparent"
        ShowInTaskbar="False"
        ToolTip.Placement="BottomEdgeAlignedRight"
        ToolTip.VerticalOffset="-25"
        ToolTip.HorizontalOffset="7"
        SystemDecorations="{Binding WidgetSystemDecorations}"
        ExtendClientAreaToDecorationsHint="{Binding WidgetExtendClientArea}"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="False"
        x:DataType="views:Widget"
        Classes="Widget">
    <Window.ContextMenu>
        <ContextMenu Classes="WidgetContextMenu">
            <MenuItem Header="{Binding EditStackChildTitle}" Command="{Binding EditCurrentStackedWidget}" IsVisible="{Binding CanEditStackedWidgetChild}" />
            <MenuItem Header="编辑重叠组件…" Command="{Binding EditWidget}" IsVisible="{Binding ShowStackEditButton}" />
            <MenuItem Header="{Binding Edit}" Command="{Binding EditWidget}" IsVisible="{Binding ShowNormalEditButton}" />
            <MenuItem Header="{Binding SizeMenuTitle}">
                <MenuItem Header="自定义尺寸…" Command="{Binding OpenCustomSizeDialog}" IsVisible="{Binding IsFreeMode}" />
                <Separator IsVisible="{Binding IsFreeMode}" />
                <!-- 4:2 ratio fixed widgets (e.g. Aggregate) -->
                <MenuItem Header="4×2 (标准 100%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x2" IsVisible="{Binding IsFixed2x1Widget}" />
                <MenuItem Header="6×3 (等比放大 150%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="6x3" IsVisible="{Binding IsFixed2x1Widget}" />
                <MenuItem Header="8×4 (等比放大 200%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="8x4" IsVisible="{Binding IsFixed2x1Widget}" />
                <!-- 1:1 square fixed widgets (e.g. Single-dial Analog Clock) -->
                <MenuItem Header="1×1 (小 100%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="1x1" IsVisible="{Binding IsFixedSquareWidget}" />
                <MenuItem Header="2×2 (标准 200%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="2x2" IsVisible="{Binding IsFixedSquareWidget}" />
                <MenuItem Header="3×3 (中 300%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="3x3" IsVisible="{Binding IsFixedSquareWidget}" />
                <MenuItem Header="4×4 (大 400%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x4" IsVisible="{Binding IsFixedSquareWidget}" />
                <!-- Map widget quick size presets (2x2, 4x2, 4x4) -->
                <MenuItem Header="2×2 (小号方形 200%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="2x2" IsVisible="{Binding IsMapWidget}" />
                <MenuItem Header="4×2 (中号横版 400×200%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x2" IsVisible="{Binding IsMapWidget}" />
                <MenuItem Header="4×4 (大号全景 400×400%)" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x4" IsVisible="{Binding IsMapWidget}" />
                <Separator IsVisible="{Binding IsMapWidget}" />
                <Separator IsVisible="{Binding IsFixedWidget}" />
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto" Width="200">
                            <TextBlock Text="{x:Static locales:Locale.Widget_Size_Columns}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="999" Increment="1"
                                           FormatString="F0" ParsingNumberStyle="Integer"
                                           Value="{Binding SizeColumnsValue}" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto" Width="200">
                            <TextBlock Text="{x:Static locales:Locale.Widget_Size_Rows}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="999" Increment="1"
                                           FormatString="F0" ParsingNumberStyle="Integer"
                                           Value="{Binding SizeRowsValue}" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding ScaleMenuTitle}" Command="{Binding OpenScaleDialog}" />
            <MenuItem Header="{x:Static locales:Locale.Profiles_MenuTitle}" ItemsSource="{Binding ProfileMenuItems}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Widget_Remove}" Command="{Binding Remove}" />
            <Separator />
            <!-- Escape hatch for a tray icon hidden from the tray menu itself. -->
            <MenuItem Header="{x:Static locales:Locale.Tray_ShowIcon}" ToggleType="CheckBox"
                      IsChecked="{Binding TrayIconVisible, Mode=TwoWay}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Settings}" Command="{Binding OpenSettings}" />
        </ContextMenu>
    </Window.ContextMenu> 
    
    <Window.Styles>
        <Style Selector="ContextMenu.WidgetContextMenu">
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetCardCornerRadius}" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ContextMenu.WidgetContextMenu MenuItem">
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetInnerCornerRadius}" />
            <Setter Property="Margin" Value="2,1" />
        </Style>
        <Style Selector="Border:not(:pointerover) ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Border:pointerover ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector=":is(UserControl)">
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector=":is(UserControl).Frameless">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector=":is(UserControl).Flush">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>
    
    <Grid>
        <!-- Rendered glass surface (液态玻璃 / 柔光玻璃: refraction, glow, vibrancy, wallpaper sampling) -->
        <controls:LiquidGlassSurface Material="{Binding GlassMaterial, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                                     CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                                     Margin="{Binding WidgetMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                                     IsVisible="{Binding ShowsGlassMaterial, RelativeSource={RelativeSource AncestorType=views:Widget}}" />
        <!-- Card (frosted glass, OS-level acrylic): fills the grid cell minus the
             configured margin, with the configured corner radius. The blur comes
             from the OS backdrop (AcrylicBlur hint set by Styles/Transparent.axaml),
             which samples the live desktop every frame — dynamic wallpapers stay
             live. The native window region is clipped to the same rectangle (see
             ApplyWidgetRegion) so the OS blur follows the card and the transparent
             margin stays click-through.
             The outline option adds a highlight ring that fades from the top-left /
             bottom-right corners (see WidgetOutlineBrush). -->
        <Border Name="Border"
                CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Background="{Binding WidgetCardBackground, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                BorderThickness="{Binding WidgetOutlineThickness, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                BorderBrush="{Binding WidgetOutlineBrush, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Margin="{Binding WidgetMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}">
            <!-- Content: sized by the card only; the content scale (Scale()) is a
                 render transform on this presenter, so it never resizes the card. -->
            <ContentPresenter Name="ContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </DataTemplate>
                </ContentPresenter.ContentTemplate>
            </ContentPresenter>
        </Border>

        <!-- Right-side vertical pagination indicator dots for Stack widget. Outside the card
             (in the rightmost margin of the grid cell) on every surface except 毛玻璃/acrylic:
             there the native window region cannot hold an out-of-card strip without the OS
             blur flooding it (a frosted pill behind the dots), so the dots sit inside the
             card instead — see StackIndicatorsMargin and ApplyWidgetRegion. -->
        <Border Name="StackIndicatorsHost"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="{Binding StackIndicatorsMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                IsVisible="{Binding HasStackIndicators, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                PointerWheelChanged="OnStackIndicatorsWheelChanged"
                ZIndex="85">
            <ItemsControl ItemsSource="{Binding StackIndicators, RelativeSource={RelativeSource AncestorType=views:Widget}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="interfaces:StackWidgetIndicatorItem">
                        <Button Width="12" Height="12"
                                CornerRadius="6"
                                Padding="0"
                                Margin="0,1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnStackIndicatorClicked"
                                Tag="{Binding Index}"
                                ToolTip.Tip="{Binding Title}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="RenderTransform" Value="scale(1.25)" />
                                </Style>
                            </Button.Styles>
                            <Panel Width="12" Height="12">
                                <!-- Subtle dark shadow outline for contrast on bright/dark backgrounds -->
                                <Ellipse Width="6" Height="6"
                                         Stroke="#40000000"
                                         StrokeThickness="0.8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <!-- Pure white dot with active/inactive opacity -->
                                <Ellipse Width="6" Height="6"
                                         Fill="White"
                                         Opacity="{Binding Opacity}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Bottom-right corner resize handle (visible in Free mode when not locked) -->
        <Border Name="ResizeHandle"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="20" Height="20"
                Background="Transparent"
                Cursor="BottomRightCorner"
                IsVisible="{Binding ShowResizeHandle, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                PointerPressed="OnResizeHandlePressed"
                ZIndex="100"
                Margin="0,0,2,2">
            <Path Data="M14 6L6 14M14 10L10 14M14 14L14 14"
                  Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  Opacity="0.45"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,4,4"/>
        </Border>
    </Grid>
</Window>
