<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="uWidgets.Views.GridEditor"
        SystemDecorations="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="Manual"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <!--
          The editor is an overlay on the desktop, not a normal app window: its surfaces are
          hard-coded (dark scrim + light sheet), so every control inside the parameters panel
          declares its own colors. Relying on the app/OS theme variant here produced dark text
          on dark chips — unreadable.
        -->
        <Style Selector="Button.panelButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.panelButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ECECF1" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="TextElement.Foreground" Value="#1C1C1E" />
        </Style>
        <Style Selector="Button.panelButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCDCE3" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="TextElement.Foreground" Value="#1C1C1E" />
        </Style>
        <!-- Primary action (Save & close): bright accent so it can never be mistaken for a blank chip. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#26000000" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A85FF" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0069DB" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Panel PointerPressed="OnRootPressed">
        <!-- Full-screen dim overlay -->
        <Border Background="#66000000" />

        <!-- The grid area (draggable; right-click opens the parameters panel) -->
        <Canvas Name="GridCanvas">
            <Border Name="GridVisual"
                    Background="#4000B4FF"
                    BorderBrush="#FF3388FF"
                    BorderThickness="2"
                    CornerRadius="4"
                    ClipToBounds="True"
                    PointerPressed="OnGridPressed"
                    PointerMoved="OnGridMoved"
                    PointerReleased="OnGridReleased">
                <Grid Name="CellsGrid" />
            </Border>
        </Canvas>

        <!-- Parameters panel: shown from the start (right-click anywhere re-opens it) -->
        <Border Name="ParamPanel"
                IsVisible="True"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#F7FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="16"
                BoxShadow="0 8 24 0 #59000000">
            <StackPanel Spacing="6" Width="240">
                <TextBlock Name="ParamTitle" FontWeight="Bold" Foreground="#1C1C1E" FontSize="14" />
                <TextBlock Foreground="#8A000000" FontSize="12" Text="列数 (Columns)" />
                <NumericUpDown Name="ColumnsInput" Minimum="1" Increment="1" FormatString="F0" ParsingNumberStyle="Integer"
                               Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" Foreground="#1C1C1E" />
                <TextBlock Foreground="#8A000000" FontSize="12" Text="行数 (Rows)" />
                <NumericUpDown Name="RowsInput" Minimum="1" Increment="1" FormatString="F0" ParsingNumberStyle="Integer"
                               Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" Foreground="#1C1C1E" />
                <TextBlock Foreground="#8A000000" FontSize="12" Text="格子边长 (%)" />
                <NumericUpDown Name="CellInput" Minimum="0.01" Increment="0.1" FormatString="0.##"
                               Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" Foreground="#1C1C1E" />
                <Separator Margin="0 6" Height="1" Background="#26000000" />
                <!-- Fine positioning: the drag and ±1% nudges round to whole percents of the
                     working area; these inputs set the origin exactly. -->
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0 0 3 0" Spacing="4">
                        <TextBlock Foreground="#8A000000" FontSize="12" Text="X 位置 (%)" />
                        <NumericUpDown Name="XInput" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##"
                                       Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" Foreground="#1C1C1E" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3 0 0 0" Spacing="4">
                        <TextBlock Foreground="#8A000000" FontSize="12" Text="Y 位置 (%)" />
                        <NumericUpDown Name="YInput" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##"
                                       Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" Foreground="#1C1C1E" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*">
                    <Button Name="CenterButton" Classes="panelButton" Grid.Column="0" Margin="0 0 3 0" Click="OnCenterClicked" HorizontalAlignment="Stretch" />
                    <Button Name="CenterYButton" Classes="panelButton" Grid.Column="1" Margin="3 0 0 0" Click="OnCenterYClicked" HorizontalAlignment="Stretch" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*">
                    <Button Name="NudgeLeftButton" Classes="panelButton" Grid.Column="0" Margin="0 0 3 0" Click="OnNudgeLeftClicked" />
                    <Button Name="NudgeRightButton" Classes="panelButton" Grid.Column="1" Margin="3 0 3 0" Click="OnNudgeRightClicked" />
                    <Button Name="NudgeUpButton" Classes="panelButton" Grid.Column="2" Margin="3 0 3 0" Click="OnNudgeUpClicked" />
                    <Button Name="NudgeDownButton" Classes="panelButton" Grid.Column="3" Margin="3 0 0 0" Click="OnNudgeDownClicked" />
                </Grid>
                <Separator Margin="0 6" Height="1" Background="#26000000" />
                <Button Name="SaveButton" Classes="panelButton primary" Click="OnSaveClicked" HorizontalAlignment="Stretch" />
                <Button Name="CloseButton" Classes="panelButton" Click="OnCloseClicked" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- Top hint bar -->
        <Border VerticalAlignment="Top"
                Background="#CC101018"
                CornerRadius="8"
                Margin="8"
                Padding="12 8"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Name="HintText" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Name="InfoText" Foreground="#B0FFFFFF" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Close button -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="8" Padding="10 6"
                Background="#CC101018"
                Foreground="#FFFFFFFF"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                FontWeight="SemiBold"
                Content="✕"
                Click="OnCloseClicked" />
    </Panel>
</Window>
