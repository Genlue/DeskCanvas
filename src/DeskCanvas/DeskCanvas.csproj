<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>true</PublishReadyToRun>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <ApplicationIcon>..\..\.github\images\icon.ico</ApplicationIcon>
        <!-- Memory & GC optimizations: Workstation GC uses far less baseline memory and releases virtual memory -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <RetainVM>false</RetainVM>
        <!-- AVLN3001 is benign here: every flagged view is instantiated from code / DataTemplates
             and never resolved through the runtime XAML loader, so the missing public
             parameterless constructor is intentional. -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.ReactiveUI" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="SkiaSharp" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Win32.SystemEvents" />
        <PackageReference Include="System.Management" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DeskCanvas.Core\DeskCanvas.Core.csproj" />
      <None Update="app.manifest">
        <DependentUpon>App.axaml</DependentUpon>
      </None>
      <None Update="appSettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="layout.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\.github\images\icon.ico">
        <Link>icon.ico</Link>
      </None>
      <!-- Notification-area icon. The <None> entry above only feeds the exe icon; the tray needs
           a real WindowIcon, which can only be loaded from an Avalonia resource. -->
      <AvaloniaResource Include="..\..\.github\images\icon.ico">
        <Link>Assets\icon.ico</Link>
      </AvaloniaResource>
      <!-- Single-file mode: defaults shipped inside the exe, extracted to the data folder on first run. -->
      <EmbeddedResource Include="appSettings.json">
        <LogicalName>DeskCanvas.Resources.appSettings.json</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="layout.json">
        <LogicalName>DeskCanvas.Resources.layout.json</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <!--
      Single-file widget bundle: publish every widget (flat, like the official layout),
      clean pdb/xml/runtimeconfig, zip it and embed it as a resource.
      WidgetBundle.ExtractIfNeeded() unzips it into the data folder at startup.

      Only runs on RID-specific Release publishes (the single-file path); dev/Debug builds
      keep the classic portable layout (exe + Widgets folder next to it).
      'BuildingWidgetBundle' guards against recursion when widgets build the app as a reference.
    -->
    <PropertyGroup>
      <WidgetsBundleDir>$(MSBuildProjectDirectory)\obj\widgets-bundle</WidgetsBundleDir>
      <WidgetsBundleZip>$(WidgetsBundleDir)\widgets.zip</WidgetsBundleZip>
      <WidgetsSourceDir>$(MSBuildProjectDirectory)\..\Widgets</WidgetsSourceDir>
    </PropertyGroup>

    <Target Name="BuildWidgetsBundle" BeforeTargets="AssignTargetPaths"
            Condition="'$(RuntimeIdentifier)' != '' and '$(Configuration)' == 'Release' and '$(BuildingWidgetBundle)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingInsideVisualStudio)' != 'true'">
      <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-widgets-bundle.ps1&quot; -WidgetsSourceDir &quot;$(WidgetsSourceDir)&quot; -StageDir &quot;$(WidgetsBundleDir)\stage&quot; -ZipPath &quot;$(WidgetsBundleZip)&quot; -Configuration $(Configuration) -RuntimeIdentifier $(RuntimeIdentifier)" />
      <ItemGroup>
        <EmbeddedResource Include="$(WidgetsBundleZip)" Condition="Exists('$(WidgetsBundleZip)')">
          <LogicalName>DeskCanvas.Resources.widgets.zip</LogicalName>
        </EmbeddedResource>
      </ItemGroup>
    </Target>

    <ItemGroup>
      <EmbeddedResource Update="Locales\Locale.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Locale.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Settings.axaml.cs">
        <DependentUpon>Settings.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Widget.axaml.cs">
        <DependentUpon>Widget.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Pages\Appearance.axaml.cs">
        <DependentUpon>Appearance.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Locales\Locale.Designer.cs">
        <Generator>PublicResXFileCodeGenerator</Generator>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Views\Controls\Setting.axaml" />
    </ItemGroup>

</Project>
