<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:DeskCanvas.Views.Pages"
             xmlns:viewModels="clr-namespace:DeskCanvas.ViewModels"
             x:Class="DeskCanvas.Views.Pages.Gallery"
             x:DataType="pages:Gallery">
    <UserControl.Styles>
        <Style Selector="Button.macos-gallery-card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.macos-gallery-card /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.preview-box">
            <Setter Property="CornerRadius" Value="{Binding Radius, RelativeSource={RelativeSource AncestorType=pages:Gallery}}" />
            <Setter Property="Background" Value="#16808080" />
            <Setter Property="BorderBrush" Value="#25808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 3 10 0 #18000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.macos-gallery-card:pointerover Border.preview-box">
            <Setter Property="Background" Value="#22808080" />
            <Setter Property="BorderBrush" Value="#55808080" />
            <Setter Property="BoxShadow" Value="0 8 20 0 #30000000" />
        </Style>

        <Style Selector="Button.macos-gallery-card:pointerover Border.add-badge">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.macos-gallery-card:pointerover Path.add-icon">
            <Setter Property="Fill" Value="{DynamicResource AccentContrastForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="0,0,0,32">
        <ItemsControl ItemsSource="{Binding Widgets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:WidgetPreviewViewModel">
                    <StackPanel Width="{Binding CardWidth}" Margin="10,0,10,26">
                        <Button Classes="macos-gallery-card"
                                ToolTip.Tip="点击添加到桌面"
                                Click="Button_OnClick">
                            <StackPanel Orientation="Vertical">
                                <!-- 真实比例小组件预览框 (消除硬编码间距，贴合桌面外观) -->
                                <Border Classes="preview-box"
                                        Width="{Binding PreviewWidth}"
                                        Height="{Binding PreviewHeight}"
                                        HorizontalAlignment="Center">
                                    <ContentPresenter IsHitTestVisible="False"
                                                      Content="{Binding Control}"
                                                      Margin="{Binding ContentMargin}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </Border>

                                <!-- macOS 风格底部信息条 (标题、尺寸徽章与添加按钮) -->
                                <Grid Margin="2,10,2,0" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <Border Background="#14808080" CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="{Binding SizeBadge}"
                                                           FontSize="10"
                                                           FontWeight="Medium"
                                                           Opacity="0.75" />
                                            </Border>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="200" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Classes="add-badge"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="#18808080"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                        <Path Classes="add-icon"
                                              Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                              Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
