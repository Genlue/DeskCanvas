<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:DeskCanvas.Locales"
             x:Class="DeskCanvas.Views.Pages.MultiScreen">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="14">
            <TextBlock FontSize="20" FontWeight="Bold" Text="{x:Static locales:Locale.Settings_MultiScreen}" />
            <TextBlock FontSize="13" TextWrapping="Wrap" Opacity="0.75"
                       Text="{x:Static locales:Locale.Settings_MultiScreen_Description}" />

            <TextBlock x:Name="AttachedHeader" FontSize="15" FontWeight="SemiBold" Margin="0 12 0 0" />
            <StackPanel x:Name="AttachedList" Spacing="10" />

            <TextBlock x:Name="DetachedHeader" FontSize="15" FontWeight="SemiBold" Margin="0 22 0 0" />
            <StackPanel x:Name="DetachedList" Spacing="10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>