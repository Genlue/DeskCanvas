<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls"
             xmlns:viewModels="clr-namespace:DeskCanvas.ViewModels"
             xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:locales="clr-namespace:DeskCanvas.Locales"
             x:Class="DeskCanvas.Views.Pages.General"
             x:DataType="viewModels:GeneralViewModel">
    <StackPanel Orientation="Vertical" Spacing="20">
        <!-- 语言与界面模块 -->
        <StackPanel Spacing="6">
            <TextBlock Classes="dc-section-header" Margin="4,0,0,6"
                       Text="{x:Static locales:Locale.Settings_General_Language}"/>
            <Border Classes="settings-group-card">
                <controls:Setting Icon="{DynamicResource Language}" 
                                  Title="{x:Static locales:Locale.Settings_General_Language_Title}"
                                  Subtitle="{x:Static locales:Locale.Settings_General_Language_Subtitle}"
                                  RestartRequired="True">
                    <ComboBox ItemsSource="{Binding Languages}" MinWidth="140"
                              SelectedItem="{Binding Language}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="globalization:CultureInfo">
                                <TextBlock Text="{Binding DisplayName}" Margin="0 4" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:Setting>
            </Border>
        </StackPanel>

        <!-- 默认地区模块 -->
        <StackPanel Spacing="6">
            <TextBlock Classes="dc-section-header" Margin="4,0,0,6"
                       Text="{x:Static locales:Locale.Settings_General_DefaultRegion}"/>
            <Border Classes="settings-group-card">
                <StackPanel>
                    <controls:Setting Icon="{DynamicResource Move}"
                                      Title="{x:Static locales:Locale.Settings_General_DefaultRegion_Title}"
                                      Subtitle="{Binding DefaultRegionSummary}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBox Width="150" Text="{Binding RegionQuery}"
                                     PlaceholderText="{x:Static locales:Locale.Settings_General_DefaultRegion_Placeholder}" />
                            <Button Content="{x:Static locales:Locale.Settings_General_DefaultRegion_Search}"
                                    IsEnabled="{Binding !IsSearchingRegion}"
                                    Click="OnSearchRegionClicked" />
                            <Button Content="{x:Static locales:Locale.Settings_General_DefaultRegion_Clear}"
                                    IsVisible="{Binding HasDefaultRegion}"
                                    Click="OnClearRegionClicked" />
                        </StackPanel>
                    </controls:Setting>
                    <Rectangle Classes="settings-separator" />
                    <controls:Setting Icon="{DynamicResource Move}"
                                      Title="{x:Static locales:Locale.Settings_General_DefaultRegion_Results_Title}"
                                      Subtitle="{Binding RegionStatus}">
                        <ComboBox MinWidth="230"
                                  ItemsSource="{Binding RegionResults}"
                                  SelectedItem="{Binding SelectedRegionResult}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Margin="0 4" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:Setting>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 系统与启动模块 -->
        <StackPanel Spacing="6">
            <TextBlock Classes="dc-section-header" Margin="4,0,0,6"
                       Text="{x:Static locales:Locale.Settings_General_Startup}"/>
            <Border Classes="settings-group-card">
                <controls:Setting Icon="{DynamicResource Play}" AdminRequired="True"
                                  Title="{x:Static locales:Locale.Settings_General_Startup_Title}"
                                  Subtitle="{x:Static locales:Locale.Settings_General_Startup_Subtitle}">
                    <ToggleSwitch IsChecked="{Binding RunOnStartup}" />
                </controls:Setting>
            </Border>
        </StackPanel>

        <!-- 软件更新模块 -->
        <StackPanel Spacing="6">
            <TextBlock Classes="dc-section-header" Margin="4,0,0,6"
                       Text="{x:Static locales:Locale.Settings_General_Update_Title}"/>
            <Border Classes="settings-group-card">
                <StackPanel>
                    <controls:Setting Icon="{DynamicResource Download}" 
                                      Title="{x:Static locales:Locale.Settings_General_Update_Interval}"
                                      Subtitle="{x:Static locales:Locale.Settings_General_Update_Interval_Subtitle}">
                        <ComboBox ItemsSource="{Binding UpdateIntervals}" MinWidth="140"
                                  SelectedItem="{Binding SelectedUpdateInterval}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="viewModels:UpdateIntervalOption">
                                    <TextBlock Text="{Binding Label}" Margin="0 4" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:Setting>
                    <Rectangle Classes="settings-separator" />
                    <controls:Setting Icon="{DynamicResource Language}" 
                                      Title="{x:Static locales:Locale.Settings_General_Update_AutoProxy}"
                                      Subtitle="{Binding AutoProxySubtitle}">
                        <ToggleSwitch IsChecked="{Binding AutoDetectProxy}" />
                    </controls:Setting>
                    <Rectangle Classes="settings-separator" />
                    <controls:Setting Icon="{DynamicResource GitHub}" 
                                      Title="{x:Static locales:Locale.Settings_General_Update_Connectivity}"
                                      Subtitle="{Binding ConnectivityStatusText}">
                        <Button MinWidth="130" HorizontalContentAlignment="Center" 
                                Content="{x:Static locales:Locale.Settings_General_Update_Connectivity_Action}"
                                IsEnabled="{Binding !IsTestingConnectivity}"
                                Command="{Binding TestGitHubConnectivity}" />
                    </controls:Setting>
                    <Rectangle Classes="settings-separator" />
                    <controls:Setting Icon="{DynamicResource Refresh}" 
                                      Title="{x:Static locales:Locale.Settings_General_Update_CheckNow}"
                                      Subtitle="{Binding UpdateStatusText}">
                        <Button MinWidth="130" HorizontalContentAlignment="Center" 
                                Content="{x:Static locales:Locale.Settings_General_Update_CheckNow}"
                                IsEnabled="{Binding !IsCheckingUpdates}"
                                Command="{Binding CheckForUpdates}" />
                    </controls:Setting>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
