<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls"
             xmlns:viewModels="clr-namespace:DeskCanvas.ViewModels"
             xmlns:locales="clr-namespace:DeskCanvas.Locales"
             xmlns:pages="clr-namespace:DeskCanvas.Views.Pages"
             x:Class="DeskCanvas.Views.Pages.Profiles"
             x:DataType="viewModels:ProfilesViewModel">

    <StackPanel Orientation="Vertical" Spacing="16">
        <!-- Top Toolbar -->
        <Border CornerRadius="8" Padding="16,14"
                BorderThickness="1"
                BorderBrush="{DynamicResource ToolTipBorderBrush}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontSize="15" FontWeight="SemiBold"
                               Text="{x:Static locales:Locale.Profiles_Section_List}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{x:Static locales:Locale.Profiles_Section_Subtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{x:Static locales:Locale.Profiles_Import}"
                            Click="OnImportProfileClicked" />
                    <Button Classes="accent"
                            Content="{x:Static locales:Locale.Profiles_New}"
                            Click="OnNewProfileClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Profiles List -->
        <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:ProfileItemViewModel">
                    <Border CornerRadius="8" Margin="0,0,0,8" Padding="16,14"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ToolTipBorderBrush}"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Left Status Icon -->
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SystemAccentColorLight2}"
                                    IsVisible="{Binding IsActive}">
                                <PathIcon Width="16" Height="16"
                                          Foreground="White"
                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                            </Border>
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ToolTipBorderBrush}"
                                    IsVisible="{Binding !IsActive}">
                                <PathIcon Width="16" Height="16"
                                          Opacity="0.6"
                                          Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z" />
                            </Border>

                            <!-- Profile Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding Name}" VerticalAlignment="Center" />
                                    <!-- Active Badge -->
                                    <Border CornerRadius="4" Padding="6,2"
                                            Background="{DynamicResource SystemAccentColor}"
                                            IsVisible="{Binding IsActive}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static locales:Locale.Profiles_CurrentActive}"
                                                   FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Opacity="0.6"
                                           Text="{Binding LastModified, StringFormat='修改时间：{0}'}"
                                           IsVisible="{Binding LastModified, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="{x:Static locales:Locale.Profiles_Switch}"
                                        Classes="accent"
                                        IsVisible="{Binding CanSwitch}"
                                        Click="OnSwitchClicked" />
                                <Button Content="{x:Static locales:Locale.Profiles_Rename}"
                                        Click="OnRenameClicked" />
                                <Button Content="{x:Static locales:Locale.Profiles_Duplicate}"
                                        Click="OnDuplicateClicked" />
                                <Button Content="{x:Static locales:Locale.Profiles_Export}"
                                        Click="OnExportClicked" />
                                <Button Content="{x:Static locales:Locale.Profiles_Delete}"
                                        IsEnabled="{Binding CanDelete}"
                                        Click="OnDeleteClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
