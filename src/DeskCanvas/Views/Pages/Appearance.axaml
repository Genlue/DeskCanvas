<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls"
             xmlns:viewModels="clr-namespace:DeskCanvas.ViewModels"
             xmlns:locales="clr-namespace:DeskCanvas.Locales"
             x:Class="DeskCanvas.Views.Pages.Appearance"
             x:DataType="viewModels:AppearanceViewModel">
    <UserControl.Styles>
        <Styles>
            <Style Selector="ColorPicker /template/ DropDownButton">
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Styles>
    </UserControl.Styles>
    <StackPanel Orientation="Vertical" Spacing="3">
        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 0 0 10" 
                   Text="{x:Static locales:Locale.Settings_Appearance_ApplyTheme}"/>
        <ItemsControl ItemsSource="{Binding Themes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="controls:ThemeButton">
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" MaxWidth="600" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel IsVisible="{Binding ShowGlassOpticsSettings}" Spacing="3" Margin="0 16 0 6">
            <!-- The optics rows (实时采样 → 染色扩散) are expert knobs: collapsed by default,
                 the theme works out of the box without them. -->
            <Button Click="ToggleOpticsExpanded" HorizontalAlignment="Left" Margin="0 0 6 0"
                    Padding="0" BorderThickness="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="{Binding GlassOpticsTitle}" />
                    <PathIcon Width="12" Height="12" VerticalAlignment="Center"
                              Data="M 1.6 3.2 L 6 7.6 L 10.4 3.2 L 10.4 5 L 6 9.4 L 1.6 5 Z"
                              IsVisible="{Binding !OpticsExpanded}" />
                    <PathIcon Width="12" Height="12" VerticalAlignment="Center"
                              Data="M 1.6 8.8 L 6 4.4 L 10.4 8.8 L 10.4 7 L 6 2.6 L 1.6 7 Z"
                              IsVisible="{Binding OpticsExpanded}" />
                </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding OpticsExpanded}" Spacing="3">
            <!-- 液态玻璃 (lens recipe) rows. -->
            <StackPanel IsVisible="{Binding ShowLegacyOptics}" Spacing="3">
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSampling}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingHint}">
                    <ToggleSwitch IsChecked="{Binding LiveSampling}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSampling}" />
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingInterval}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingIntervalHint}"
                                  IsVisible="{Binding LiveSampling}">
                    <NumericUpDown MinWidth="130" Minimum="3" Maximum="1000" Increment="10" FormatString="F0"
                                   Value="{Binding LiveSamplingInterval}"
                                   AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingInterval}" />
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_Blur}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_BlurHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassBlur, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Blur}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding GlassBlur}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Blur}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_Refraction}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_RefractionHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassRefraction, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Refraction}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding GlassRefraction}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Refraction}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeWidth}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeWidthHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassEdgeWidth, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeWidth}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="80" Increment="1" FormatString="F0"
                                       Value="{Binding GlassEdgeWidth}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeWidth}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_Highlight}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_HighlightHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassHighlight, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Highlight}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding GlassHighlight}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Highlight}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_Dispersion}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_DispersionHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassDispersion, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Dispersion}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding GlassDispersion}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_Dispersion}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_LightAngle}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_LightAngleHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="360" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassLightAngle, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_LightAngle}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="360" Increment="5" FormatString="F0"
                                       Value="{Binding GlassLightAngle}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_LightAngle}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeTint}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeTintHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassEdgeTint, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeTint}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding GlassEdgeTint}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_EdgeTint}" />
                    </Grid>
                </controls:Setting>
                <!-- 背景清晰度: the one setting that trades live-sampling *speed* against backdrop
                     detail. Everything else here is optics; this is the sampling round's cost. -->
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarity}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarityHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="25" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding GlassBackdropClarity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarity}" />
                        <NumericUpDown Grid.Column="1" Minimum="25" Maximum="100" Increment="5" FormatString="F0"
                                       Value="{Binding GlassBackdropClarity}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarity}" />
                    </Grid>
                </controls:Setting>
                <!-- The soft recipe's ingredients. 柔光玻璃 was merged into this theme, so these rows
                     are always offered: turning 柔光晕 or 光谱弥散 up above 0 is what selects the soft
                     material, and both at 0 keeps the crisp, macOS-faithful default. -->
                <StackPanel IsVisible="{Binding ShowSoftGlowSettings}" Spacing="3">
                    <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_SoftGlow_Glow}"
                                      Subtitle="{x:Static locales:Locale.Settings_Appearance_SoftGlow_GlowHint}">
                        <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                    Value="{Binding GlassGlow, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_SoftGlow_Glow}" />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                           Value="{Binding GlassGlow}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_SoftGlow_Glow}" />
                        </Grid>
                    </controls:Setting>
                    <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_SoftGlow_Spectrum}"
                                      Subtitle="{x:Static locales:Locale.Settings_Appearance_SoftGlow_SpectrumHint}">
                        <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                    Value="{Binding GlassSpectrum, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_SoftGlow_Spectrum}" />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                           Value="{Binding GlassSpectrum}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_SoftGlow_Spectrum}" />
                        </Grid>
                    </controls:Setting>
                    <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_SoftGlow_DyeSpread}"
                                      Subtitle="{x:Static locales:Locale.Settings_Appearance_SoftGlow_DyeSpreadHint}">
                        <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                    Value="{Binding GlassDyeSpread, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_SoftGlow_DyeSpread}" />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                           Value="{Binding GlassDyeSpread}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_SoftGlow_DyeSpread}" />
                        </Grid>
                    </controls:Setting>
                </StackPanel>
            </StackPanel>
            <!-- 新液态玻璃 rows: Kyant0/AndroidLiquidGlass 2.0's knobs (模糊 / 折射 / 色散 /
                 边缘高光 / 活力) plus the sampling-pipeline knobs of its own settings record. -->
            <StackPanel IsVisible="{Binding ShowV2Settings}" Spacing="3">
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSampling}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingHint}">
                    <ToggleSwitch IsChecked="{Binding V2LiveSampling}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSampling}" />
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingInterval}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingIntervalHint}"
                                  IsVisible="{Binding V2LiveSampling}">
                    <NumericUpDown MinWidth="130" Minimum="3" Maximum="1000" Increment="10" FormatString="F0"
                                   Value="{Binding V2LiveSamplingInterval}"
                                   AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_LiveSamplingInterval}" />
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_V2_Blur}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_V2_BlurHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding V2Blur, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Blur}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding V2Blur}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Blur}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_V2_Refraction}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_V2_RefractionHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding V2Refraction, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Refraction}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding V2Refraction}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Refraction}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_V2_Dispersion}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_V2_DispersionHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding V2Dispersion, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Dispersion}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding V2Dispersion}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Dispersion}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_V2_Highlight}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_V2_HighlightHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding V2Highlight, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Highlight}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding V2Highlight}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Highlight}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_V2_Vibrancy}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_V2_VibrancyHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding V2Vibrancy, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Vibrancy}" />
                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="F0"
                                       Value="{Binding V2Vibrancy}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_V2_Vibrancy}" />
                    </Grid>
                </controls:Setting>
                <controls:Setting Title="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarity}"
                                  Subtitle="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarityHint}">
                    <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0">
                        <Slider Minimum="25" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                                Value="{Binding V2BackdropClarity, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarity}" />
                        <NumericUpDown Grid.Column="1" Minimum="25" Maximum="100" Increment="5" FormatString="F0"
                                       Value="{Binding V2BackdropClarity}" AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_Glass_BackdropClarity}" />
                    </Grid>
                </controls:Setting>
            </StackPanel>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0 8 0 0">
                <Button Content="{x:Static locales:Locale.Settings_Appearance_Glass_Align}" Click="OpenWallpaperAlign" Margin="0 0 8 6" />
                <Button Content="{x:Static locales:Locale.Settings_Appearance_Glass_Reset}" Click="ResetLiquidGlass" Margin="0 0 8 6" />
                <Button Content="{x:Static locales:Locale.Settings_Appearance_Glass_Refresh}" Click="RefreshLiquidGlassWallpaper" Margin="0 0 0 6" />
            </WrapPanel>
        </StackPanel>
        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 20 0 10" 
                   Text="{x:Static locales:Locale.Settings_Appearance_Colors}"/>
        <controls:Setting Icon="{DynamicResource Brush}" 
            Title="{x:Static locales:Locale.Settings_Appearance_DarkMode_Title}" 
            Subtitle="{x:Static locales:Locale.Settings_Appearance_DarkMode_Subtitle}">
            <ComboBox ItemsSource="{Binding DarkModes}" MinWidth="130" 
                      SelectedItem="{Binding DarkMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="viewModels:DarkModeViewModel">
                        <TextBlock Text="{Binding Name}" Margin="0 4" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource Transparency}" 
            Title="{x:Static locales:Locale.Settings_Appearance_OpacityLevel_Title}" 
            Subtitle="{x:Static locales:Locale.Settings_Appearance_OpacityLevel_Subtitle}"
            IsVisible="{Binding ShowOpacitySetting}">
            <NumericUpDown MinWidth="130" Minimum="0" Maximum="1" Increment="0.05" Value="{Binding OpacityLevel}" />
        </controls:Setting>
        <StackPanel IsVisible="{Binding ShowGlassSettings}">
            <controls:Setting Icon="{DynamicResource WidgetSize}"
                Title="{x:Static locales:Locale.Settings_Appearance_OutlineColor_Title}"
                Subtitle="{x:Static locales:Locale.Settings_Appearance_OutlineColor_Subtitle}">
                <ColorPicker Height="36" Width="72"
                             Color="{Binding OutlineColor}"
                             IsAlphaVisible="True" />
            </controls:Setting>
            <controls:Setting Icon="{DynamicResource WidgetSize}"
                Title="{x:Static locales:Locale.Settings_Appearance_OutlineWidth_Title}"
                Subtitle="{x:Static locales:Locale.Settings_Appearance_OutlineWidth_Subtitle}">
                <NumericUpDown MinWidth="130" Minimum="0" Maximum="6" Increment="0.5" FormatString="{}{0:0.#}" Value="{Binding OutlineWidth}" />
            </controls:Setting>
        </StackPanel>
        <controls:Setting Icon="{DynamicResource Font}"
            Title="{x:Static locales:Locale.Settings_Appearance_TextShadow_Title}"
            Subtitle="{x:Static locales:Locale.Settings_Appearance_TextShadow_Subtitle}">
            <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Right">
                <ToggleSwitch IsChecked="{Binding TextShadowEnabled}" HorizontalAlignment="Right" />
                <Grid ColumnDefinitions="*,130" Width="264" Margin="14 0 0 0"
                      IsVisible="{Binding ShowTextShadowStrength}">
                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0 0 10 0"
                            Value="{Binding TextShadowStrength, Mode=TwoWay}" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_TextShadow_Strength}" />
                    <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="5" FormatString="F0"
                                   Value="{Binding TextShadowStrength}"
                                   AutomationProperties.Name="{x:Static locales:Locale.Settings_Appearance_TextShadow_Strength}" />
                </Grid>
            </StackPanel>
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource Color}" 
                          Title="{x:Static locales:Locale.Settings_Appearance_AccentColor_Title}"
                          IsVisible="{Binding ShowAccentSetting}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ColorPicker Height="36" Width="72"
                             IsVisible="{Binding ShowColorPalette}" 
                             Color="{Binding AccentColor}" 
                             IsAlphaVisible="False" />
                <ComboBox ItemsSource="{Binding AccentComboboxItems}" MinWidth="130" 
                          SelectedItem="{Binding AccentMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:AccentColorViewModel">
                            <TextBlock Text="{Binding Name}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource Monochrome}" 
                          Title="{x:Static locales:Locale.Settings_Appearance_Monochrome_Title}" 
                          Subtitle="{x:Static locales:Locale.Settings_Appearance_Monochrome_Subtitle}"
                          IsVisible="{Binding ShowMonochromeSetting}">
            <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Right">
                <ToggleSwitch IsChecked="{Binding Monochrome}" HorizontalAlignment="Right" />
                <ComboBox IsVisible="{Binding ShowMonochromeVariant}" MinWidth="130"
                          ItemsSource="{Binding MonochromeVariants}"
                          SelectedItem="{Binding MonochromeVariant}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:MonochromeVariantViewModel">
                            <TextBlock Text="{Binding Name}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource Color}" 
                          Title="{x:Static locales:Locale.Settings_Appearance_SolidBackground_Title}" 
                          Subtitle="{x:Static locales:Locale.Settings_Appearance_SolidBackground_Subtitle}"
                          IsVisible="{Binding ShowSolidBackgroundSetting}">
            <StackPanel Orientation="Vertical" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <TextBlock MinWidth="70" VerticalAlignment="Center"
                               Text="{x:Static locales:Locale.Settings_Appearance_SolidBackground_Dark}" />
                    <ColorPicker Height="36" Width="72"
                                 Color="{Binding SolidBackgroundDark}" 
                                 IsAlphaVisible="False" />
                    <Button Content="{x:Static locales:Locale.Settings_Appearance_SolidBackground_ApplyToLight}"
                            Click="ApplySolidToLight" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <TextBlock MinWidth="70" VerticalAlignment="Center"
                               Text="{x:Static locales:Locale.Settings_Appearance_SolidBackground_Light}" />
                    <ColorPicker Height="36" Width="72"
                                 Color="{Binding SolidBackgroundLight}" 
                                 IsAlphaVisible="False" />
                    <Button Content="{x:Static locales:Locale.Settings_Appearance_SolidBackground_ApplyToDark}"
                            Click="ApplySolidToDark" />
                </StackPanel>
            </StackPanel>
        </controls:Setting>
        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0 20 0 10"
                   Text="{x:Static locales:Locale.Settings_Advanced_Appearance}"/>
        <controls:Setting Icon="{DynamicResource Font}" 
                          Title="{x:Static locales:Locale.Settings_Advanced_FontFamily_Title}" 
                          Subtitle="{x:Static locales:Locale.Settings_Advanced_FontFamily_Subtitle}">
            <StackPanel Orientation="Vertical" Spacing="6" MinWidth="260">
                <TextBox Watermark="{x:Static locales:Locale.Settings_Appearance_FontSearchWatermark}"
                         Text="{Binding FontSearchText}" />
                <ComboBox ItemsSource="{Binding FilteredFonts}" 
                          SelectedItem="{Binding Font}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Static locales:Locale.Settings_Appearance_FontNoResults}"
                           IsVisible="{Binding NoFontResults}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </controls:Setting>
        <controls:Setting Icon="{DynamicResource Windows}" 
                          Title="{x:Static locales:Locale.Settings_Advanced_TitleBarStyle_Title}" 
                          Subtitle="{x:Static locales:Locale.Settings_Advanced_TitleBarStyle_Subtitle}">
            <ComboBox MinWidth="130" ItemsSource="{Binding TitleBarStyles}"
                      SelectedItem="{Binding TitleBarStyle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="viewModels:TitleBarStyleViewModel">
                        <TextBlock Text="{Binding Name}" Margin="0 4" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>
        <controls:Setting IsVisible="{Binding ShowTitleBarSize}" Icon="{DynamicResource WidgetSize}"
                          Title="{x:Static locales:Locale.Settings_Advanced_TitleBarSize_Title}"
                          Subtitle="{x:Static locales:Locale.Settings_Advanced_TitleBarSize_Subtitle}">
            <ComboBox MinWidth="130" ItemsSource="{Binding TitleBarSizes}"
                      SelectedItem="{Binding TitleBarSize}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="viewModels:TitleBarSizeViewModel">
                        <TextBlock Text="{Binding Name}" Margin="0 4" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>
    </StackPanel>
</UserControl>
