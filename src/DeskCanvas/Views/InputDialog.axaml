<views:HostDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeskCanvas.Views"
        xmlns:ui="using:DeskCanvas.UI.Controls"
        x:Class="DeskCanvas.Views.InputDialog"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">

    <!-- The title and the prompt are the shell's header (which is also what makes the dialog
         movable); the field, the validation line and the two actions are the content. The button
         labels are assigned in code from Locale, so this file carries no CJK literals. -->
    <ui:DialogShell ContentPadding="24">
        <ui:DialogShell.HeaderContent>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock x:Name="PromptText"
                           FontSize="13"
                           Opacity="0.8"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ui:DialogShell.HeaderContent>

        <StackPanel Spacing="14" Width="360">
            <TextBox x:Name="InputBox"
                     FontSize="{DynamicResource FontSizeBody}"
                     KeyDown="OnInputBoxKeyDown" />
            <TextBlock x:Name="ErrorText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource ValidationErrorBrush}"
                       IsVisible="False"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 4 0 0">
                <Button x:Name="CancelButton" Click="OnCancel" />
                <Button x:Name="ConfirmButton" Classes="accent" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </ui:DialogShell>
</views:HostDialogWindow>
