<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:DeskCanvas.Locales"
        x:Class="DeskCanvas.Views.CustomSizeDialog"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource SettingsBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowStartupLocation="CenterOwner"
        Width="320" Height="190" CanResize="False">
    <Border Background="{DynamicResource MenuSurfaceBackground}" BorderBrush="{DynamicResource MenuSurfaceBorder}" BorderThickness="{DynamicResource HostSurfaceBorderThickness}" CornerRadius="{DynamicResource HostSurfaceCornerRadius}" Margin="8">
      <StackPanel Margin="16" Spacing="12" PointerPressed="Drag">
        <TextBlock Text="自定义尺寸 (像素)" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                   IsHitTestVisible="False" HorizontalAlignment="Center" Margin="0 4 0 0"/>
        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,4" HorizontalAlignment="Center">
            <TextBlock Text="宽度" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Name="WidthInput" Width="75" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Grid.Column="2" Text="高度" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox Grid.Column="3" Name="HeightInput" Width="75" HorizontalAlignment="Center" TextAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Content="默认 (160×160)" Click="Reset" />
            <Button Content="{x:Static locales:Locale.Widget_Save}" Click="Apply" />
        </StackPanel>
      </StackPanel>
    </Border>
</Window>
