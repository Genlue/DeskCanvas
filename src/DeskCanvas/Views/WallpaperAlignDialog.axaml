<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:DeskCanvas.Locales"
        x:Class="DeskCanvas.Views.WallpaperAlignDialog"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource SettingsBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        Width="340" Height="250" CanResize="False">
    <Border Background="{DynamicResource MenuSurfaceBackground}" BorderBrush="{DynamicResource MenuSurfaceBorder}" BorderThickness="{DynamicResource HostSurfaceBorderThickness}" CornerRadius="{DynamicResource HostSurfaceCornerRadius}" Margin="8">
      <StackPanel Margin="16" Spacing="10" PointerPressed="Drag">
        <TextBlock Text="{x:Static locales:Locale.Settings_Appearance_Glass_Align_Title}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                   IsHitTestVisible="False" HorizontalAlignment="Center" Margin="0 4 0 0"/>
        <TextBlock Text="{x:Static locales:Locale.Settings_Appearance_Glass_Align_Hint}" FontSize="{DynamicResource FontSizeCaption}" Opacity="0.75"
                   TextWrapping="Wrap" IsHitTestVisible="False" HorizontalAlignment="Center" TextAlignment="Center"/>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0 4">
            <TextBlock Text="{x:Static locales:Locale.Settings_Appearance_Glass_Align_Horizontal}"
                       VerticalAlignment="Center" IsHitTestVisible="False" Margin="0 0 12 0"/>
            <NumericUpDown Grid.Column="1" Name="OffsetX" Minimum="-1000" Maximum="1000" Increment="1"
                           FormatString="F0" ValueChanged="OnOffsetChanged"/>
            <TextBlock Grid.Row="1" Text="{x:Static locales:Locale.Settings_Appearance_Glass_Align_Vertical}"
                       VerticalAlignment="Center" IsHitTestVisible="False" Margin="0 10 12 0"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Name="OffsetY" Minimum="-1000" Maximum="1000" Increment="1"
                           FormatString="F0" Margin="0 10 0 0" ValueChanged="OnOffsetChanged"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="{x:Static locales:Locale.Settings_Appearance_Glass_Align_Reset}" Click="ResetOffsets" />
            <Button Content="{x:Static locales:Locale.Settings_Appearance_Glass_Align_Close}" Click="CloseDialog" />
        </StackPanel>
      </StackPanel>
    </Border>
</Window>
