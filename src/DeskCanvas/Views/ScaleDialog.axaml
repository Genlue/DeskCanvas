<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:DeskCanvas.Locales"
        x:Class="DeskCanvas.Views.ScaleDialog"
        Background="{DynamicResource SettingsBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowStartupLocation="CenterOwner"
        Width="300" Height="170" CanResize="False">
    <StackPanel Margin="16" Spacing="10" PointerPressed="Drag">
        <TextBlock Text="{x:Static locales:Locale.Widget_Scale}" FontSize="14" FontWeight="Bold"
                   IsHitTestVisible="False" HorizontalAlignment="Center" Margin="0 4 0 0"/>
        <TextBox Name="ScaleInput" Watermark="1.0" HorizontalAlignment="Center" MinWidth="160"
                 TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="{x:Static locales:Locale.Widget_Scale_Reset}" Click="Reset" />
            <Button Content="{x:Static locales:Locale.Widget_Save}" Click="Apply" />
        </StackPanel>
    </StackPanel>
</Window>
