<views:HostDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeskCanvas.Views"
        xmlns:ui="using:DeskCanvas.UI.Controls"
        xmlns:locales="clr-namespace:DeskCanvas.Locales"
        x:Class="DeskCanvas.Views.ScaleDialog"
        WindowStartupLocation="CenterOwner"
        Width="332" Height="206" CanResize="False">

    <!-- 缩放比例: a plain dialog on the shared chrome. The card is the shell's, the title is its
         header (which is also the drag handle), and the window is transparent around the card —
         the old AXAML put a card with an 8 DIP margin inside an AcrylicBlur window, which read as
         a frosted ring around the dialog and swallowed every attempt to drag it. -->
    <ui:DialogShell Title="{x:Static locales:Locale.Widget_Scale}">
        <StackPanel Spacing="10" VerticalAlignment="Center">
            <TextBox Name="ScaleInput" PlaceholderText="1.0" HorizontalAlignment="Center" MinWidth="160"
                     TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="{x:Static locales:Locale.Widget_Scale_Reset}" Click="Reset" />
                <Button Content="{x:Static locales:Locale.Widget_Save}" Click="Apply" />
            </StackPanel>
        </StackPanel>
    </ui:DialogShell>
</views:HostDialogWindow>
