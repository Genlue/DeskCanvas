<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskCanvas.Views.Controls.CollapsibleSection">
    <!-- The fold's chrome is the one 应用主题 › 液态玻璃 used to declare inline: a borderless,
         background-free Button whose content is the section title plus a chevron that flips. The
         Button is deliberate (not an Expander/ToggleButton): the header must not gain a pill shape
         or a checked-state fill just because it can be clicked.
         Rows go in SectionContent, not Content: this control's own XAML *is* its Content, so a
         caller's child element would replace the header instead of sitting under it. -->
    <StackPanel Spacing="3">
        <Button x:Name="HeaderButton"
                Click="OnHeaderClick"
                HorizontalAlignment="Left"
                Margin="0 0 6 0"
                Padding="0"
                BorderThickness="0"
                Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <!-- Collapsed: chevron pointing down. Expanded: the same chevron flipped. -->
                <PathIcon x:Name="ChevronClosed" Width="12" Height="12" VerticalAlignment="Center"
                          Data="M 1.6 3.2 L 6 7.6 L 10.4 3.2 L 10.4 5 L 6 9.4 L 1.6 5 Z" />
                <PathIcon x:Name="ChevronOpen" Width="12" Height="12" VerticalAlignment="Center"
                          Data="M 1.6 8.8 L 6 4.4 L 10.4 8.8 L 10.4 7 L 6 2.6 L 1.6 7 Z" />
            </StackPanel>
        </Button>
        <!-- A plain Panel, not a ContentPresenter: the rows stay in the tree while the fold is
             closed (hidden, not rebuilt), so their editors keep their state across a collapse and
             nothing that walks the page — a locale sweep, a settings check — misses them. -->
        <Panel x:Name="Body" />
    </StackPanel>
</UserControl>
