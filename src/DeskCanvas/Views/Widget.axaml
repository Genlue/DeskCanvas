<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:locales="clr-namespace:DeskCanvas.Locales"
        xmlns:views="clr-namespace:DeskCanvas.Views"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls"
        x:Class="DeskCanvas.Views.Widget"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ToolTip.Placement="BottomEdgeAlignedRight"
        ToolTip.VerticalOffset="-25"
        ToolTip.HorizontalOffset="7"
        WindowDecorations="{Binding WidgetSystemDecorations}"
        ExtendClientAreaToDecorationsHint="{Binding WidgetExtendClientArea}"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="False"
        x:DataType="views:Widget"
        Classes="Widget">
    <Window.ContextMenu>
        <ContextMenu Classes="WidgetContextMenu">
            <MenuItem Header="{Binding EditStackChildTitle}" Command="{Binding EditCurrentStackedWidget}" IsVisible="{Binding CanEditStackedWidgetChild}" />
            <MenuItem Header="{Binding EditStackTitle}" Command="{Binding EditWidget}" IsVisible="{Binding ShowStackEditButton}" />
            <MenuItem Header="{Binding Edit}" Command="{Binding EditWidget}" IsVisible="{Binding ShowNormalEditButton}" />
            <MenuItem Header="{Binding SizeMenuTitle}">
                <!-- 4:2 ratio fixed widgets (e.g. Aggregate) -->
                <MenuItem Header="{Binding Preset4x2StdTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x2" IsVisible="{Binding IsFixed2x1Widget}" />
                <MenuItem Header="{Binding Preset6x3ScaleTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="6x3" IsVisible="{Binding IsFixed2x1Widget}" />
                <MenuItem Header="{Binding Preset8x4ScaleTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="8x4" IsVisible="{Binding IsFixed2x1Widget}" />
                <!-- 1:1 square fixed widgets (e.g. Single-dial Analog Clock) -->
                <MenuItem Header="{Binding Preset1x1SmallTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="1x1" IsVisible="{Binding IsFixedSquareWidget}" />
                <MenuItem Header="{Binding Preset2x2SquareStdTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="2x2" IsVisible="{Binding IsFixedSquareWidget}" />
                <MenuItem Header="{Binding Preset3x3MediumTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="3x3" IsVisible="{Binding IsFixedSquareWidget}" />
                <MenuItem Header="{Binding Preset4x4LargeTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x4" IsVisible="{Binding IsFixedSquareWidget}" />
                <!-- 2x2 base square fixed widgets (e.g. FourDayForecast) -->
                <MenuItem Header="{Binding Preset2x2BaseStdTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="2x2" IsVisible="{Binding IsFixed2x2SquareWidget}" />
                <MenuItem Header="{Binding Preset3x3ScaleTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="3x3" IsVisible="{Binding IsFixed2x2SquareWidget}" />
                <MenuItem Header="{Binding Preset4x4ScaleTitle}" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x4" IsVisible="{Binding IsFixed2x2SquareWidget}" />
                <!-- Map widget quick size presets (2x2, 4x2, 4x4) -->
                <MenuItem Header="{Binding PresetMap2x2Title}" Command="{Binding SetFixedSpanPreset}" CommandParameter="2x2" IsVisible="{Binding IsMapWidget}" />
                <MenuItem Header="{Binding PresetMap4x2Title}" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x2" IsVisible="{Binding IsMapWidget}" />
                <MenuItem Header="{Binding PresetMap4x4Title}" Command="{Binding SetFixedSpanPreset}" CommandParameter="4x4" IsVisible="{Binding IsMapWidget}" />
                <Separator IsVisible="{Binding IsMapWidget}" />
                <Separator IsVisible="{Binding IsFixedWidget}" />
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto" Width="200">
                            <TextBlock Text="{x:Static locales:Locale.Widget_Size_Columns}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="999" Increment="1"
                                           FormatString="F0" ParsingNumberStyle="Integer"
                                           Value="{Binding SizeColumnsValue}" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto" Width="200">
                            <TextBlock Text="{x:Static locales:Locale.Widget_Size_Rows}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="999" Increment="1"
                                           FormatString="F0" ParsingNumberStyle="Integer"
                                           Value="{Binding SizeRowsValue}" />
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding ScaleMenuTitle}" Command="{Binding OpenScaleDialog}" />
            <MenuItem Header="{x:Static locales:Locale.Profiles_MenuTitle}" ItemsSource="{Binding ProfileMenuItems}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Widget_Remove}" Command="{Binding Remove}" />
            <Separator />
            <!-- Escape hatch for a tray icon hidden from the tray menu itself. -->
            <MenuItem Header="{x:Static locales:Locale.Tray_ShowIcon}" ToggleType="CheckBox"
                      IsChecked="{Binding TrayIconVisible, Mode=TwoWay}" />
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Settings}" Command="{Binding OpenSettings}" />
        </ContextMenu>
    </Window.ContextMenu> 
    
    <Window.Styles>
        <!-- 右键菜单固定 12px 圆角，不再跟随组件卡片圆角（卡片可达 36+）；外壳与悬停高亮
             （菜单项 CornerRadius）保持同一圆度——两者的圆度不一致时，5px 内边距下悬停高亮
             的方角会贴着外壳的弧线，看着是两个互不相干的形状（实机截图比对过）。 -->
        <Style Selector="ContextMenu.WidgetContextMenu">
            <Setter Property="CornerRadius" Value="{DynamicResource HostSurfaceCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource WidgetContextMenuPadding}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ContextMenu.WidgetContextMenu MenuItem">
            <Setter Property="CornerRadius" Value="{DynamicResource HostSurfaceCornerRadius}" />
            <Setter Property="Margin" Value="{DynamicResource WidgetContextMenuItemMargin}" />
        </Style>
        <Style Selector="Border:not(:pointerover) ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="Border:pointerover ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <!-- 横向必须是 Hidden（可滚动、永不显示滚动条），不能是 Auto：
                 组件卡片（清单名、搜索、天气横滚等）一律不允许出现横向滚动条，
                 而 Hidden 仍保留横向滚轮滚动与文本框光标跟随。
                 这里是全应用唯一给悬停发横向可见性的地方——改成 Hidden 后，
                 横向滚动条在卡片里结构性不可能出现。 -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>
        <!-- 组件内容的内边距不在这里定义：它由 App.axaml 的 .widget-content-host 规则给出，
             下面卡片的 Border 带这个类。搬到全局是为了让组件库预览用同一条规则——此前预览
             自己硬编码 12px，30 个组件里 14 个（自带 Margin="0" 的那些）被多缩进了一圈。 -->
    </Window.Styles>
    
    <Grid>
        <!-- Rendered glass surface (液态玻璃 / 柔光玻璃: refraction, glow, vibrancy, wallpaper sampling) -->
        <controls:LiquidGlassSurface Material="{Binding GlassMaterial, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                                     CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                                     Margin="{Binding WidgetMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                                     IsVisible="{Binding ShowsGlassMaterial, RelativeSource={RelativeSource AncestorType=views:Widget}}" />
        <!-- Card (frosted glass, OS-level acrylic): fills the grid cell minus the
             configured margin, with the configured corner radius. The blur comes
             from the OS backdrop (AcrylicBlur hint set by Styles/Transparent.axaml),
             which samples the live desktop every frame — dynamic wallpapers stay
             live. The native window region is clipped to the same rectangle (see
             ApplyWidgetRegion) so the OS blur follows the card and the transparent
             margin stays click-through.
             The specular rim is a separate overlay (see below): this card no longer
             carries a 描边 border. -->
        <Border Name="Border"
                Classes="widget-content-host"
                CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Background="{Binding WidgetCardBackground, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Margin="{Binding WidgetMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}">
            <!-- Content: sized by the card only; the content scale (Scale()) is a
                 render transform on this presenter, so it never resizes the card. -->
            <ContentPresenter Name="ContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                        <!-- ClipToBounds must stay OFF: this wrapper's bounds ARE the card
                             rectangle, and Avalonia's ContentControl clips by default. It was
                             the third and last cut a zoomed icon met — the host already clears
                             ContentPresenter.Clip for views that declare
                             IWidgetSurfaceHints.AllowsCardOverflow, and this wrapper then
                             re-applied the same cut one level down. The rounded clip that keeps
                             ordinary widgets inside the card lives on the presenter above. -->
                        <ContentControl Content="{Binding}"
                                        ClipToBounds="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </DataTemplate>
                </ContentPresenter.ContentTemplate>
            </ContentPresenter>
        </Border>

        <!-- Specular rim for the materials the wallpaper-sampled renderer does not draw
             (毛玻璃 / 全彩): the same |dot(edge normal, light)| hairline as 液态玻璃's shader
             highlight, with 高光 strength and 高光角度 shared from the theme. -->
        <controls:SpecularHighlight
                x:Name="SpecularRimLayer"
                Margin="{Binding WidgetMargin, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Strength="{Binding HighlightStrength, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                Angle="{Binding HighlightAngle, RelativeSource={RelativeSource AncestorType=views:Widget}}"
                IsVisible="{Binding ShowsSpecularHighlight, RelativeSource={RelativeSource AncestorType=views:Widget}}" />

        <!-- Generic decoration overlay slot (W10): the hosted content may provide a decoration
             control via IWidgetOverlayProvider (e.g. the Stack widget's pagination dots, which
             moved into the Stack plugin). The host fills this presenter from the provider,
             positions it per the provider's WidgetOverlayHints (outside/inside card, acrylic
             inset, hit area) and keeps the window-region work here (ApplyWidgetRegion). Legacy
             content that only implements IStackWidget reaches the same slot through
             LegacyStackOverlayAdapter. Empty presenters render nothing. -->
        <ContentPresenter Name="OverlayHost"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          IsHitTestVisible="True"
                          ZIndex="85" />
    </Grid>
</Window>
