<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeskCanvas.Views.ConfirmDialog"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">
    <Border Background="{DynamicResource SettingsBackground}"
            CornerRadius="10"
            BoxShadow="0 4 16 0 #80000000"
            Padding="24"
            Margin="16">
        <StackPanel Spacing="16" MaxWidth="400">
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Click="OnCancel" IsVisible="False" />
                <Button x:Name="ConfirmButton" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>