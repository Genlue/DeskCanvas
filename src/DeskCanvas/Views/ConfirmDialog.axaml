<views:HostDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DeskCanvas.Views"
        xmlns:ui="using:DeskCanvas.UI.Controls"
        x:Class="DeskCanvas.Views.ConfirmDialog"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight">

    <!-- A message-only alert: no header, so the shell paints just the card and hands the drag to
         the card itself (buttons keep their input). The card, its hairline, its radius and the
         shadow gutter come from the shared dialog chrome — this file owns the message and the two
         buttons only. -->
    <ui:DialogShell ContentPadding="24">
        <StackPanel Spacing="16" MaxWidth="400">
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Click="OnCancel" IsVisible="False" />
                <Button x:Name="ConfirmButton" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </ui:DialogShell>
</views:HostDialogWindow>
