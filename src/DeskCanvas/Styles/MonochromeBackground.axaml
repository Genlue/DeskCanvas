<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=".Widget TextBox">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 背景色 monochrome: ALL text AND accent colors lock to the inverted
                     background — light mode renders the dark-mode background color
                     (SystemAccentColorDark1), dark mode the light-mode one
                     (SystemAccentColorLight2), the ramp ThemeService.ApplyAccent writes in
                     this variant. The text family and the accent family therefore share one
                     color per variant; AccentContrast flips polarity: white content on the
                     dark-ish accent (light), black on the light-ish accent (dark).
                     Decorative tints (card border, clock dial, strokes) stay achromatic. -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <!-- On the accent (the dark-mode background color in this variant), white stays readable. -->
                    <SolidColorBrush x:Key="AccentContrastForegroundBrush" Color="White" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherTempBarBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="Black" Opacity="0.2" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="Black" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <!-- On the accent (the light-mode background color in this variant), black is required. -->
                    <SolidColorBrush x:Key="AccentContrastForegroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherTempBarBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="White" Opacity="0.2" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="White" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
