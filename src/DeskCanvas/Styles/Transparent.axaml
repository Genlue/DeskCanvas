<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 毛玻璃 surface: OS-level AcrylicBlur (set per-window in Widget/Settings
         through the local TransparencyLevelHint). The card color follows the
         active dark/light variant through the theme dictionaries below and is
         set by ThemeService (SolidBackgroundDark/Light) — the same custom
         colors used by the 纯色 surface. -->
    <Style>
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SolidBackgroundLight}" Opacity="{DynamicResource BackgroundOpacity}" />
                        <SolidColorBrush x:Key="SettingsBackground" Color="#F5F5F7" Opacity="1.0" />
                        <SolidColorBrush x:Key="SettingsWindowBackground" Color="#F5F5F7" Opacity="0.80" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SolidBackgroundDark}" Opacity="{DynamicResource BackgroundOpacity}" />
                        <SolidColorBrush x:Key="SettingsBackground" Color="#1C1C1E" Opacity="1.0" />
                        <SolidColorBrush x:Key="SettingsWindowBackground" Color="#1C1C1E" Opacity="0.80" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <x:Double x:Key="TextOpacity">0.8</x:Double>
            </ResourceDictionary>
        </Style.Resources>
    </Style>
    <Style Selector="Window.Widget">
        <Setter Property="TransparencyLevelHint" Value="AcrylicBlur" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Opacity" Value="0.8" />
    </Style>
</Styles>
