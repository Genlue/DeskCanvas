<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 毛玻璃 surface: OS-level AcrylicBlur (set per-window in Widget/Settings
         through the local TransparencyLevelHint). The card color follows the
         active dark/light variant through the theme dictionaries below and is
         set by ThemeService (SolidBackgroundDark/Light) — the same custom
         colors used by the 纯色 surface. -->
    <Style>
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SolidBackgroundLight}" Opacity="{DynamicResource BackgroundOpacity}" />
                        <SolidColorBrush x:Key="SettingsBackground" Color="#F5F5F7" Opacity="1.0" />
                        <SolidColorBrush x:Key="SettingsWindowBackground" Color="#F5F5F7" Opacity="0.80" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SolidBackgroundDark}" Opacity="{DynamicResource BackgroundOpacity}" />
                        <SolidColorBrush x:Key="SettingsBackground" Color="#1C1C1E" Opacity="1.0" />
                        <SolidColorBrush x:Key="SettingsWindowBackground" Color="#1C1C1E" Opacity="0.80" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <x:Double x:Key="TextOpacity">0.8</x:Double>
                <!-- Consumed by the TextBlock style below. A dedicated key on purpose:
                     App.axaml's own TextOpacity (1.0, Application.Resources) shadows the style
                     dictionaries' values, so an override needs a key only the surface
                     dictionaries define. 失焦自动切换 overrides it per widget window. -->
                <x:Double x:Key="WidgetTextOpacity">0.8</x:Double>
            </ResourceDictionary>
        </Style.Resources>
    </Style>
    <Style Selector="Window.Widget">
        <Setter Property="TransparencyLevelHint" Value="AcrylicBlur" />
    </Style>
    <Style Selector="TextBlock">
        <!-- 0.8 is this material's historic text opacity (the resource above). The
             DynamicResource indirection lets a widget window override it per window:
             失焦自动切换 may show this material on one screen and a liquid material on
             another — see FocusThemeCoordinator.ApplySurfaceOverrides. -->
        <Setter Property="Opacity" Value="{DynamicResource WidgetTextOpacity}" />
    </Style>
</Styles>
