<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=".Widget TextBox">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 黑白 monochrome: dark mode → white, light mode → black.
                     Both the text color (BaseHigh) and the accent color
                     (AccentBrush — titles/accents) are unified to black/white,
                     so a widget has exactly one color on screen. -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="Black" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="Black" />
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="Black" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="Black" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="Black" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="Black" />
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="Black" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="Black" />
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="Black" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="Black" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="Black" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="Black" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="Black" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="Black" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="Black" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="Black" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="Black" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="Black" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="Black" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="Black" />
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="Black" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="Black" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="Black" />
                    <SolidColorBrush x:Key="WeatherTempBarBrush" Color="Black" />
                    <SolidColorBrush x:Key="WeatherCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="Black" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="Black" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="Black" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="Black" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="Black" Opacity="0.2" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="Black" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="White" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="White" />
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="White" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="White" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="White" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="White" />
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="White" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="White" />
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="White" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="White" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="White" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="White" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="White" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="White" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="White" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="White" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="White" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="White" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="White" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="White" />
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="White" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="White" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="White" />
                    <SolidColorBrush x:Key="WeatherTempBarBrush" Color="White" />
                    <SolidColorBrush x:Key="WeatherCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="White" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="White" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="White" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="White" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="White" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="White" />
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="White" Opacity="0.2" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="White" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
