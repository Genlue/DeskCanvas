                    <SolidColorBrush x:Key="HitokotoPillForegroundBrush" Color="#DAB6FC" />
                    <SolidColorBrush x:Key="HitokotoButtonHoverBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="HitokotoButtonPressedBrush" Color="#35FFFFFF" />

                    <!-- Batteries: Apple Power Management (Dark) -->
                    <SolidColorBrush x:Key="BatteriesCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="BatteriesTrackBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="BatteriesIconBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BatteriesTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BatteriesNormalBrush" Color="#30D158" />
                    <SolidColorBrush x:Key="BatteriesChargingBrush" Color="#30D158" />
                    <SolidColorBrush x:Key="BatteriesWarningBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="BatteriesCriticalBrush" Color="#FF453A" />

                    <!-- Monitor: Apple 4-color telemetry rings & card (Dark) -->
                    <SolidColorBrush x:Key="MonitorCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="MonitorTrackBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="#BF5AF2" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="#64D2FF" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="#30D158" />

                    <!-- Storage: macOS Storage Palette (Dark) -->
                    <SolidColorBrush x:Key="StorageCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="StorageSubCardBackground" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="StorageSubCardBorderBrush" Color="#3A3A3C" />
                    <SolidColorBrush x:Key="StorageTrackBackground" Color="#2C2C2E" />
