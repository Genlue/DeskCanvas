                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="#64D2FF" />
                    <LinearGradientBrush x:Key="WeatherTempBarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#30D158" />
                        <GradientStop Offset="0.5" Color="#FFD60A" />
                        <GradientStop Offset="1" Color="#FF9F0A" />
                    </LinearGradientBrush>

                    <!-- Card Border & Clock Dial / Strokes (Dark) -->
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#25FFFFFF" />
                    <!-- 表盘-1 的卡片：与亮色档一致，恒为 Apple 深灰黑（恒黑卡片）；
                         表盘-2 (AnalogIII) 与表盘-3 (AnalogIV) 暗色档深灰黑。 -->
                    <SolidColorBrush x:Key="ClockCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ClockAnalogIIICardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ClockAnalogIVCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="FlipClockCardBackground" Color="#1C1C1E" />
                    <!-- 数字时钟卡片与元素画刷 (Dark) -->
                    <SolidColorBrush x:Key="ClockDigitalCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ClockDigitalTimeBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ClockDigitalDateBrush" Color="#FF9F0A" />
                    <!-- 刻度时钟（TickClock）：暗色档换成等值炭黑卡 (Dark) -->
                    <SolidColorBrush x:Key="TickClockCardBackground" Color="#1C1C1E" />

                    <!-- Calendar 日历卡片背景 (Dark) -->
                    <SolidColorBrush x:Key="CalendarCardBackground" Color="#1C1C1E" />

                    <!-- Timetable 课程表卡片背景 (Dark) -->
                    <SolidColorBrush x:Key="TimetableCardBackground" Color="#1C1C1E" />
                    <!-- 表盘-1 内圈面盘（多彩暗色档）：叠在恒黑卡片上呈 #373738，
                         与表盘-3「黑白」的暗色黑同值。 -->
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="#373738" Opacity="1.0" />
                    <SolidColorBrush x:Key="ClockOpaqueDialBackgroundBrush" Color="{DynamicResource SolidBackgroundLight}" Opacity="1.0" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="FlipClockTopFlapBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="FlipClockBottomFlapBrush" Color="#232325" />
                    <SolidColorBrush x:Key="FlipClockFlapBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="FlipClockCreaseBrush" Color="#88000000" />
                    <SolidColorBrush x:Key="FlipClockHingeBrush" Color="#48FFFFFF" />
                    <!-- Contrast Accent (Dark) -->
                    <SolidColorBrush x:Key="AccentContrastForegroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
