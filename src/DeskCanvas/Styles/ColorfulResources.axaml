                    <!-- Pomodoro: Apple Focus dark card with dynamic semantic ring & button -->
                    <SolidColorBrush x:Key="PomodoroCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="PomodoroPillBackgroundBrush" Color="#18FFFFFF" />
