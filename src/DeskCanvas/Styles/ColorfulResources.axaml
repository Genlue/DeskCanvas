                    <SolidColorBrush x:Key="CalculatorOpButtonBackground" Color="#2EFF9F0A" />

                    <!-- Clipboard: Apple Clipboard (Dark) -->
                    <SolidColorBrush x:Key="ClipboardCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ClipboardItemCardBackground" Color="#262629" />
                    <SolidColorBrush x:Key="ClipboardItemCardHoverBackground" Color="#323236" />
                    <SolidColorBrush x:Key="ClipboardBadgeTextBgBrush" Color="#250A84FF" />
                    <SolidColorBrush x:Key="ClipboardBadgeTextBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="ClipboardBadgeCodeBgBrush" Color="#2530D158" />
                    <SolidColorBrush x:Key="ClipboardBadgeCodeBrush" Color="#30D158" />
                    <SolidColorBrush x:Key="ClipboardBadgeLinkBgBrush" Color="#25BF5AF2" />
                    <SolidColorBrush x:Key="ClipboardBadgeLinkBrush" Color="#BF5AF2" />
                    <SolidColorBrush x:Key="ClipboardBadgeFileBgBrush" Color="#25FF9F0A" />
                    <SolidColorBrush x:Key="ClipboardBadgeFileBrush" Color="#FF9F0A" />

                    <!-- ControlCenter: Apple Control Center (Dark) -->
                    <SolidColorBrush x:Key="ControlCenterCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ControlCenterCapsuleBackground" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="ControlCenterBadgeInactiveBackground" Color="#3A3A3C" />

                    <!-- Map: Apple Maps (Dark) -->
                    <SolidColorBrush x:Key="MapCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="MapFloatingButtonBackground" Color="#D92C2C2E" />

                    <!-- Time Progress: Apple Fitness Pure Pitch Black with High Luminosity (Dark) -->
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="#000000" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="#FA114F" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="#AFFF00" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="#00F5D4" />

                    <!-- Search: Spotlight search pill & controls (Dark) -->
                    <SolidColorBrush x:Key="SearchCardBackground" Color="#1C1C1E" />
