                    <SolidColorBrush x:Key="StorageMediaBrush" Color="#64D2FF" />
                    <SolidColorBrush x:Key="StorageRemovableBrush" Color="#30D158" />
                    <SolidColorBrush x:Key="StorageWarningBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="StorageCriticalBrush" Color="#FF453A" />

                    <!-- Folders: macOS Finder Sky Blue (Dark) -->
                    <SolidColorBrush x:Key="FoldersCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="#33AAFF" />

                    <!-- Translate: Apple Translate blue (Dark) -->
                    <SolidColorBrush x:Key="TranslatorCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="TranslatorInputBackground" Color="#262629" />
                    <SolidColorBrush x:Key="TranslatorOutputBackground" Color="#1A2433" />
