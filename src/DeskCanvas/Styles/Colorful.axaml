<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 多彩 (Colorful / macOS 18 Flat Opaque) theme:
         1:1 replication of authentic macOS 18 / iOS 18 flat, opaque widgets.
         Widgets are crisp, fully-opaque cards with fixed Apple HIG palettes.
         Native acrylic blur is reserved for context menus and the Settings window. -->
    <Style Selector="Window.Widget">
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
    </Style>

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ==================== Light Theme (Default) ==================== -->
                <ResourceDictionary x:Key="Default">
                    <!-- Standard macOS 18 Opaque Flat Card Background -->
                    <SolidColorBrush x:Key="WidgetBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#C7C7CC" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#007AFF" />

                    <!-- Apple Human Interface Guidelines System Colors (Light) -->
                    <SolidColorBrush x:Key="MacosRedBrush" Color="#FF3B30" />
                    <SolidColorBrush x:Key="MacosOrangeBrush" Color="#FF9500" />
                    <SolidColorBrush x:Key="MacosYellowBrush" Color="#FFCC00" />
                    <SolidColorBrush x:Key="MacosGreenBrush" Color="#34C759" />
                    <SolidColorBrush x:Key="MacosMintBrush" Color="#00C7BE" />
                    <SolidColorBrush x:Key="MacosTealBrush" Color="#30B0C7" />
                    <SolidColorBrush x:Key="MacosCyanBrush" Color="#32ADE6" />
                    <SolidColorBrush x:Key="MacosBlueBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="MacosIndigoBrush" Color="#5856D6" />
                    <SolidColorBrush x:Key="MacosPurpleBrush" Color="#AF52DE" />
                    <SolidColorBrush x:Key="MacosPinkBrush" Color="#FF2D55" />

                    <!-- Calendar: Apple Red header, today marker, dark day text -->
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="#FF3B30" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#FF3B30" />

                    <!-- Clock: Solid black hour/minute hands, vibrant Apple Orange second hand -->
                    <SolidColorBrush x:Key="ClockHandBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="#FF9500" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="#FF9500" />

                    <!-- Reminders: Apple Blue badge & circular checkmarks, dark text -->
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="#007AFF" />

                    <!-- Notes: Apple Notes yellow header, pure white content area, dark text -->
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="#FFCC00" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="#8E8E93" />

                    <!-- Music: Apple Music Red -->
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="#FA2D48" />

                    <!-- Monitor: Apple 4-color telemetry rings -->
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="#AF52DE" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="#FF9500" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="#30B0C7" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="#34C759" />

                    <!-- Folders: macOS Finder Sky Blue -->
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="#29A3FF" />

                    <!-- Translate: Apple Translate blue & soft gray card -->
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="#F2F2F7" />

                    <!-- Time Progress: Pure white in light mode, authentic Apple dark card in dark mode -->
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="#FA114F" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="#AFFF00" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="#00F5D4" />

                    <!-- Search: Spotlight search pill -->
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="#E5E5EA" />

                    <!-- Weather: Apple Weather Sky Blue opaque gradient, pure white typography -->
                    <LinearGradientBrush x:Key="WeatherCardBackground" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#1B71BE" />
                        <GradientStop Offset="1.0" Color="#509CEB" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="#FFD60A" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="#5AC8FA" />
                    <LinearGradientBrush x:Key="WeatherTempBarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#34C759" />
                        <GradientStop Offset="0.5" Color="#FFCC00" />
                        <GradientStop Offset="1" Color="#FF9500" />
                    </LinearGradientBrush>

                    <!-- Card Border & Clock Dial / Strokes (Light) -->
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="#8E8E93" />
                </ResourceDictionary>

                <!-- ==================== Light Theme (Light Alias) ==================== -->
                <ResourceDictionary x:Key="Light">
                    <!-- Standard macOS 18 Opaque Flat Card Background -->
                    <SolidColorBrush x:Key="WidgetBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#C7C7CC" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#007AFF" />

                    <!-- Apple Human Interface Guidelines System Colors (Light) -->
                    <SolidColorBrush x:Key="MacosRedBrush" Color="#FF3B30" />
                    <SolidColorBrush x:Key="MacosOrangeBrush" Color="#FF9500" />
                    <SolidColorBrush x:Key="MacosYellowBrush" Color="#FFCC00" />
                    <SolidColorBrush x:Key="MacosGreenBrush" Color="#34C759" />
                    <SolidColorBrush x:Key="MacosMintBrush" Color="#00C7BE" />
                    <SolidColorBrush x:Key="MacosTealBrush" Color="#30B0C7" />
                    <SolidColorBrush x:Key="MacosCyanBrush" Color="#32ADE6" />
                    <SolidColorBrush x:Key="MacosBlueBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="MacosIndigoBrush" Color="#5856D6" />
                    <SolidColorBrush x:Key="MacosPurpleBrush" Color="#AF52DE" />
                    <SolidColorBrush x:Key="MacosPinkBrush" Color="#FF2D55" />

                    <!-- Calendar: Apple Red header, today marker, dark day text -->
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="#FF3B30" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#FF3B30" />

                    <!-- Clock: Solid black hour/minute hands, vibrant Apple Orange second hand -->
                    <SolidColorBrush x:Key="ClockHandBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="#FF9500" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="#FF9500" />

                    <!-- Reminders: Apple Blue badge & circular checkmarks, dark text -->
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="#007AFF" />

                    <!-- Notes: Apple Notes yellow header, pure white content area, dark text -->
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="#FFCC00" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="#8E8E93" />

                    <!-- Music: Apple Music Red -->
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="#FA2D48" />

                    <!-- Monitor: Apple 4-color telemetry rings -->
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="#AF52DE" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="#FF9500" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="#30B0C7" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="#34C759" />

                    <!-- Folders: macOS Finder Sky Blue -->
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="#29A3FF" />

                    <!-- Translate: Apple Translate blue & soft gray card -->
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="#F2F2F7" />

                    <!-- Time Progress: Pure white in light mode, authentic Apple dark card in dark mode -->
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="#FA114F" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="#AFFF00" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="#00F5D4" />

                    <!-- Search: Spotlight search pill -->
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="#007AFF" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="#E5E5EA" />

                    <!-- Weather: Apple Weather Sky Blue opaque gradient, pure white typography -->
                    <LinearGradientBrush x:Key="WeatherCardBackground" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#1B71BE" />
                        <GradientStop Offset="1.0" Color="#509CEB" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="#FFD60A" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="#5AC8FA" />
                    <LinearGradientBrush x:Key="WeatherTempBarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#34C759" />
                        <GradientStop Offset="0.5" Color="#FFCC00" />
                        <GradientStop Offset="1" Color="#FF9500" />
                    </LinearGradientBrush>

                    <!-- Card Border & Clock Dial / Strokes (Light) -->
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="#8E8E93" />
                </ResourceDictionary>

                <!-- ==================== Dark Theme (Dark) ==================== -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Standard macOS 18 Dark Opaque Charcoal Card Background -->
                    <SolidColorBrush x:Key="WidgetBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#98989D" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#48484A" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#0A84FF" />

                    <!-- Apple Human Interface Guidelines System Colors (Dark) -->
                    <SolidColorBrush x:Key="MacosRedBrush" Color="#FF453A" />
                    <SolidColorBrush x:Key="MacosOrangeBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="MacosYellowBrush" Color="#FFD60A" />
                    <SolidColorBrush x:Key="MacosGreenBrush" Color="#30D158" />
                    <SolidColorBrush x:Key="MacosMintBrush" Color="#63E6E2" />
                    <SolidColorBrush x:Key="MacosTealBrush" Color="#40C8E0" />
                    <SolidColorBrush x:Key="MacosCyanBrush" Color="#64D2FF" />
                    <SolidColorBrush x:Key="MacosBlueBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="MacosIndigoBrush" Color="#5E5CE6" />
                    <SolidColorBrush x:Key="MacosPurpleBrush" Color="#BF5AF2" />
                    <SolidColorBrush x:Key="MacosPinkBrush" Color="#FF375F" />

                    <!-- Calendar: Apple Red header, today marker, crisp white day text -->
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="#FF453A" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="#FF453A" />

                    <!-- Clock: Solid white hour/minute hands, vibrant Apple Orange second hand -->
                    <SolidColorBrush x:Key="ClockHandBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="#FF9F0A" />

                    <!-- Reminders: Apple Blue badge & circular checkmarks, white text -->
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="#0A84FF" />

                    <!-- Notes: Apple Notes yellow header, charcoal content area matching card, white text -->
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="#FFD60A" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="#38383A" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="#98989D" />

                    <!-- Music: Apple Music Red -->
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="#FF375F" />

                    <!-- Monitor: Apple 4-color telemetry rings -->
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="#BF5AF2" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="#64D2FF" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="#30D158" />

                    <!-- Folders: macOS Finder Sky Blue -->
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="#33AAFF" />

                    <!-- Translate: Apple Translate blue & dark card -->
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="#2C2C2E" />

                    <!-- Time Progress: Pure white in light mode, authentic Apple dark card in dark mode -->
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="#FA114F" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="#AFFF00" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="#00F5D4" />

                    <!-- Search: Spotlight search pill -->
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="#2C2C2E" />

                    <!-- Weather: Apple Weather Midnight Navy opaque gradient, pure white typography -->
                    <LinearGradientBrush x:Key="WeatherCardBackground" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#121E31" />
                        <GradientStop Offset="1.0" Color="#1E314F" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="#FFD60A" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="#64D2FF" />
                    <LinearGradientBrush x:Key="WeatherTempBarBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#30D158" />
                        <GradientStop Offset="0.5" Color="#FFD60A" />
                        <GradientStop Offset="1" Color="#FF9F0A" />
                    </LinearGradientBrush>

                    <!-- Card Border & Clock Dial / Strokes (Dark) -->
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="#8E8E93" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
