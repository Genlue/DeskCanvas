<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 多彩 (Colorful / macOS 18 Flat Opaque) theme:
         1:1 replication of authentic macOS 18 / iOS 18 flat, opaque widgets.
         Widgets are crisp, fully-opaque cards with fixed Apple HIG palettes.
         Native acrylic blur is reserved for context menus and the Settings window.

         The palette lives in ColorfulResources.axaml (a plain ResourceDictionary) so it
         can be consumed two ways:
         - app-wide: this style dictionary, loaded by ThemeService while the shared theme
           is 多彩 (its vibrant palette wins over the accent fallback by load order);
         - per window: FocusThemeCoordinator merges the same dictionary into a widget
           window that resolves to 多彩 as its focus-state theme, so 多彩 can appear on
           one screen while another material shows on the next without leaking the
           palette's Fluent-key overrides into the other windows. -->
    <Style Selector="Window.Widget">
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
    </Style>

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeskCanvas/Styles/ColorfulResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
