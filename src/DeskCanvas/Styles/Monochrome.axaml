<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector=".Widget TextBox">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
    </Style>
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{DynamicResource SystemAccentColorDark1}" Opacity="0.65" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockDigitalTimeBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockDigitalDateBrush" Color="{DynamicResource SystemAccentColorDark1}" Opacity="0.65" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MacosTealBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="HitokotoQuoteBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="HitokotoAuthorBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.65" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockDigitalTimeBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockDigitalDateBrush" Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.65" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MacosTealBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="HitokotoQuoteBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="HitokotoAuthorBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
