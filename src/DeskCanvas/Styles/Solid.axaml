<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 纯色 surface: per-pixel transparency (no OS blur) so the OpacityLevel
         slider blends the card with the desktop. The card color follows the
         active theme variant (dark/light) through the theme dictionaries below
         and is set by ThemeService (SolidBackgroundDark/Light). -->
    <Style Selector="Window.Widget">
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
    </Style>
    <Style>
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SolidBackgroundLight}" Opacity="{DynamicResource BackgroundOpacity}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WidgetBackground" Color="{DynamicResource SolidBackgroundDark}" Opacity="{DynamicResource BackgroundOpacity}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Style.Resources>
    </Style>
</Styles>
