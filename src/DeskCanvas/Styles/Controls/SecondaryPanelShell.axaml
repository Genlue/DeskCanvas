<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls">
    <!-- Compat style for the host facade type (glass-surface-port slice). The shared chrome
         template lives in DeskCanvas.UI (keyed PanelShellTemplate); a type selector matches the
         exact type only, so the facade needs its own thin style — the template source stays
         single. The shared shell's own style (same setters, ui type selector) keeps the shared
         type standalone for embedding apps. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DeskCanvas.UI/Styles/Controls/SecondaryPanelShellTemplate.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="controls|SecondaryPanelShell">
        <Setter Property="ContentPadding" Value="{DynamicResource SecondaryPanelContentPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource SecondaryPanelCornerRadius}" />
        <Setter Property="Template" Value="{StaticResource PanelShellTemplate}" />
    </Style>
</Styles>
