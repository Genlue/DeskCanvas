<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent foreground for widget titles and icons; monochrome styles load after it. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Readable foreground on an accent fill; monochrome variants override it. -->
                    <SolidColorBrush x:Key="AccentContrastForegroundBrush" Color="White" />
                    <!-- Color-level twin of the contrast brush. -->
                    <Color x:Key="AccentContrastColor">White</Color>
                    <!-- Fluent selection glyphs follow AccentContrastColor so they stay visible in every variant. -->
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{DynamicResource AccentContrastColor}" />
                    <!-- Pin hover/pressed accent fills to SystemAccentColor; opacity provides the feedback. -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{DynamicResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="CountdownPillBackgroundBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="CountdownTrackBrush" Color="#15000000" />
                    <!-- macOS system teal: a fixed brand accent for the aggregate weather icon. -->
                    <SolidColorBrush x:Key="MacosTealBrush" Color="#30B0C7" />
                    <!-- Semantic Fallback Brushes -->
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClockDigitalTimeBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ClockDigitalDateBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="FoldersCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TranslatorCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TranslatorInputBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="TranslatorOutputBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="TranslatorOutputBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="CalculatorAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="CalculatorCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CalculatorDisplayBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="CalculatorNumButtonBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="CalculatorFuncButtonBackground" Color="#20808080" />
                    <SolidColorBrush x:Key="CalculatorOpButtonBackground" Color="#20808080" />
                    <SolidColorBrush x:Key="ClipboardCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ClipboardItemCardBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="ClipboardItemCardHoverBackground" Color="#20808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeTextBgBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeTextBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClipboardBadgeCodeBgBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeCodeBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClipboardBadgeLinkBgBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeLinkBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ClipboardBadgeFileBgBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeFileBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ControlCenterCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ControlCenterCapsuleBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="ControlCenterBadgeInactiveBackground" Color="#20808080" />
                    <SolidColorBrush x:Key="MapCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MapFloatingButtonBackground" Color="#80808080" />
                    <SolidColorBrush x:Key="SearchCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="SearchEngineButtonBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="SearchDockButtonBackground" Color="#12808080" />
                    <SolidColorBrush x:Key="SearchButtonBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="RemindersDotOrange" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersDotRed" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersDotBlue" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="RemindersDotPurple" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherTempBarBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WeatherCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NotesCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicScrubberTrackBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="MusicPlayButtonBackgroundBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="MusicPlayButtonHoverBrush" Color="#30808080" />
                    <SolidColorBrush x:Key="MusicCoverPlaceholderBrush" Color="#10808080" />
                    <SolidColorBrush x:Key="MusicCoverBorderBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="PomodoroCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="PomodoroPillBackgroundBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="PomodoroPillBorderBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="PomodoroButtonBackgroundBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="PomodoroButtonHoverBrush" Color="#30808080" />
                    <SolidColorBrush x:Key="HitokotoCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="HitokotoWatermarkBrush" Color="{DynamicResource SystemAccentColorDark1}" Opacity="0.15" />
                    <SolidColorBrush x:Key="HitokotoQuoteBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="HitokotoAuthorBrush" Color="{DynamicResource SystemBaseMediumColor}" />
                    <SolidColorBrush x:Key="HitokotoPillBackgroundBrush" Color="#15808080" />
                    <SolidColorBrush x:Key="HitokotoPillBorderBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="HitokotoPillForegroundBrush" Color="{DynamicResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="HitokotoButtonHoverBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="HitokotoButtonPressedBrush" Color="#35808080" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="{DynamicResource SystemBaseMediumColor}" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#15000000" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.2" />
                    <!-- 跟随背景 (表盘-1 不透明档) 交叉取值：亮色变体用暗色背景色、暗色变体用亮色背景色
                         （与 Batteries/Storage 的 "inverted background" 同规），使表盘与当前卡片背景形成对比。 -->
                    <SolidColorBrush x:Key="ClockOpaqueDialBackgroundBrush" Color="{DynamicResource SolidBackgroundDark}" Opacity="1.0" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="FlipClockTopFlapBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="FlipClockBottomFlapBrush" Color="#1B000000" />
                    <SolidColorBrush x:Key="FlipClockFlapBorderBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="FlipClockCreaseBrush" Color="#28000000" />
                    <SolidColorBrush x:Key="FlipClockHingeBrush" Color="#42000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentContrastForegroundBrush" Color="White" />
                    <Color x:Key="AccentContrastColor">White</Color>
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{DynamicResource AccentContrastColor}" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{DynamicResource AccentContrastColor}" />
                    <!-- 与 Default 字典同一修复（Fluent 的 hover/pressed 选中底色接了会翻转极性的
                         Light1/Dark1，单色下与圆点/勾/点撞成同色）。SystemAccentColor 本身已是按当前
                         变体解析的强调色，透明度负责 hover/pressed 的深浅反馈。 -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.7" />
                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <!-- 与 Default 块同一组 Normal 兜底，多彩模式由 ColorfulResources 覆盖；
                         取值按暗色极性（正文/灰阶取白系半透明，系统青取暗档变体）。 -->
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{DynamicResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="WidgetForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CountdownPillBackgroundBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="CountdownTrackBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="MacosTealBrush" Color="#40C8E0" />
                    <!-- Semantic Fallback Brushes -->
                    <SolidColorBrush x:Key="CalendarHeaderBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="CalendarTodayBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockSecondHandBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockCenterPinBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClockDigitalTimeBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ClockDigitalDateBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersBadgeBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersCheckBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NotesPaperBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorCpuBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorRamBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorDiskBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorNetBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="MonitorBatteryBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="FolderAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="FoldersCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TranslateAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="TranslateCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TranslatorCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TranslatorInputBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="TranslatorOutputBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="TranslatorOutputBorderBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="CalculatorAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="CalculatorCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="CalculatorDisplayBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="CalculatorNumButtonBackground" Color="#16808080" />
                    <SolidColorBrush x:Key="CalculatorFuncButtonBackground" Color="#24808080" />
                    <SolidColorBrush x:Key="CalculatorOpButtonBackground" Color="#24808080" />
                    <SolidColorBrush x:Key="ClipboardCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ClipboardItemCardBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="ClipboardItemCardHoverBackground" Color="#25808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeTextBgBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeTextBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClipboardBadgeCodeBgBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeCodeBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClipboardBadgeLinkBgBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeLinkBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ClipboardBadgeFileBgBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="ClipboardBadgeFileBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ControlCenterCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ControlCenterCapsuleBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="ControlCenterBadgeInactiveBackground" Color="#25808080" />
                    <SolidColorBrush x:Key="MapCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MapFloatingButtonBackground" Color="#80808080" />
                    <SolidColorBrush x:Key="SearchCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBorderBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="SearchEngineButtonBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="SearchDockButtonBackground" Color="#18808080" />
                    <SolidColorBrush x:Key="SearchButtonBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="RemindersDotOrange" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersDotRed" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersDotBlue" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="RemindersDotPurple" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ProgressMoveBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ProgressExerciseBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="ProgressStandBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SearchMagnifierBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherIconBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherGaugeBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherTempBarBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WeatherCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NotesCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MusicScrubberTrackBrush" Color="#30808080" />
                    <SolidColorBrush x:Key="MusicPlayButtonBackgroundBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="MusicPlayButtonHoverBrush" Color="#35808080" />
                    <SolidColorBrush x:Key="MusicCoverPlaceholderBrush" Color="#16808080" />
                    <SolidColorBrush x:Key="MusicCoverBorderBrush" Color="#25808080" />
                    <SolidColorBrush x:Key="PomodoroCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="PomodoroPillBackgroundBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="PomodoroPillBorderBrush" Color="#25808080" />
                    <SolidColorBrush x:Key="PomodoroButtonBackgroundBrush" Color="#18808080" />
                    <SolidColorBrush x:Key="PomodoroButtonHoverBrush" Color="#30808080" />
                    <SolidColorBrush x:Key="HitokotoCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="HitokotoWatermarkBrush" Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.2" />
                    <SolidColorBrush x:Key="HitokotoQuoteBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="HitokotoAuthorBrush" Color="{DynamicResource SystemBaseMediumColor}" />
                    <SolidColorBrush x:Key="HitokotoPillBackgroundBrush" Color="#20808080" />
                    <SolidColorBrush x:Key="HitokotoPillBorderBrush" Color="#25808080" />
                    <SolidColorBrush x:Key="HitokotoPillForegroundBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="HitokotoButtonHoverBrush" Color="#25808080" />
                    <SolidColorBrush x:Key="HitokotoButtonPressedBrush" Color="#40808080" />
                    <SolidColorBrush x:Key="NotesTextBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="NotesTitleForegroundBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="NotesDividerBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="NotesUpdatedBrush" Color="{DynamicResource SystemBaseMediumColor}" />
                    <SolidColorBrush x:Key="ClockHandBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="WeatherForegroundBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="ProgressCardBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SearchPillBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="ClockDialBackgroundBrush" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.2" />
                    <SolidColorBrush x:Key="ClockOpaqueDialBackgroundBrush" Color="{DynamicResource SolidBackgroundLight}" Opacity="1.0" />
                    <SolidColorBrush x:Key="ClockStrokesBrush" Color="{DynamicResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="FlipClockTopFlapBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="FlipClockBottomFlapBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="FlipClockFlapBorderBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="FlipClockCreaseBrush" Color="#78000000" />
                    <SolidColorBrush x:Key="FlipClockHingeBrush" Color="#48FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
