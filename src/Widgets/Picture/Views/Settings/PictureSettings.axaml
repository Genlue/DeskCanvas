<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:picControls="clr-namespace:Picture.Controls"
             xmlns:locales="clr-namespace:Picture.Locales"
             xmlns:models="clr-namespace:Picture.Models"
             x:Class="Picture.Views.Settings.PictureSettings"
             controls:SettingsPage.ScrollOwnership="Host">

    <StackPanel Orientation="Vertical" Spacing="6" Margin="0 0 10 0">
        <!-- 图片库操作栏 -->
        <controls:Setting Title="{x:Static locales:Locale.Picture_LibraryTitle}" Subtitle="{x:Static locales:Locale.Picture_LibrarySubtitle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static locales:Locale.Picture_AddFiles}" Click="OnAddFilesClicked" />
                <Button Content="{x:Static locales:Locale.Picture_AddFolder}" Click="OnAddFolderClicked" />
                <Button Content="{x:Static locales:Locale.Picture_Clear}" Click="OnClearAllClicked" />
            </StackPanel>
        </controls:Setting>

        <!-- 图片列表 -->
        <Border Background="#15FFFFFF" CornerRadius="8" Padding="6" Margin="0 4">
            <Grid RowDefinitions="Auto,Auto">
                <ListBox Name="PictureListBox" MaxHeight="160" SelectionChanged="OnPictureSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PictureItem">
                            <Grid ColumnDefinitions="*,Auto" Margin="2">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="OnDeleteItemClicked"
                                        Padding="6,2" VerticalAlignment="Center" Margin="8 0 0 0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="4 6 0 2" HorizontalAlignment="Right">
                    <Button Content="{x:Static locales:Locale.Picture_MoveUp}" Click="OnMoveUpClicked" />
                    <Button Content="{x:Static locales:Locale.Picture_MoveDown}" Click="OnMoveDownClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 手动裁切与取景控制面板 -->
        <Border Name="CropPanel" Background="#15FFFFFF" CornerRadius="8" Padding="10" Margin="0 4">
            <StackPanel Orientation="Vertical" Spacing="6">
                <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Picture_CropSettings}" Margin="0,0,0,4" />

                <!-- 实时裁切取景器预览 -->
                <picControls:CropPreviewControl Name="CropPreview" Height="170" HorizontalAlignment="Stretch" Margin="0 2 0 4" />
                <TextBlock Text="{x:Static locales:Locale.Picture_CropTip}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0 0 0 6" />

                <!-- 水平取景偏移 (CropX, 0–1 显示为百分比) -->
                <controls:Setting Title="{x:Static locales:Locale.Picture_CropX}">
                    <controls:LabeledSlider Name="CropXSlider" Width="200" Minimum="0" Maximum="1" Step="0.01" DisplayFormat="0%"
                                            AutomationProperties.Name="{x:Static locales:Locale.Picture_CropX}" />
                </controls:Setting>

                <!-- 垂直取景偏移 (CropY, 0–1 显示为百分比) -->
                <controls:Setting Title="{x:Static locales:Locale.Picture_CropY}">
                    <controls:LabeledSlider Name="CropYSlider" Width="200" Minimum="0" Maximum="1" Step="0.01" DisplayFormat="0%"
                                            AutomationProperties.Name="{x:Static locales:Locale.Picture_CropY}" />
                </controls:Setting>

                <!-- 画面缩放倍率 (Zoom, 1–3 显示为倍数) -->
                <controls:Setting Title="{x:Static locales:Locale.Picture_Zoom}">
                    <controls:LabeledSlider Name="ZoomSlider" Width="200" Minimum="1" Maximum="3" Step="0.01" DisplayFormat="0.00" Unit="x"
                                            AutomationProperties.Name="{x:Static locales:Locale.Picture_Zoom}" />
                </controls:Setting>

                <!-- 九宫格快捷对齐 -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static locales:Locale.Picture_QuickAlign}" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Margin="0 0 6 0" />
                    <Button Content="↖" Tag="0,0" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="↑" Tag="0.5,0" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="↗" Tag="1,0" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="←" Tag="0,0.5" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="•" Tag="0.5,0.5" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="→" Tag="1,0.5" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="↙" Tag="0,1" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="↓" Tag="0.5,1" Click="OnAlignPresetClicked" Padding="6,3" />
                    <Button Content="↘" Tag="1,1" Click="OnAlignPresetClicked" Padding="6,3" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 轮换与显示设置 -->
        <controls:Setting Title="{x:Static locales:Locale.Picture_Interval}">
            <ComboBox Name="IntervalCombo" MinWidth="180" SelectionChanged="OnSettingChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Picture_Order}">
            <ComboBox Name="OrderCombo" MinWidth="180" SelectionChanged="OnSettingChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Picture_FitMode}">
            <ComboBox Name="FitModeCombo" MinWidth="180" SelectionChanged="OnSettingChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Picture_IsFrameless}">
            <ToggleSwitch Name="FramelessSwitch" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Picture_ShowCaption}">
            <ToggleSwitch Name="CaptionSwitch" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Picture_ClickToNext}">
            <ToggleSwitch Name="ClickToNextSwitch" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Picture_DoubleClickToOpen}">
            <ToggleSwitch Name="DoubleClickToOpenSwitch" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>
    </StackPanel>
</UserControl>
