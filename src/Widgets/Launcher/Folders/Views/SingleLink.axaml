<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:locales="clr-namespace:Folders.Locales"
             mc:Ignorable="d" d:DesignWidth="80" d:DesignHeight="80"
             x:Class="Folders.Views.SingleLink"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Focusable="False"
             ClipToBounds="False">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ContextOpenItem" Header="{x:Static locales:Locale.Folders_SingleLink_OpenLink}" Click="OnOpenLinkContextClick">
                <MenuItem.Icon>
                    <PathIcon Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" Width="14" Height="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="ContextCopyItem" Header="{x:Static locales:Locale.Folders_SingleLink_CopyLink}" Click="OnCopyLinkContextClick">
                <MenuItem.Icon>
                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="14" Height="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static locales:Locale.Folders_SingleLink_Edit}" Click="OnEditContextClick">
                <MenuItem.Icon>
                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Width="14" Height="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border Name="RootBorder" Background="Transparent"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Panel Name="ContainerPanel"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Empty state placeholder (visible when no URL is assigned) -->
            <Border Name="EmptyPlaceholder"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="10"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    Background="#10888888"
                    Padding="6"
                    IsVisible="False"
                    Cursor="Hand">
                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Named: its side is snapped to whole device pixels together with the
                         frame's border/padding, so the glyph is centred without a rounding
                         remainder (see IconPixelSnap). -->
                    <PathIcon Name="PlaceholderGlyph"
                              Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                              Width="22" Height="22"
                              Opacity="0.6"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </Panel>
            </Border>

            <!-- Real Link Icon -->
            <Image Name="IconImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   RenderTransformOrigin="50%,50%">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Image.RenderTransform>
            </Image>

            <!-- Fallback Icon (visible when URL is set but icon is loading or unavailable) -->
            <Border Name="FallbackIconContainer"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="10"
                    Background="#10888888"
                    Padding="6"
                    IsVisible="False"
                    Cursor="Hand">
                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                              Width="24" Height="24"
                              Opacity="0.75"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </Panel>
            </Border>

            <!-- Drop highlight overlay -->
            <Border Name="DropOverlay"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    Background="#25888888"
                    BorderBrush="{DynamicResource SystemAccentColor}"
                    BorderThickness="2"
                    CornerRadius="10"/>
        </Panel>
    </Border>
</UserControl>
