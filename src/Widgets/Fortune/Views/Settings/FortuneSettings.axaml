<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Fortune.Locales"
             x:Class="Fortune.Views.Settings.FortuneSettings"
             controls:SettingsPage.ScrollOwnership="Host">

    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,0,10,0">
        <!-- 1. Pool Theme -->
        <controls:Setting Title="{x:Static locales:Locale.Fortune_PoolType}">
            <ComboBox x:Name="PoolComboBox" MinWidth="200" SelectionChanged="OnSettingChanged">
                <ComboBoxItem Content="{x:Static locales:Locale.Fortune_PoolTraditional}" Tag="0" />
                <ComboBoxItem Content="{x:Static locales:Locale.Fortune_PoolCyberWorker}" Tag="1" />
            </ComboBox>
        </controls:Setting>

        <!-- 2. Free Draw Mode -->
        <controls:Setting Title="{x:Static locales:Locale.Fortune_FreeDrawMode}">
            <ToggleSwitch x:Name="FreeDrawToggle" IsCheckedChanged="OnToggleChanged" OnContent="" OffContent="" />
        </controls:Setting>
    </StackPanel>
</UserControl>
