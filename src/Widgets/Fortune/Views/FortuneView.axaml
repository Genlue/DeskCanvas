<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Fortune.Locales"
             x:Class="Fortune.Views.FortuneView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">

    <UserControl.Styles>
        <!-- Ghost icon button -->
        <Style Selector="Button.ghost-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost-btn > PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.ghost-btn:pointerover">
            <Setter Property="Background" Value="#18808080" />
        </Style>
        <Style Selector="Button.ghost-btn:pointerover > PathIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Primary draw button -->
        <Style Selector="Button.draw-pill">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetPillCornerRadius}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent" PointerPressed="OnCardPointerPressed">

        <!-- ==================== 1x1 Cell ==================== -->
        <Grid x:Name="CellLayout" Margin="6" IsVisible="False">
            <!-- Undrawn -->
            <StackPanel x:Name="CellUndrawnPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="🎋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="{x:Static locales:Locale.Fortune_ShakeDraw}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
            </StackPanel>

            <!-- Drawn -->
            <StackPanel x:Name="CellDrawnPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" IsVisible="False">
                <Border Background="{DynamicResource MacosRedBrush}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center">
                    <TextBlock x:Name="CellGradeText" Text="{x:Static locales:Locale.Fortune_SampleGrade}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </Border>
                <TextBlock x:Name="CellScoreText" Text="{x:Static locales:Locale.Fortune_SampleScoreShort}" FontSize="10" Opacity="0.65" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ==================== 2x2 Small ==================== -->
        <Grid x:Name="SmallLayout" RowDefinitions="Auto,*,Auto" Margin="12,10" IsVisible="True">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Text="{x:Static locales:Locale.Fortune_DailyTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="SmallDateText" Text="{x:Static locales:Locale.Fortune_SampleDate}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <Button Classes="ghost-btn" Click="OnExpandDetailsClicked" ToolTip.Tip="{x:Static locales:Locale.Fortune_TooltipJournal}">
                        <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Undrawn -->
            <StackPanel x:Name="SmallUndrawnPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <Border Width="38" Height="38" CornerRadius="19" Background="#14808080" HorizontalAlignment="Center">
                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1.4c0-2 4-3.1 6-3.1s6 1.1 6 3.1V18z"
                          Fill="{DynamicResource SystemControlHighlightAccentBrush}"
                          Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Static locales:Locale.Fortune_DrawHint}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                <Button Classes="draw-pill" HorizontalAlignment="Center" Click="OnDrawActionClicked">
                    <TextBlock x:Name="SmallDrawButtonText" Text="{x:Static locales:Locale.Fortune_ShakeDraw}"/>
                </Button>
            </StackPanel>

            <!-- Drawn -->
            <Grid x:Name="SmallDrawnPanel" Grid.Row="1" RowDefinitions="Auto,*,Auto" VerticalAlignment="Stretch" Margin="0,2" IsVisible="False">
                <!-- Seal + Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Background="{DynamicResource MacosRedBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="SmallGradeText" Text="{x:Static locales:Locale.Fortune_SampleGrade}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="SmallTitleText" Text="{x:Static locales:Locale.Fortune_SamplePoemName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Poem: centered, never truncated -->
                <TextBlock x:Name="SmallPoemText" Grid.Row="1"
                           Text="{x:Static locales:Locale.Fortune_SamplePoemShort}"
                           FontFamily="KaiTi, STKaiti, SimSun, Georgia, Serif" FontSize="13" LineHeight="20"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,4" Opacity="0.9"/>

                <!-- Merged advice pill -->
                <Border Grid.Row="2" Background="#12808080" CornerRadius="{DynamicResource WidgetPillCornerRadius}"
                        Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SmallAdviceText" Text="{x:Static locales:Locale.Fortune_SampleAdvice}" FontSize="11"
                               Foreground="{DynamicResource WidgetForeground}" FontWeight="Medium"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="2" x:Name="SmallBottomTip" Text="{x:Static locales:Locale.Fortune_DailyTip}" FontSize="10" Opacity="0.45"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"/>
        </Grid>

        <!-- ==================== 4x2 Wide ==================== -->
        <Grid x:Name="WideLayout" ColumnDefinitions="1.1*,1,0.9*" Margin="14,10" IsVisible="False">
            <!-- Left: poem card -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,12,0">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static locales:Locale.Fortune_DailyTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource MacosRedBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="WideGradeText" Text="{x:Static locales:Locale.Fortune_SampleGrade}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="WidePoemText" Grid.Row="1"
                           Text="{x:Static locales:Locale.Fortune_SamplePoemFull}"
                           FontFamily="KaiTi, STKaiti, SimSun, Georgia, Serif" FontSize="13" LineHeight="20"
                           TextAlignment="Center" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,4" Opacity="0.9"/>

                <Grid Grid.Row="2" ColumnDefinitions="*,*">
                    <Border Grid.Column="0" Background="#1A34C759" CornerRadius="{DynamicResource WidgetPillCornerRadius}"
                            Padding="8,3" Margin="0,0,4,0">
                        <TextBlock x:Name="WideSuitableText" Text="{x:Static locales:Locale.Fortune_SampleSuitable}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource MacosGreenBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Column="1" Background="#1AFF3B30" CornerRadius="{DynamicResource WidgetPillCornerRadius}"
                            Padding="8,3" Margin="4,0,0,0">
                        <TextBlock x:Name="WideTabooText" Text="{x:Static locales:Locale.Fortune_SampleTaboo}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource MacosRedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Separator -->
            <Rectangle Grid.Column="1" Fill="#14808080" Width="1" VerticalAlignment="Stretch" Margin="0,4"/>

            <!-- Right: guidance -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="12,0,0,0">
                <TextBlock Grid.Row="0" Text="{x:Static locales:Locale.Fortune_GuidanceTitle}" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="WideExplanationText" Text="{x:Static locales:Locale.Fortune_SampleExplanation}"
                               FontSize="11" Opacity="0.85" TextWrapping="Wrap" LineHeight="16"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static locales:Locale.Fortune_LuckyColor}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                        <Ellipse x:Name="WideColorDot" Width="9" Height="9" Fill="#5698C3" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WideColorText" Text="{x:Static locales:Locale.Fortune_SampleLuckyColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static locales:Locale.Fortune_LuckyItem}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WideThingText" Text="{x:Static locales:Locale.Fortune_SampleLuckyThing}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="2" Classes="ghost-btn" Click="OnExpandDetailsClicked" HorizontalAlignment="Right" Padding="4,2">
                    <TextBlock Text="{x:Static locales:Locale.Fortune_OpenJournal}" FontSize="11" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
