<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        xmlns:models="clr-namespace:Fortune.Models"
        xmlns:locales="clr-namespace:Fortune.Locales"
        x:Class="Fortune.Views.FortunePopupWindow"
        Title="{x:Static locales:Locale.Fortune_Title}"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Width="460"
        Height="560">

    <Window.Styles>
        <Style Selector="Button.action-pill">
            <Setter Property="Background" Value="#1C808080" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.action-pill:pointerover">
            <Setter Property="Background" Value="#32808080" />
        </Style>
        <Style Selector="Button.primary-pill">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Styles>

    <controls:SecondaryPanelShell>
        <controls:SecondaryPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Static locales:Locale.Fortune_PopupHeader}" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Border Background="#20808080" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock x:Name="DateBadge" Text="{x:Static locales:Locale.Fortune_SampleDate}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
            </StackPanel>
        </controls:SecondaryPanelShell.HeaderContent>

        <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
            <!-- Fortune Scroll Card -->
            <Border Grid.Row="0" Background="#16808080" BorderBrush="#22ffffff" BorderThickness="1"
                    CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Top header inside card: Grade Stamp + Title -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border x:Name="GradeStampBorder" Background="#C83C23" CornerRadius="8" Padding="10,4">
                            <TextBlock x:Name="GradeStampText" Text="{x:Static locales:Locale.Fortune_SampleGrade}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock x:Name="PoemTitleText" Text="{x:Static locales:Locale.Fortune_SamplePoemTitle}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FortuneSubText" Text="{x:Static locales:Locale.Fortune_SampleScore}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>

                        <Button Grid.Column="2" Classes="action-pill" Content="{x:Static locales:Locale.Fortune_Copy}" Click="OnCopyClicked"/>
                    </Grid>

                    <!-- Poem Verses -->
                    <Border Background="#10808080" CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="PoemText" Text="{x:Static locales:Locale.Fortune_SamplePoemFull}"
                                   FontFamily="SimSun, KaiTi, Georgia, Serif" FontSize="14" LineHeight="24"
                                   TextAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    </Border>

                    <!-- Explanation -->
                    <TextBlock x:Name="ExplanationText" Text="{x:Static locales:Locale.Fortune_SampleExplanationLong}"
                               FontSize="12" Opacity="0.85" TextWrapping="Wrap" LineHeight="18"/>

                    <!-- Suitable / Taboo Pills -->
                    <Grid ColumnDefinitions="*,*">
                        <Border Grid.Column="0" Background="#163CB371" CornerRadius="8" Padding="8,4" Margin="0,0,4,0">
                            <TextBlock x:Name="SuitableText" Text="{x:Static locales:Locale.Fortune_SampleSuitableLong}" FontSize="11" Foreground="#3CB371" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Border Grid.Column="1" Background="#16E53935" CornerRadius="8" Padding="8,4" Margin="4,0,0,0">
                            <TextBlock x:Name="TabooText" Text="{x:Static locales:Locale.Fortune_SampleTabooLong}" FontSize="11" Foreground="#E53935" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <!-- Lucky Details -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static locales:Locale.Fortune_LuckyColorLabel}" FontSize="11" Opacity="0.7"/>
                            <Ellipse x:Name="LuckyColorDot" Width="10" Height="10" Fill="#5698C3" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LuckyColorText" Text="{x:Static locales:Locale.Fortune_SampleLuckyColor}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static locales:Locale.Fortune_LuckyNumberLabel}" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="LuckyNumberText" Text="8" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Static locales:Locale.Fortune_LuckyThingLabel}" FontSize="11" Opacity="0.7"/>
                            <TextBlock x:Name="LuckyThingText" Text="{x:Static locales:Locale.Fortune_SampleLuckyThing}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <Button Classes="primary-pill" HorizontalAlignment="Left" Click="OnFreeDrawClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✨" FontSize="12"/>
                        <TextBlock x:Name="FreeDrawButtonText" Text="{x:Static locales:Locale.Fortune_FreeDrawButton}"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{x:Static locales:Locale.Fortune_ResetNote}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
            </Grid>

            <!-- History Section -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{x:Static locales:Locale.Fortune_HistoryHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" Opacity="0.9"/>

                <ListBox x:Name="HistoryListBox" Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DailyFortuneRecord">
                            <Border Background="#10808080" BorderBrush="#14ffffff" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Text="{Binding Date}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#C83C23" CornerRadius="4" Padding="6,1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Fortune.GradeText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Fortune.PoemTitle}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Fortune.Score, StringFormat='运气值: {0}'}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </controls:SecondaryPanelShell>
</Window>
