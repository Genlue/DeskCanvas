<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Folders.Locales"
             x:Class="Folders.Views.Settings.SingleFileSettings"
             controls:SettingsPage.ScrollOwnership="Host">
    <!-- W9: the outer ScrollViewer is gone (the EditWidget viewport is the single scroll owner),
         the group headers are the shared dc-section-header, the label/number rows became Setting
         rows, the "icon size" slider+value pair is the shared LabeledSlider and the pick/clear
         buttons use the shared toolbar/icon button families. Business kept: the file-or-folder
         target picker and the icon-percent semantics. -->
    <StackPanel Orientation="Vertical" Spacing="6" Margin="{DynamicResource SettingsPagePadding}">

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Folders_Group_Content}" />

        <!-- Path Display and Selection -->
        <controls:Setting Title="{x:Static locales:Locale.Folders_SingleFile_Target}" EditorHorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox x:Name="PathBox" Grid.Column="0" FontSize="12"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         PlaceholderText="{x:Static locales:Locale.Folders_SingleFile_EmptyHint}" />
                <Button Grid.Column="1" Classes="dc-toolbar-button" Margin="6,0,0,0"
                        Content="{x:Static locales:Locale.Folders_PickFile}" Click="OnPickFile" />
                <Button Grid.Column="2" Classes="dc-toolbar-button" Margin="4,0,0,0"
                        Content="{x:Static locales:Locale.Folders_PickFolder}" Click="OnPickFolder" />
                <Button Grid.Column="3" Classes="dc-icon-button compact" Margin="4,0,0,0"
                        Content="✕" Click="OnClearPath"
                        ToolTip.Tip="{x:Static locales:Locale.Folders_Clear}"
                        AutomationProperties.Name="{x:Static locales:Locale.Folders_Clear}" />
            </Grid>
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Folders_Group_Appearance}" />

        <!-- Icon Size Percentage Slider -->
        <controls:Setting Title="{x:Static locales:Locale.Folders_SingleFile_IconPercent}">
            <controls:LabeledSlider x:Name="IconPercentSlider" Width="200" Minimum="20" Maximum="100" Step="1" Unit="%"
                                    ValueCommitted="OnIconPercentCommitted"
                                    AutomationProperties.Name="{x:Static locales:Locale.Folders_SingleFile_IconPercent}" />
        </controls:Setting>

        <!-- Hover zoom: the drawn icon size is capped so the zoomed icon still fits the card. -->
        <controls:Setting Title="{x:Static locales:Locale.Folders_HoverZoom}"
                          Subtitle="{x:Static locales:Locale.Folders_HoverZoom_Subtitle}">
            <controls:LabeledSlider x:Name="HoverZoomSlider" Width="200" Minimum="100" Maximum="150" Step="5" Unit="%"
                                    ValueCommitted="OnHoverZoomCommitted"
                                    AutomationProperties.Name="{x:Static locales:Locale.Folders_HoverZoom}" />
        </controls:Setting>

        <TextBlock Text="{x:Static locales:Locale.Folders_Help}"
                   FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <!-- 图标可以铺满整张卡片，那时右键点到的是图标本身；组件菜单改由 Ctrl + 右键唤出。
             提示必须写在用户会来看的地方（设置页），不能只留在代码注释里。 -->
        <TextBlock Text="{x:Static locales:Locale.Folders_ContextMenu_Hint}"
                   FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>
</UserControl>
