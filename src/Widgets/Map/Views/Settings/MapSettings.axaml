<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Map.Locales"
             xmlns:viewModels="clr-namespace:Map.ViewModels.Settings"
             x:Class="Map.Views.Settings.MapSettings"
             x:DataType="viewModels:MapSettingsViewModel"
             controls:SettingsPage.ScrollOwnership="Host">

    <!-- 滚动契约：Host —— 页面不再自带外层 ScrollViewer，唯一竖向滚动所有者是宿主 EditWidget
         的内容视口。下拉项（城市/图源）与定位状态文本是 ViewModel 业务数据，不在本页文案资源化范围。 -->

    <StackPanel Orientation="Vertical" Spacing="6" Margin="0 0 10 0">

        <!-- 图源选择 -->
        <controls:Setting x:Name="ProviderSetting" Title="{x:Static locales:Locale.Map_Provider}" Subtitle="{x:Static locales:Locale.Map_Provider_Subtitle}">
            <ComboBox MinWidth="220"
                      ItemsSource="{Binding Providers}"
                      SelectedItem="{Binding SelectedProviderOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ProviderOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>

        <!-- 预设城市 -->
        <controls:Setting x:Name="PresetSetting" Title="{x:Static locales:Locale.Map_PresetSetting}" Subtitle="{x:Static locales:Locale.Map_PresetSetting_Subtitle}">
            <ComboBox MinWidth="220"
                      ItemsSource="{Binding Cities}"
                      SelectedItem="{Binding SelectedCity}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PresetCity">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>

        <!-- 网络自动定位 -->
        <controls:Setting x:Name="AutoLocateSetting" Title="{x:Static locales:Locale.Map_AutoLocate}" Subtitle="{x:Static locales:Locale.Map_AutoLocate_Subtitle}">
            <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button x:Name="LocateNowBtn" Content="{x:Static locales:Locale.Map_LocateNow}" Click="OnLocateNowClick" Padding="12,5" />
                    <ToggleSwitch x:Name="AutoLocateToggle" IsChecked="{Binding AutoLocate}"
                                  OnContent="{x:Static locales:Locale.Map_AutoLocateOn}"
                                  OffContent="{x:Static locales:Locale.Map_AutoLocateOff}" />
                </StackPanel>
                <TextBlock Text="{Binding LocationStatusText}"
                           IsVisible="{Binding LocationStatusText.Length}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemAccentColor}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </controls:Setting>

        <!-- 地点名称与描述 -->
        <controls:Setting x:Name="LocationNameSetting" Title="{x:Static locales:Locale.Map_LocationNameSetting}" Subtitle="{x:Static locales:Locale.Map_LocationNameSetting_Subtitle}">
            <TextBox MinWidth="220" Text="{Binding LocationName}" />
        </controls:Setting>

        <controls:Setting x:Name="LocationDescSetting" Title="{x:Static locales:Locale.Map_LocationDescription}" Subtitle="{x:Static locales:Locale.Map_LocationDesc_Subtitle}">
            <TextBox MinWidth="220" Text="{Binding LocationDescription}" />
        </controls:Setting>

        <!-- 经纬度输入 -->
        <controls:Setting x:Name="LatitudeSetting" Title="{x:Static locales:Locale.Map_LatitudeSetting}" Subtitle="{x:Static locales:Locale.Map_LatitudeSetting_Subtitle}">
            <NumericUpDown MinWidth="140"
                           Minimum="-85.0" Maximum="85.0"
                           Increment="0.005"
                           FormatString="F4"
                           Value="{Binding Latitude}" />
        </controls:Setting>

        <controls:Setting x:Name="LongitudeSetting" Title="{x:Static locales:Locale.Map_LongitudeSetting}" Subtitle="{x:Static locales:Locale.Map_LongitudeSetting_Subtitle}">
            <NumericUpDown MinWidth="140"
                           Minimum="-180.0" Maximum="180.0"
                           Increment="0.005"
                           FormatString="F4"
                           Value="{Binding Longitude}" />
        </controls:Setting>

        <!-- 缩放级别：共享 LabeledSlider，DisplayFormat="'Z'0" 复现原 Z{级别} 文本；
             Zoom 模型本就是 int（MapModel 3~18 夹取），整数吸附与业务一致 -->
        <controls:Setting x:Name="ZoomSetting" Title="{x:Static locales:Locale.Map_ZoomSetting}" Subtitle="{x:Static locales:Locale.Map_ZoomSetting_Subtitle}">
            <controls:LabeledSlider Width="220" Minimum="3" Maximum="18" Step="1"
                                    DisplayFormat="'Z'0"
                                    Value="{Binding Zoom}"
                                    AutomationProperties.Name="{x:Static locales:Locale.Map_ZoomSetting}" />
        </controls:Setting>

        <!-- 交互开关 -->
        <controls:Setting x:Name="AllowDragSetting" Title="{x:Static locales:Locale.Map_AllowDragSetting}" Subtitle="{x:Static locales:Locale.Map_AllowDragSetting_Subtitle}">
            <ToggleSwitch IsChecked="{Binding AllowMapDrag}" OnContent="" OffContent="" />
        </controls:Setting>

        <controls:Setting x:Name="ShowPinSetting" Title="{x:Static locales:Locale.Map_ShowPinSetting}" Subtitle="{x:Static locales:Locale.Map_ShowPinSetting_Subtitle}">
            <ToggleSwitch IsChecked="{Binding ShowPin}" OnContent="" OffContent="" />
        </controls:Setting>

        <controls:Setting x:Name="ShowInfoPillSetting" Title="{x:Static locales:Locale.Map_ShowInfoPillSetting}" Subtitle="{x:Static locales:Locale.Map_ShowInfoPillSetting_Subtitle}">
            <ToggleSwitch IsChecked="{Binding ShowInfoPill}" OnContent="" OffContent="" />
        </controls:Setting>

        <controls:Setting x:Name="ShowControlsSetting" Title="{x:Static locales:Locale.Map_ShowControlsSetting}" Subtitle="{x:Static locales:Locale.Map_ShowControlsSetting_Subtitle}">
            <ToggleSwitch IsChecked="{Binding ShowControls}" OnContent="" OffContent="" />
        </controls:Setting>

        <controls:Setting x:Name="ShowScaleBarSetting" Title="{x:Static locales:Locale.Map_ShowScaleBarSetting}" Subtitle="{x:Static locales:Locale.Map_ShowScaleBarSetting_Subtitle}">
            <ToggleSwitch IsChecked="{Binding ShowScaleBar}" OnContent="" OffContent="" />
        </controls:Setting>

        <!-- 百度地图 AK -->
        <controls:Setting x:Name="BaiduKeySetting" Title="{x:Static locales:Locale.Map_BaiduKey}" Subtitle="{x:Static locales:Locale.Map_BaiduKey_Subtitle}">
            <TextBox x:Name="BaiduKeyBox" MinWidth="220" Text="{Binding BaiduApiKey}"
                     Watermark="{x:Static locales:Locale.Map_BaiduKeyWatermark}" />
        </controls:Setting>

    </StackPanel>
</UserControl>
