<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Countdown.Locales"
             x:Class="Countdown.Views.Settings.CountdownSettings"
             controls:SettingsPage.ScrollOwnership="Host">

    <StackPanel Orientation="Vertical" Spacing="5" Margin="0,0,10,0">
        <!-- 1. Card Style -->
        <controls:Setting Title="{x:Static locales:Locale.Countdown_Style}"
                          Subtitle="{x:Static locales:Locale.Countdown_Style_Subtitle}">
            <ComboBox x:Name="StyleComboBox" MinWidth="180" SelectionChanged="OnStyleSelectionChanged">
                <ComboBoxItem Content="{x:Static locales:Locale.Countdown_Style_MinimalNumber}" Tag="MinimalNumber" />
                <ComboBoxItem Content="{x:Static locales:Locale.Countdown_Style_RingProgress}" Tag="RingProgress" />
                <ComboBoxItem Content="{x:Static locales:Locale.Countdown_Style_EventList}" Tag="EventList" />
            </ComboBox>
        </controls:Setting>

        <!-- 2. Time Granularity -->
        <controls:Setting Title="{x:Static locales:Locale.Countdown_Granularity}">
            <ComboBox x:Name="GranularityComboBox" MinWidth="180" SelectionChanged="OnGranularitySelectionChanged">
                <ComboBoxItem Content="{x:Static locales:Locale.Countdown_Granularity_DaysOnly}" Tag="DaysOnly" />
                <ComboBoxItem Content="{x:Static locales:Locale.Countdown_Granularity_Auto24Hours}" Tag="Auto24Hours" />
                <ComboBoxItem Content="{x:Static locales:Locale.Countdown_Granularity_AlwaysDetailed}" Tag="AlwaysDetailed" />
            </ComboBox>
        </controls:Setting>

        <!-- 3. Target Event Binding -->
        <controls:Setting Title="{x:Static locales:Locale.Countdown_TargetEvent}">
            <ComboBox x:Name="EventComboBox" MinWidth="180" SelectionChanged="OnEventSelectionChanged" />
        </controls:Setting>
    </StackPanel>
</UserControl>
