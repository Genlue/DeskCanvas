<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:StackWidgets.Locales"
             xmlns:models="clr-namespace:StackWidgets.Models"
             x:Class="StackWidgets.Views.Settings.WidgetStackSettings">

    <ScrollViewer Margin="0,4">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="10,0">

            <!-- Desktop widget drag-and-drop landing area -->
            <Border Name="DropZoneBorder"
                    Background="#140078D4"
                    BorderBrush="#350078D4"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,2,0,4">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <PathIcon Grid.Column="0" Data="{DynamicResource Appearance}" Width="24" Height="24" Margin="0,0,12,0" Foreground="{DynamicResource SystemAccentColor}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="📥 拖入桌面小组件" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="直接在桌面上拖拽任意小组件并松开在此窗口中，即可将其收纳进重叠卡片" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Enable wheel switching toggle -->
            <controls:Setting Title="{x:Static locales:Locale.Setting_Allow_Wheel}">
                <ToggleSwitch Name="AllowWheelSwitch" IsCheckedChanged="OnToggleChanged" />
            </controls:Setting>

            <!-- Wheel switching only at the indicator dots (keeps the wheel for the stacked child's own scrolling) -->
            <controls:Setting Title="{x:Static locales:Locale.Setting_Wheel_Only_On_Dots}">
                <ToggleSwitch Name="WheelOnlyOnDotsSwitch" IsCheckedChanged="OnToggleChanged" />
            </controls:Setting>

            <!-- Hide the pagination dots while idle; they only show while switching or hovering -->
            <controls:Setting Title="{x:Static locales:Locale.Setting_Auto_Hide_Dots}">
                <ToggleSwitch Name="AutoHideDotsSwitch" IsCheckedChanged="OnToggleChanged" />
            </controls:Setting>

            <!-- Add new widget to stack -->
            <controls:Setting Title="{x:Static locales:Locale.Setting_Add_Widget}">
                <Grid ColumnDefinitions="*,Auto" Width="260">
                    <ComboBox Name="AvailableWidgetsCombo" Grid.Column="0" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="{x:Static locales:Locale.Setting_Add_Widget}" Click="OnAddWidgetClicked" />
                </Grid>
            </controls:Setting>

            <!-- Current Stacked Widgets List -->
            <TextBlock Text="已叠放的小组件列表（支持单独设置、排序与移回桌面）" FontWeight="SemiBold" FontSize="13" Margin="4,6,0,2" />
            <Border Background="#10808080" CornerRadius="8" Padding="6">
                <StackPanel Orientation="Vertical">
                    <TextBlock Name="EmptyHintText"
                               Text="当前暂无已叠放组件（桌面呈现为空白卡片）。&#x0a;请在桌面上直接拖动小组件至此窗口上方区域，或在下方选择添加。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="10,16"
                               HorizontalAlignment="Center" TextAlignment="Center" IsVisible="False" />
                    <ItemsControl Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StackedWidgetSettingItem">
                                <Border Margin="0,2" Padding="8,6" Background="#15808080" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="↖ 移至桌面" Margin="2,0" Padding="6,2" ToolTip.Tip="将此组件从重叠中移出并还原放回桌面" Click="OnExtractToDesktopClicked" Tag="{Binding}" />
                                        <Button Grid.Column="2" Content="⚙ 设置" Margin="2,0" Padding="6,2" ToolTip.Tip="配置此组件" Click="OnEditChildClicked" Tag="{Binding}" IsVisible="{Binding HasSettings}" />
                                        <Button Grid.Column="3" Content="↑" Margin="2,0" Padding="6,2" ToolTip.Tip="{x:Static locales:Locale.Setting_Move_Up}" Click="OnMoveUpClicked" Tag="{Binding}" />
                                        <Button Grid.Column="4" Content="↓" Margin="2,0" Padding="6,2" ToolTip.Tip="{x:Static locales:Locale.Setting_Move_Down}" Click="OnMoveDownClicked" Tag="{Binding}" />
                                        <Button Grid.Column="5" Content="✕" Margin="2,0" Padding="6,2" ToolTip.Tip="{x:Static locales:Locale.Setting_Remove_Widget}" Click="OnRemoveClicked" Tag="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
