<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:ControlCenter.Locales"
             x:Class="ControlCenter.Views.Settings.ControlCenterSettings"
             controls:SettingsPage.ScrollOwnership="Host">
    <!-- W9: the outer ScrollViewer is gone (the EditWidget viewport is the single scroll owner),
         the page texts come from the plugin Locale and the magic grey surfaces are the shared
         interaction tokens. Business kept as-is: the tier switcher, the interactive bento
         composer board (drag / resize / dock pool) and the wheel-step selector.
         tier-tab stays a page-specific segmented-tab style (the .active state is business),
         but its colours resolve through the shared semantic brushes. -->
    <UserControl.Styles>
        <Style Selector="Button.tier-tab">
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.tier-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.tier-tab.active">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical" Spacing="6" Margin="{DynamicResource SettingsPagePadding}">

        <!-- 1. Canvas Size Tier Switcher & Presets -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                <Button x:Name="Tab2x2Btn" Classes="tier-tab" Content="{x:Static locales:Locale.ControlCenter_Tier2x2}" Click="OnTier2x2Clicked" />
                <Button x:Name="Tab4x2Btn" Classes="tier-tab" Content="{x:Static locales:Locale.ControlCenter_Tier4x2}" Click="OnTier4x2Clicked" />
                <Button x:Name="Tab4x4Btn" Classes="tier-tab" Content="{x:Static locales:Locale.ControlCenter_Tier4x4}" Click="OnTier4x4Clicked" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PresetVerticalBtn"
                        Classes="dc-toolbar-button"
                        Content="{x:Static locales:Locale.ControlCenter_PresetVertical}"
                        Click="OnPresetVerticalClicked"
                        ToolTip.Tip="{x:Static locales:Locale.ControlCenter_PresetVertical_Tip}" />
                <Button x:Name="ResetDefaultBtn"
                        Classes="dc-toolbar-button"
                        Content="{x:Static locales:Locale.ControlCenter_ResetDefault}"
                        Click="OnResetDefaultClicked" />
            </StackPanel>
        </Grid>

        <!-- 2. Interactive Bento Grid Composer Board (business region) -->
        <Border Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource HostSurfaceCornerRadius}"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ComposerHintText"
                           Text="{x:Static locales:Locale.ControlCenter_ComposerHint}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- Centered Canvas Host -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="6">
                    <Canvas x:Name="ComposerCanvas"
                            Width="360"
                            Height="180"
                            Background="Transparent"
                            PointerMoved="OnCanvasPointerMoved"
                            PointerReleased="OnCanvasPointerReleased" />
                </Border>

                <!-- Selected Tile Span / Orientation Toolbar -->
                <Border x:Name="SelectionToolbar"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="8,5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="SelectedTileLabel"
                                   Grid.Column="0"
                                   Text="{x:Static locales:Locale.ControlCenter_SelectionNone}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <StackPanel x:Name="SpanButtonsPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    IsEnabled="False">
                            <Button x:Name="Span1x1Btn" Classes="dc-toolbar-button" Content="{x:Static locales:Locale.ControlCenter_Span1x1}" Click="OnSpanButtonClicked" Tag="1x1" />
                            <Button x:Name="Span2x1Btn" Classes="dc-toolbar-button" Content="{x:Static locales:Locale.ControlCenter_Span2x1}" Click="OnSpanButtonClicked" Tag="2x1" />
                            <Button x:Name="Span1x2Btn" Classes="dc-toolbar-button" Content="{x:Static locales:Locale.ControlCenter_Span1x2}" Click="OnSpanButtonClicked" Tag="1x2" />
                            <Button x:Name="Span2x2Btn" Classes="dc-toolbar-button" Content="{x:Static locales:Locale.ControlCenter_Span2x2}" Click="OnSpanButtonClicked" Tag="2x2" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. Available Control Items Pool (Click or Drag into Grid, business region) -->
        <Border Background="{DynamicResource SubtleSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="10,8">
            <StackPanel Spacing="6">
                <TextBlock x:Name="DockHeaderText"
                           Classes="dc-section-header"
                           Text="{x:Static locales:Locale.ControlCenter_DockHeader}" />
                <WrapPanel x:Name="DockWrapPanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <!-- 4. Wheel Step Configuration -->
        <controls:Setting Title="{x:Static locales:Locale.ControlCenter_WheelStepTitle}"
                          Subtitle="{x:Static locales:Locale.ControlCenter_WheelStepSubtitle}">
            <ComboBox x:Name="WheelStepCombo"
                      MinWidth="90"
                      VerticalAlignment="Center"
                      SelectionChanged="OnWheelStepChanged">
                <ComboBoxItem Content="1%" Tag="1" />
                <ComboBoxItem Content="2%" Tag="2" />
                <ComboBoxItem Content="5%" Tag="5" />
                <ComboBoxItem Content="10%" Tag="10" />
            </ComboBox>
        </controls:Setting>

    </StackPanel>
</UserControl>
