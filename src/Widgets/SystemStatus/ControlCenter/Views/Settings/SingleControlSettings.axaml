<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:ControlCenter.Locales"
             x:Class="ControlCenter.Views.Settings.SingleControlSettings"
             controls:SettingsPage.ScrollOwnership="Host">
    <!-- W9: the outer ScrollViewer is gone (the EditWidget viewport is the single scroll owner),
         the header is the shared dc-section-header and the wheel-step row is a Setting row.
         Business kept: the tile-binding card grid is built in code-behind. -->
    <StackPanel Orientation="Vertical" Spacing="6" Margin="{DynamicResource SettingsPagePadding}">
        <TextBlock x:Name="HeaderLabel"
                   Classes="dc-section-header"
                   Text="{x:Static locales:Locale.SingleControl_BindHeader}" />

        <UniformGrid x:Name="ItemsGrid" Columns="2" />

        <controls:Setting Title="{x:Static locales:Locale.ControlCenter_WheelStepTitle}"
                          Subtitle="{x:Static locales:Locale.SingleControl_WheelStepSubtitle}">
            <ComboBox x:Name="WheelStepCombo"
                      MinWidth="90"
                      VerticalAlignment="Center"
                      SelectionChanged="OnWheelStepChanged">
                <ComboBoxItem Content="1%" Tag="1" />
                <ComboBoxItem Content="2%" Tag="2" />
                <ComboBoxItem Content="5%" Tag="5" />
                <ComboBoxItem Content="10%" Tag="10" />
            </ComboBox>
        </controls:Setting>
    </StackPanel>
</UserControl>
