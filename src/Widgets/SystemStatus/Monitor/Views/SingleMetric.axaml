<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Monitor.Views.Controls"
             xmlns:viewModels="clr-namespace:Monitor.ViewModels"
             x:Class="Monitor.Views.SingleMetric"
             x:DataType="viewModels:SingleMetricViewModel">
    <Grid>
        <!-- Stacked (square / portrait) layout: gauge on top, percentage below. -->
        <Grid x:Name="Stacked" RowDefinitions="*,*">
            <controls:Metric x:Name="Ring" VerticalAlignment="Top" HorizontalAlignment="Left" 
                             DataContext="{Binding Metric}" />
            <Viewbox Grid.Row="1" Name="Text" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <TextBlock  FontSize="44" Text="{Binding Metric.Text}" />
            </Viewbox>
        </Grid>
        <!-- Landscape (2×1, 3×2, …) layout: fixed-proportion canvas scaled to the
             card. Flatter than square (≈3.3:1) so a 2×1 tier spends its width on
             the big percentage instead of shrinking everything to the card height. -->
        <Viewbox x:Name="Landscape" Stretch="Uniform" StretchDirection="Both" IsVisible="False">
            <Grid Width="264" Height="80">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Metric x:Name="LandscapeRing" Grid.Column="0" VerticalAlignment="Center" DataContext="{Binding Metric}" />
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="8,0,0,0">
                    <TextBlock FontSize="44" TextAlignment="Right" Text="{Binding Metric.Text}" />
                </Viewbox>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
