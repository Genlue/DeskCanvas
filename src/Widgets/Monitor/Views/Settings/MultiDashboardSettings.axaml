<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Monitor.Locales"
             xmlns:viewModels="clr-namespace:Monitor.ViewModels"
             x:DataType="viewModels:MultiDashboardSettingsViewModel"
             x:Class="Monitor.Views.Settings.MultiDashboardSettings">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="5">
            <controls:Setting Title="{x:Static locales:Locale.Monitor_MultiDashboard_Item1}">
                <ComboBox ItemsSource="{Binding AllTypes}" MinWidth="130"
                          SelectedItem="{Binding Item0}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:MetricTypeViewModel">
                            <TextBlock Text="{Binding Title}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Monitor_MultiDashboard_Item2}">
                <ComboBox ItemsSource="{Binding AllTypes}" MinWidth="130"
                          SelectedItem="{Binding Item1}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:MetricTypeViewModel">
                            <TextBlock Text="{Binding Title}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Monitor_MultiDashboard_Item3}">
                <ComboBox ItemsSource="{Binding AllTypes}" MinWidth="130"
                          SelectedItem="{Binding Item2}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:MetricTypeViewModel">
                            <TextBlock Text="{Binding Title}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Monitor_MultiDashboard_Item4}">
                <ComboBox ItemsSource="{Binding AllTypes}" MinWidth="130"
                          SelectedItem="{Binding Item3}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:MetricTypeViewModel">
                            <TextBlock Text="{Binding Title}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>
        </StackPanel>
    </ScrollViewer>
</UserControl>
