<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Clock.Views.Controls"
             xmlns:viewModels="clr-namespace:Clock.ViewModels"
             x:Class="Clock.Views.FlipClock"
             x:DataType="viewModels:FlipClockViewModel">

    <Viewbox Stretch="Uniform">
        <Grid Width="328"
              Height="136"
              RowDefinitions="Auto,*,Auto">

            <!-- Optional Top Date & Mode Bar -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding ShowTopBar}"
                  ColumnDefinitions="*,Auto"
                  Margin="2,0,2,5">
                <TextBlock Grid.Column="0"
                           Text="{Binding DateBarText}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           Opacity="0.78"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding BarRightText}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Split-Flap Cards Row -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="{Binding CardSpacing}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <controls:FlipCard Margin="0"
                                   Value="{Binding HourText}"
                                   CardWidth="{Binding CardWidth}"
                                   CardHeight="{Binding CardHeight}"
                                   DigitFontSize="{Binding DigitFontSize}"
                                   FlapCornerRadius="{Binding FlapCornerRadius}"
                                   BadgeFontSize="{Binding BadgeFontSize}"
                                   TopLeftBadge="{Binding HourTopLeftBadge}" />

                <controls:FlipCard Margin="0"
                                   Value="{Binding MinuteText}"
                                   CardWidth="{Binding CardWidth}"
                                   CardHeight="{Binding CardHeight}"
                                   DigitFontSize="{Binding DigitFontSize}"
                                   FlapCornerRadius="{Binding FlapCornerRadius}"
                                   BadgeFontSize="{Binding BadgeFontSize}"
                                   TopRightBadge="{Binding MinuteTopRightBadge}"
                                   BottomRightBadge="{Binding MinuteBottomRightBadge}" />

                <controls:FlipCard Margin="0"
                                   Value="{Binding SecondText}"
                                   IsVisible="{Binding ShowThirdFlipCard}"
                                   CardWidth="{Binding CardWidth}"
                                   CardHeight="{Binding CardHeight}"
                                   DigitFontSize="{Binding DigitFontSize}"
                                   FlapCornerRadius="{Binding FlapCornerRadius}"
                                   BadgeFontSize="{Binding BadgeFontSize}"
                                   TopRightBadge="{Binding SecondTopRightBadge}" />
            </StackPanel>

            <!-- Optional Bottom Date & Mode Bar -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding ShowBottomBar}"
                  ColumnDefinitions="*,Auto"
                  Margin="2,5,2,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding DateBarText}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           Opacity="0.78"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding BarRightText}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
