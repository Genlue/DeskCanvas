<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Clock.Views.Controls"
             xmlns:viewModels="clr-namespace:Clock.ViewModels"
             x:Class="Clock.Views.AnalogIV"
             x:DataType="viewModels:TickDialClockViewModel"
             Margin="6">

    <UserControl.Styles>
        <Style Selector="TextBlock.ClockText">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Viewbox Stretch="Uniform">
        <Grid Width="1000" Height="1000">
            <!-- 60 格外圈动态刻度环 -->
            <controls:TickRingControl CurrentSecond="{Binding CurrentSecond}"
                                      ShowSeconds="{Binding ShowSeconds}"
                                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                      Width="1000" Height="1000" />

            <!-- 中部垂直信息流：日期星期、时间、农历 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <!-- 顶部：公历月日 + 星期 -->
                <TextBlock Name="DateBlock"
                           Classes="ClockText"
                           Text="{Binding DateText}"
                           FontSize="58"
                           FontWeight="SemiBold"
                           Opacity="0.85" />

                <!-- 中部：大字号圆角时间 -->
                <TextBlock Name="TimeBlock"
                           Classes="ClockText"
                           Text="{Binding TimeText}"
                           FontSize="230"
                           FontWeight="Bold"
                           Margin="0,-25,0,-15" />

                <!-- 底部：农历 -->
                <TextBlock Name="LunarBlock"
                           Classes="ClockText"
                           Text="{Binding LunarText}"
                           FontSize="56"
                           FontWeight="Normal"
                           LetterSpacing="4"
                           Opacity="0.75" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
