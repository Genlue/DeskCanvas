<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Clock.Locales"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:Clock.ViewModels"
             x:Class="Clock.Views.Settings.FramelessClockSettings"
             x:DataType="viewModels:FramelessClockSettingsViewModel">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="6" Margin="0 0 10 0">
            <!-- 基础时间设置 -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_Use24Hours}">
                <ToggleSwitch IsChecked="{Binding Use24Hours}"/>
            </controls:Setting>
            <controls:Setting Title="{x:Static locales:Locale.Clock_ShowSeconds}">
                <ToggleSwitch IsChecked="{Binding ShowSeconds}"/>
            </controls:Setting>

            <!-- 字体选择（精选手机锁屏艺术大字 + 全部系统字体） -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_FontFamily}">
                <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedFontOption}" Width="210">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ClockFontOption">
                            <StackPanel Orientation="Vertical" Margin="0 3">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text="{Binding Description}" FontSize="10.5" Opacity="0.65"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>

            <!-- 字体粗细: a continuous slider with no numbers. A discrete weight picker was
                 meaningless for the curated fonts (each ships a single face, so every step resolved
                 to the same one); the widget now maps the slider's travel onto the family's real
                 range and synthesises the rest, so this always reads 最细 → 最粗. -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_FontWeight}">
                <Grid ColumnDefinitions="Auto,200,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{x:Static locales:Locale.Clock_FontWeight_Thin}"
                               FontSize="11" Opacity="0.7" Margin="0 0 8 0" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="100" Maximum="900" TickFrequency="1"
                            IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center"
                            Value="{Binding FontWeightSlider}"
                            AutomationProperties.Name="{x:Static locales:Locale.Clock_FontWeight}" />
                    <TextBlock Grid.Column="2" Text="{x:Static locales:Locale.Clock_FontWeight_Thick}"
                               FontSize="11" Opacity="0.7" Margin="8 0 0 0" VerticalAlignment="Center" />
                </Grid>
            </controls:Setting>

            <!-- 拉伸模式 -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_StretchFill}"
                              Subtitle="{x:Static locales:Locale.Clock_StretchFill_Subtitle}">
                <ToggleSwitch IsChecked="{Binding StretchFill}"/>
            </controls:Setting>

            <!-- 覆盖颜色遮罩 -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_EnableOverlay}"
                              Subtitle="{x:Static locales:Locale.Clock_EnableOverlay_Subtitle}">
                <ToggleSwitch IsChecked="{Binding EnableOverlay}"/>
            </controls:Setting>

            <StackPanel IsVisible="{Binding ShowOverlayOptions}" Spacing="6">
                <controls:Setting Title="{x:Static locales:Locale.Clock_FollowAccentColor}">
                    <ToggleSwitch IsChecked="{Binding FollowAccentColor}"/>
                </controls:Setting>

                <controls:Setting IsVisible="{Binding ShowCustomColor}" Title="{x:Static locales:Locale.Clock_OverlayColor}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ColorPicker Color="{Binding OverlayColorPickerValue}" Height="36" Width="72" IsAlphaVisible="False" />
                        <TextBox Text="{Binding OverlayColor}" MinWidth="120" Watermark="#400078D4" VerticalAlignment="Center"/>
                    </StackPanel>
                </controls:Setting>

                <controls:Setting Title="{x:Static locales:Locale.Clock_OverlayOpacity}">
                    <Grid ColumnDefinitions="*,Auto" Width="180">
                        <Slider Minimum="5" Maximum="100" Value="{Binding OverlayOpacityPercent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding OverlayOpacityPercent, StringFormat='{}{0}%'}" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="8 0 0 0"/>
                    </Grid>
                </controls:Setting>
            </StackPanel>

            <!-- 时区设置 -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_LocalTimeZone}">
                <ToggleSwitch IsChecked="{Binding UseLocalTimeZone}"/>
            </controls:Setting>
            <controls:Setting IsVisible="{Binding ShowTimeZones}" Title="{x:Static locales:Locale.Clock_TimeZone}">
                <ComboBox ItemsSource="{Binding TimeZones}" Width="160" SelectedItem="{Binding TimeZone}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="system:TimeZoneInfo">
                            <TextBlock Text="{Binding DisplayName}" Margin="0 4"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>
        </StackPanel>
    </ScrollViewer>
</UserControl>
