<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputPath>..\..\DeskCanvas\bin\$(Configuration)\$(TargetFramework)\Widgets</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <!-- AVLN3001 is benign here: the flagged views are created from code / DataTemplates,
             never through the runtime XAML loader. -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <UpToDateCheckInput Update="Clock.axaml">
        <DependentUpon>Clock.axaml</DependentUpon>
      </UpToDateCheckInput>
      <UpToDateCheckInput Remove="Controls\ClockHand.axaml" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\DeskCanvas\DeskCanvas.csproj">
        <Private>false</Private>
          <ExcludeAssets>runtime</ExcludeAssets>
      </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DeskCanvas.Core\DeskCanvas.Core.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\AnalogI.axaml.cs">
        <DependentUpon>AnalogI.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Locales\Locale.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Locale.resx</DependentUpon>
        <Generator>PublicResXFileCodeGenerator</Generator>
      </Compile>
      <Compile Update="Views\Controls\AnalogWorldSingle.axaml.cs">
        <DependentUpon>AnalogWorldSingle.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Views\Controls\ClockHand.axaml" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Locales\Locale.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Locale.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" PrivateAssets="all" ExcludeAssets="runtime">
        <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Avalonia.ReactiveUI" PrivateAssets="all" ExcludeAssets="runtime">
        <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <!-- ColorPicker types compile against the app's copy (loaded by the app at runtime). -->
      <PackageReference Include="Avalonia.Controls.ColorPicker" PrivateAssets="all" ExcludeAssets="runtime">
        <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="TimeZoneNames" />
    </ItemGroup>
</Project>
