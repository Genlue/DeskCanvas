<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Tools.Locales"
             x:Class="Tools.Views.Settings.CalculatorSettings"
             controls:SettingsPage.ScrollOwnership="Host">
    <!-- Scroll ownership: Host — no outer ScrollViewer of its own; the EditWidget content
         viewport is the single vertical scroll owner. All rows are shared Setting rows, the
         group headers use dc-section-header, the slider+value row is a shared LabeledSlider. -->
    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,2,10,8">
        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Calculator_Group_Display}" />

        <!-- Decimal Places -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_DecimalPlaces}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_DecimalPlaces_Desc}">
            <!-- MinWidth, not Width: the option list grows with the locale instead of clipping. -->
            <ComboBox x:Name="DecimalPlacesCombo" MinWidth="160" HorizontalAlignment="Right"
                      SelectionChanged="OnDecimalPlacesChanged" />
        </controls:Setting>

        <!-- Thousands Separator -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_ThousandsSep}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_ThousandsSep_Desc}">
            <ToggleSwitch x:Name="ThousandsSepToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Calculator_Group_Mode}" />

        <!-- Default Angle Mode -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_AngleMode}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_AngleMode_Desc}">
            <ComboBox x:Name="AngleModeCombo" MinWidth="160" HorizontalAlignment="Right"
                      SelectionChanged="OnAngleModeChanged" />
        </controls:Setting>

        <!-- Default Panel Tab -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_DefaultTab}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_DefaultTab_Desc}">
            <ComboBox x:Name="DefaultTabCombo" MinWidth="160" HorizontalAlignment="Right"
                      SelectionChanged="OnDefaultTabChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Calculator_Group_History}" />

        <!-- Max History Items -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_MaxHistory}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_MaxHistory_Desc}">
            <controls:LabeledSlider x:Name="MaxHistorySlider" Width="180" Minimum="10" Maximum="100" Step="5"
                                    AutomationProperties.Name="{x:Static locales:Locale.Tools_Calculator_MaxHistory}" />
        </controls:Setting>

        <!-- Click History to Copy -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_ClickToCopy}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_ClickToCopy_Desc}">
            <ToggleSwitch x:Name="ClickToCopyToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <!-- Clear History & Memory -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Calculator_ClearAllTitle}"
                          Subtitle="{x:Static locales:Locale.Tools_Calculator_ClearAllDesc}">
            <Button Classes="dc-toolbar-button" Content="{x:Static locales:Locale.Tools_Clipboard_ClearNow}" Click="OnClearAllClicked" />
        </controls:Setting>
    </StackPanel>
</UserControl>
