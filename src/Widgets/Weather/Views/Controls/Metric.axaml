<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Weather.ViewModels"
             x:Class="Weather.Views.Controls.Metric"
             x:DataType="viewModels:MetricViewModel">
    <Viewbox Stretch="Uniform">
        <Canvas Width="110" Height="110">
            <!-- 量规弧长 242°（缺口 118° 居中于正下方）。StrokeDashArray 单位 = 描边宽度 8，
                 整圈 = 2π×50/8 ≈ 39.27，242/360 × 39.27 ≈ 26.398。改 StrokeThickness 必须同步改此值。 -->
            <Path StrokeThickness="8" StrokeDashArray="26.398,26.398" StrokeLineCap="Round"
                  Opacity="0.15"
                  Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                  RenderTransformOrigin="55,55">
                <Path.RenderTransform>
                    <RotateTransform Angle="149" />
                </Path.RenderTransform>
                <Path.Data>
                    <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                </Path.Data>
            </Path>
            <Path StrokeThickness="8" StrokeLineCap="Round"
                  StrokeDashArray="{Binding StrokeDashArray}"
                  IsVisible="{Binding IsProgressVisible}"
                  Stroke="{DynamicResource WeatherGaugeBrush}"
                  RenderTransformOrigin="55,55">
                <Path.RenderTransform>
                    <RotateTransform Angle="149" />
                </Path.RenderTransform>
                <Path.Data>
                    <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                </Path.Data>
            </Path>
            <TextBlock Name="ValueText" FontSize="{Binding FontSize}" FontWeight="SemiBold"
                       MinWidth="110" TextAlignment="Center" LineHeight="100"
                       Text="{Binding DisplayValue}" />
            <TextBlock Name="MinText" Canvas.Left="20" Canvas.Top="80" FontSize="20" FontWeight="SemiBold"
                       Text="{Binding DisplayMin}" />
            <TextBlock Name="MaxText" Canvas.Right="20" Canvas.Top="80"
                       Opacity="0.5" FontSize="20" FontWeight="SemiBold"
                       Text="{Binding DisplayMax}" />
            <PathIcon Name="MetricIcon" Foreground="{DynamicResource WeatherIconBrush}" 
                      Canvas.Left="45" Canvas.Top="80" Data="{Binding Icon}" />
        </Canvas>
    </Viewbox>
</UserControl>
