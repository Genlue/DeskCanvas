<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Weather.ViewModels"
             x:Class="Weather.Views.Controls.ForecastLarge"
             x:DataType="viewModels:ForecastViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WeatherForegroundBrush}" />
        </Style>
        <Style Selector="Button.detail-btn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.detail-btn:pointerover">
            <Setter Property="Background" Value="#22808080" />
        </Style>
    </UserControl.Styles>
    <LayoutTransformControl Name="Scaler">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   FontSize="16" FontWeight="Bold" 
                   Text="{Binding CityName}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" 
                   FontSize="44" LetterSpacing="-2" LineHeight="50" Margin="-2,0,0,0"
                   Text="{Binding CurrentTemperature}" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
            <PathIcon Foreground="{DynamicResource WeatherIconBrush}" 
                      Data="{Binding CurrentIcon}" />
            <Button Classes="detail-btn" Width="20" Height="20" CornerRadius="10"
                    Click="OpenPopup" ToolTip.Tip="查看天气详情与7天预报">
                <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                      Fill="{DynamicResource WeatherForegroundBrush}" Opacity="0.65"
                      Width="11" Height="11" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.Column="1"
                   FontSize="14" FontWeight="Bold" Opacity="0.5"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Text="{Binding CurrentCondition}" />
        <TextBlock Grid.Row="2" Grid.Column="1" 
                   FontSize="14" FontWeight="Bold" Opacity="0.5"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Text="{Binding CurrentMinMax}" />
        <Path Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 4"
              Height="1" Stretch="Fill" Opacity="0.12" StrokeThickness="1"
              Stroke="{DynamicResource WeatherForegroundBrush}" >
            <Path.Data>
                <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
            </Path.Data>
        </Path>
        <ScrollViewer x:Name="HourlyScroller" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding HourlyForecast}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:HourlyForecastViewModel">
                        <Grid RowDefinitions="*,*,*" MinWidth="57">
                            <TextBlock Grid.Row="0" Text="{Binding Time}" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="SemiBold" />
                            <PathIcon Grid.Row="1" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource WeatherIconBrush}" 
                                      VerticalAlignment="Center" Margin="0 4"
                                      Data="{Binding Icon}" />
                            <TextBlock Grid.Row="2" Text="{Binding Temperature}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="-15 0" Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
        <Path Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 4"
              Height="1" Stretch="Fill" Opacity="0.12" StrokeThickness="1"
              Stroke="{DynamicResource WeatherForegroundBrush}" >
            <Path.Data>
                <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
            </Path.Data>
        </Path>
        <ScrollViewer Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding DailyForecast}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DailyForecastViewModel">
                        <Grid ColumnDefinitions="60,Auto,60,*,25" Margin="0 7">
                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeek}" HorizontalAlignment="Left" FontWeight="Bold" />
                            <PathIcon Grid.Column="1" HorizontalAlignment="Center"
                                      Margin="0 -2 0 0"
                                      Foreground="{DynamicResource WeatherIconBrush}" 
                                      Data="{Binding Icon}" />
                            <TextBlock Grid.Column="2" Text="{Binding Min}" Opacity="0.5" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <Path Grid.Column="3" Margin="10 4 10 0" 
                                  Height="5" Stretch="Fill" Opacity="0.2" StrokeThickness="5" StrokeLineCap="Round"
                                  Stroke="{DynamicResource WeatherForegroundBrush}" >
                                <Path.Data>
                                    <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
                                </Path.Data>
                            </Path>
                            <Grid Grid.Column="3" Margin="10 4 10 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Graph[0]}" />
                                    <ColumnDefinition Width="{Binding Graph[1]}" />
                                    <ColumnDefinition Width="{Binding Graph[2]}" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Height="5" Stretch="Fill" StrokeThickness="5" StrokeLineCap="Round"
                                      Stroke="{DynamicResource WeatherTempBarBrush}">
                                    <Path.Data>
                                        <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
                                    </Path.Data>
                                </Path>
                            </Grid>
                            <TextBlock Grid.Column="4" Text="{Binding Max}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
    </LayoutTransformControl>
</UserControl>
