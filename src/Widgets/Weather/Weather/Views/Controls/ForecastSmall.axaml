<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Weather.Locales"
             xmlns:viewModels="clr-namespace:Weather.ViewModels"
             x:Class="Weather.Views.Controls.ForecastSmall"
             x:DataType="viewModels:ForecastViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WeatherForegroundBrush}" />
        </Style>
        <Style Selector="Button.detail-btn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.detail-btn:pointerover">
            <Setter Property="Background" Value="#22808080" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold" 
                           Text="{Binding CityName}" />
                <TextBlock Grid.Row="1" FontSize="44" LetterSpacing="-2" Margin="-2,0,0,0"
                           Text="{Binding CurrentTemperature}" />
                <PathIcon Grid.Row="2" HorizontalAlignment="Left"
                          Foreground="{DynamicResource WeatherIconBrush}" 
                          Data="{Binding CurrentIcon}" />
                <TextBlock Grid.Row="3" FontSize="14" FontWeight="Bold" Opacity="0.5"
                           Text="{Binding CurrentCondition}" />
                <TextBlock Grid.Row="4" FontSize="14" FontWeight="Bold" Opacity="0.5"
                           Text="{Binding CurrentMinMax}" />
            </Grid>
        </Viewbox>
        <!-- Top Right Detail/Expand Button -->
        <Button Classes="detail-btn" Width="22" Height="22" CornerRadius="11"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"
                Click="OpenPopup" ToolTip.Tip="{x:Static locales:Locale.Weather_OpenPopupTip}">
            <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                  Fill="{DynamicResource WeatherForegroundBrush}" Opacity="0.65"
                  Width="11" Height="11" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
    </Grid>
</UserControl>
