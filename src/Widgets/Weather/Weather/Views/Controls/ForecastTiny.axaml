<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Weather.ViewModels"
              x:Class="Weather.Views.Controls.ForecastTiny"
              x:DataType="viewModels:ForecastViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WeatherForegroundBrush}" />
        </Style>
    </UserControl.Styles>
    <Viewbox VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <TextBlock LetterSpacing="-1" Text="{Binding CurrentTemperature}" />
    </Viewbox>
</UserControl>