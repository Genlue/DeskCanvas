<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        xmlns:models="clr-namespace:Wheel.Models"
        xmlns:locales="clr-namespace:Wheel.Locales"
        x:Class="Wheel.Views.WheelPopupWindow"
        Title="{x:Static locales:Locale.Wheel_PopupTitle}"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Width="460"
        Height="560">

    <controls:SecondaryPanelShell>
        <controls:SecondaryPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Static locales:Locale.Wheel_PopupHeader}" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </StackPanel>
        </controls:SecondaryPanelShell.HeaderContent>

        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,4,0,0">
            <!-- 1. Template Select Bar -->
            <Border Grid.Row="0" Classes="dc-card-box" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Text="{x:Static locales:Locale.Wheel_CurrentTemplate}" VerticalAlignment="Center" FontSize="13" Opacity="0.8" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TemplateComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                              SelectionChanged="OnTemplateSelectionChanged"/>
                    <Button Grid.Column="2" Classes="action-pill" Content="{x:Static locales:Locale.Wheel_NewTemplate}" Click="OnNewTemplateClicked" Margin="0,0,4,0"/>
                    <Button Grid.Column="3" Classes="action-pill" Content="{x:Static locales:Locale.Wheel_Delete}" Click="OnDeleteTemplateClicked"/>
                </Grid>
            </Border>

            <!-- 2. Options List of current template -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Text="{x:Static locales:Locale.Wheel_OptionsSection}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.9"/>
                    <Button Grid.Column="1" Classes="action-pill" Content="{x:Static locales:Locale.Wheel_AddNewOption}" Click="OnAddOptionClicked"/>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="OptionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WheelOption">
                                <Border Background="{DynamicResource CardSubtleFill}" BorderBrush="{DynamicResource CardSubtleBorder}" BorderThickness="1"
                                        CornerRadius="{DynamicResource PillCornerRadius}" Padding="10,6" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{x:Static locales:Locale.Wheel_WeightLabel}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding Weight}" Minimum="1" Maximum="10" FormatString="0" Width="80" Height="28"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="action-pill" Content="✕" Tag="{Binding Id}" Click="OnDeleteOptionClicked" Padding="6,2"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Save button & Elimination toggle -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,10">
                <CheckBox x:Name="EliminateCheckBox" Content="{x:Static locales:Locale.Wheel_EliminationMode}" IsCheckedChanged="OnEliminateChanged" FontSize="12"/>
                <Button Grid.Column="1" Classes="primary-pill" Content="{x:Static locales:Locale.Wheel_SaveTemplate}" Click="OnSaveTemplateClicked"/>
            </Grid>

            <!-- 3. Decision History -->
            <Border Grid.Row="3" Background="{DynamicResource CardSubtleFill}" CornerRadius="{DynamicResource CardSubtleCornerRadius}" Padding="10,8" MaxHeight="110">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static locales:Locale.Wheel_HistorySection}" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <Button Grid.Column="1" Classes="action-pill" Content="{x:Static locales:Locale.Wheel_Clear}" Click="OnClearHistoryClicked" Padding="6,1" FontSize="10"/>
                    </Grid>
                    <ListBox x:Name="HistoryListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WheelDecisionRecord">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TemplateTitle}" FontSize="11" Margin="8,0" Opacity="0.8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedOption}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </controls:SecondaryPanelShell>
</Window>
