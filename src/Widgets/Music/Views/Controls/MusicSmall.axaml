<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Music.ViewModels"
             mc:Ignorable="d" d:DesignWidth="152" d:DesignHeight="152"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             x:Class="Music.Views.Controls.MusicSmall"
             x:DataType="vm:MusicViewModel">

    <UserControl.Styles>
        <Style Selector="ProgressBar.ios-scrubber">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="3"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource MusicAccentBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="ProgressBarRoot" Classes="elem-shadow"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Height="{TemplateBinding Height}">
                        <Panel>
                            <Border Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    HorizontalAlignment="Left"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ios-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ios-btn:pointerover">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.ios-play-btn">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ios-play-btn:pointerover">
            <Setter Property="Background" Value="#32FFFFFF"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </UserControl.Styles>

    <Grid Name="MainGrid"
          RowDefinitions="*,Auto,Auto,Auto,*"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Margin="12,8">

        <!-- Row 0: Elastic Spacer Top -->

        <!-- Row 1: Top Section (Cover + Title & Artist) -->
        <Grid Grid.Row="1" Name="HeaderGrid" ColumnDefinitions="Auto,*" MinHeight="48" VerticalAlignment="Center">
            <!-- Cover Art Frame -->
            <Border Name="CoverBorder" Grid.Column="0"
                    Width="52" Height="52" CornerRadius="12"
                    ClipToBounds="True" Background="#16FFFFFF"
                    VerticalAlignment="Center">
                <Panel>
                    <!-- Fallback Note / Disc -->
                    <Panel IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                        <Border Background="#12FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <PathIcon Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Width="24" Height="24"
                                  Opacity="0.75"
                                  Foreground="{DynamicResource MusicAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                    <!-- Album Artwork -->
                    <Image Source="{Binding CoverBitmap}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Border BorderBrush="#20FFFFFF" BorderThickness="0.8" CornerRadius="12" IsHitTestVisible="False"/>
                </Panel>
            </Border>

            <!-- Title & Artist -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" Spacing="2">
                <TextBlock Name="TitleBlock"
                           Text="{Binding TrackTitle}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="2"/>
                <TextBlock Name="ArtistBlock"
                           Text="{Binding Artist}"
                           FontSize="10.5" FontWeight="Normal" Opacity="0.72"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
            </StackPanel>
        </Grid>

        <!-- Row 2: Progress Scrubber (iOS style) -->
        <StackPanel Grid.Row="2" Name="ProgressSection"
                    Spacing="2" HorizontalAlignment="Stretch" Margin="0,10,0,8"
                    IsVisible="{Binding ShowProgressBar}">
            <Border Name="ProgressTrack" Height="14" Background="Transparent"
                    ClipToBounds="True"
                    Cursor="Hand" PointerPressed="OnProgressPointerPressed"
                    VerticalAlignment="Center">
                <ProgressBar Classes="ios-scrubber"
                             MinWidth="0"
                             Minimum="0" Maximum="1" Value="{Binding ProgressPercent}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             IsHitTestVisible="False"/>
            </Border>
            <!-- Time Labels -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="1,-1,1,0">
                <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                           FontSize="9" FontWeight="Normal" Opacity="0.6"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                           FontSize="9" FontWeight="Normal" Opacity="0.6"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Grid>
        </StackPanel>

        <!-- Row 3: Playback Controls (iOS style) -->
        <StackPanel Grid.Row="3" Name="ControlsSection"
                    Orientation="Horizontal" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Previous -->
            <Button Classes="ios-btn" Width="26" Height="26" CornerRadius="13"
                    Command="{Binding SkipPrevious}"
                    IsEnabled="{Binding CanSkipPrevious}">
                <PathIcon Data="M11.5 12L20.5 18.5V5.5L11.5 12zm-9 0L11.5 18.5V5.5L2.5 12z"
                          Width="12" Height="12"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>

            <!-- Play / Pause -->
            <Button Classes="ios-play-btn" Width="32" Height="32" CornerRadius="16"
                    Command="{Binding TogglePlayPause}"
                    IsEnabled="{Binding CanPlayPause}">
                <Panel>
                    <!-- Play Icon -->
                    <PathIcon Data="M7 5.5v13l11-6.5-11-6.5z" Width="13" Height="13"
                              Margin="1.5,0,0,0"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding !IsPlaying}"/>
                    <!-- Pause Icon -->
                    <PathIcon Data="M6 5h4v14H6V5zm8 0h4v14h-4V5z" Width="11" Height="11"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding IsPlaying}"/>
                </Panel>
            </Button>

            <!-- Next -->
            <Button Classes="ios-btn" Width="26" Height="26" CornerRadius="13"
                    Command="{Binding SkipNext}"
                    IsEnabled="{Binding CanSkipNext}">
                <PathIcon Data="M12.5 12L3.5 5.5v13L12.5 12zm9 0L12.5 5.5v13L21.5 12z"
                          Width="12" Height="12"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>
        </StackPanel>

        <!-- Row 4: Elastic Spacer Bottom -->
    </Grid>
</UserControl>
