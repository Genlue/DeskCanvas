<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Music.ViewModels"
             mc:Ignorable="d" d:DesignWidth="312" d:DesignHeight="312"
             Margin="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             x:Class="Music.Views.Controls.MusicLarge"
             x:DataType="vm:MusicViewModel">

    <UserControl.Styles>
        <Style Selector="ProgressBar.ios-scrubber">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="3.5"/>
            <Setter Property="Height" Value="3.5"/>
            <Setter Property="CornerRadius" Value="1.75"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource MusicAccentBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="ProgressBarRoot" Classes="elem-shadow"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Height="{TemplateBinding Height}">
                        <Panel>
                            <Border Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    HorizontalAlignment="Left"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ios-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ios-btn:pointerover">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.ios-play-btn">
            <Setter Property="Background" Value="#1CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ios-play-btn:pointerover">
            <Setter Property="Background" Value="#32FFFFFF"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
    </UserControl.Styles>

    <Grid Name="MainGrid"
          RowDefinitions="*,Auto,Auto,Auto,Auto,*"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Margin="16,12">

        <!-- Row 0: Elastic Spacer Top -->

        <!-- Row 1: Prominent Album Artwork (Dynamically sized in code-behind) -->
        <Border Grid.Row="1" Name="CoverBorder"
                Width="160" Height="160" CornerRadius="18"
                ClipToBounds="True" Background="#16FFFFFF"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="0,0,0,10">
            <Panel>
                <!-- Fallback Note / Disc -->
                <Panel IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                    <Border Background="#12FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <PathIcon Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                              Width="56" Height="56"
                              Opacity="0.75"
                              Foreground="{DynamicResource MusicAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Panel>
                <!-- Album Artwork -->
                <Image Source="{Binding CoverBitmap}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Border BorderBrush="#20FFFFFF" BorderThickness="0.8" CornerRadius="18" IsHitTestVisible="False"/>
            </Panel>
        </Border>

        <!-- Row 2: Title & Artist -->
        <StackPanel Grid.Row="2" Spacing="2" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Name="TitleBlock"
                       Text="{Binding TrackTitle}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="ArtistBlock"
                       Text="{Binding Artist}"
                       FontSize="13.5" FontWeight="Normal" Opacity="0.75"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Row 3: Progress Scrubber (Dynamic width in code-behind) -->
        <StackPanel Grid.Row="3" Name="ProgressSection"
                    Spacing="3" HorizontalAlignment="Center" Width="240" Margin="0,0,0,8"
                    IsVisible="{Binding ShowProgressBar}">
            <Border Name="ProgressTrack" Height="14" Background="Transparent"
                    ClipToBounds="True"
                    Cursor="Hand" PointerPressed="OnProgressPointerPressed"
                    VerticalAlignment="Center">
                <ProgressBar Classes="ios-scrubber"
                             MinWidth="0"
                             Minimum="0" Maximum="1" Value="{Binding ProgressPercent}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             IsHitTestVisible="False"/>
            </Border>

            <!-- Time Labels -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="1,-1,1,0">
                <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                           FontSize="10.5" FontWeight="Normal" Opacity="0.65"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                           FontSize="10.5" FontWeight="Normal" Opacity="0.65"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Grid>
        </StackPanel>

        <!-- Row 4: Playback Controls (iOS style) -->
        <StackPanel Grid.Row="4" Name="ControlsSection"
                    Orientation="Horizontal" Spacing="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Previous -->
            <Button Classes="ios-btn" Width="36" Height="36" CornerRadius="18"
                    Command="{Binding SkipPrevious}"
                    IsEnabled="{Binding CanSkipPrevious}">
                <PathIcon Data="M11.5 12L20.5 18.5V5.5L11.5 12zm-9 0L11.5 18.5V5.5L2.5 12z"
                          Width="16" Height="16"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>

            <!-- Play / Pause -->
            <Button Classes="ios-play-btn" Width="48" Height="48" CornerRadius="24"
                    Command="{Binding TogglePlayPause}"
                    IsEnabled="{Binding CanPlayPause}">
                <Panel>
                    <!-- Play Icon -->
                    <PathIcon Data="M7 5.5v13l11-6.5-11-6.5z" Width="20" Height="20"
                              Margin="2.5,0,0,0"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding !IsPlaying}"/>
                    <!-- Pause Icon -->
                    <PathIcon Data="M6 5h4v14H6V5zm8 0h4v14h-4V5z" Width="17" Height="17"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              IsVisible="{Binding IsPlaying}"/>
                </Panel>
            </Button>

            <!-- Next -->
            <Button Classes="ios-btn" Width="36" Height="36" CornerRadius="18"
                    Command="{Binding SkipNext}"
                    IsEnabled="{Binding CanSkipNext}">
                <PathIcon Data="M12.5 12L3.5 5.5v13L12.5 12zm9 0L12.5 5.5v13L21.5 12z"
                          Width="16" Height="16"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>
        </StackPanel>

        <!-- Row 5: Elastic Spacer Bottom -->
    </Grid>
</UserControl>
