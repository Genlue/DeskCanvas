<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Batteries.ViewModels"
             x:Class="Batteries.Views.BatteriesView"
             x:DataType="vm:BatteriesViewModel">

    <Viewbox x:Name="ScaleHost" Stretch="Uniform" StretchDirection="Both">
        <Grid x:Name="Board">
            <!-- Slot 0: Main Device -->
            <Grid x:Name="Item0" x:DataType="vm:BatteryDeviceItem" Margin="6"
                  ToolTip.Tip="{Binding TooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Stretch="Uniform" ClipToBounds="False">
                    <Canvas Width="110" Height="110">
                        <!-- Track -->
                        <Path Opacity="0.15" StrokeThickness="8"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <!-- Active Arc -->
                        <Path StrokeThickness="8" StrokeDashArray="31.416,31.416" StrokeLineCap="Round"
                              StrokeDashOffset="{Binding StrokeDashOffset}"
                              Stroke="{Binding StatusBrush}"
                              IsVisible="{Binding HasDevice}"
                              RenderTransformOrigin="55,55">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <!-- Center Icon (enlarged 46x46 centered at 32,32) -->
                        <PathIcon Data="{Binding IconData}"
                                  Canvas.Left="35" Canvas.Top="35" Width="40" Height="40"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  Opacity="0.85"
                                  IsVisible="{Binding HasDevice}" />
                        <!-- Charging Badge: macOS style, centered on the ring's top -->
                        <Border IsVisible="{Binding IsCharging}"
                                Canvas.Left="43" Canvas.Top="-7"
                                Width="24" Height="24" CornerRadius="12"
                                Background="{Binding StatusBrush}">
                            <Path Width="12" Height="14" Stretch="Fill"
                                  Fill="{Binding ChargingBadgeForeground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 12,2 L 4,13 L 10,13 L 8,22 L 18,10 L 12,10 Z" />
                        </Border>
                    </Canvas>
                </Viewbox>
                <Grid x:Name="ValueContainer0" Grid.Row="1" Height="32" Margin="0,4,0,0">
                    <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold"
                               Text="{Binding PercentText}"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Opacity="0.9" />
                </Grid>
            </Grid>

            <!-- Slot 1: Peripheral 1 -->
            <Grid x:Name="Item1" x:DataType="vm:BatteryDeviceItem" Margin="6"
                  ToolTip.Tip="{Binding TooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Stretch="Uniform" ClipToBounds="False">
                    <Canvas Width="110" Height="110">
                        <Path Opacity="0.15" StrokeThickness="8"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <Path StrokeThickness="8" StrokeDashArray="31.416,31.416" StrokeLineCap="Round"
                              StrokeDashOffset="{Binding StrokeDashOffset}"
                              Stroke="{Binding StatusBrush}"
                              IsVisible="{Binding HasDevice}"
                              RenderTransformOrigin="55,55">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <PathIcon Data="{Binding IconData}"
                                  Canvas.Left="35" Canvas.Top="35" Width="40" Height="40"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  Opacity="0.85"
                                  IsVisible="{Binding HasDevice}" />
                        <Border IsVisible="{Binding IsCharging}"
                                Canvas.Left="43" Canvas.Top="-7"
                                Width="24" Height="24" CornerRadius="12"
                                Background="{Binding StatusBrush}">
                            <Path Width="12" Height="14" Stretch="Fill"
                                  Fill="{Binding ChargingBadgeForeground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 12,2 L 4,13 L 10,13 L 8,22 L 18,10 L 12,10 Z" />
                        </Border>
                    </Canvas>
                </Viewbox>
                <Grid x:Name="ValueContainer1" Grid.Row="1" Height="32" Margin="0,4,0,0">
                    <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold"
                               Text="{Binding PercentText}"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Opacity="0.9" />
                </Grid>
            </Grid>

            <!-- Slot 2: Peripheral 2 -->
            <Grid x:Name="Item2" x:DataType="vm:BatteryDeviceItem" Margin="6"
                  ToolTip.Tip="{Binding TooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Stretch="Uniform" ClipToBounds="False">
                    <Canvas Width="110" Height="110">
                        <Path Opacity="0.15" StrokeThickness="8"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <Path StrokeThickness="8" StrokeDashArray="31.416,31.416" StrokeLineCap="Round"
                              StrokeDashOffset="{Binding StrokeDashOffset}"
                              Stroke="{Binding StatusBrush}"
                              IsVisible="{Binding HasDevice}"
                              RenderTransformOrigin="55,55">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <PathIcon Data="{Binding IconData}"
                                  Canvas.Left="35" Canvas.Top="35" Width="40" Height="40"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  Opacity="0.85"
                                  IsVisible="{Binding HasDevice}" />
                        <Border IsVisible="{Binding IsCharging}"
                                Canvas.Left="43" Canvas.Top="-7"
                                Width="24" Height="24" CornerRadius="12"
                                Background="{Binding StatusBrush}">
                            <Path Width="12" Height="14" Stretch="Fill"
                                  Fill="{Binding ChargingBadgeForeground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 12,2 L 4,13 L 10,13 L 8,22 L 18,10 L 12,10 Z" />
                        </Border>
                    </Canvas>
                </Viewbox>
                <Grid x:Name="ValueContainer2" Grid.Row="1" Height="32" Margin="0,4,0,0">
                    <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold"
                               Text="{Binding PercentText}"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Opacity="0.9" />
                </Grid>
            </Grid>

            <!-- Slot 3: Peripheral 3 -->
            <Grid x:Name="Item3" x:DataType="vm:BatteryDeviceItem" Margin="6"
                  ToolTip.Tip="{Binding TooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Grid.Row="0" Stretch="Uniform" ClipToBounds="False">
                    <Canvas Width="110" Height="110">
                        <Path Opacity="0.15" StrokeThickness="8"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <Path StrokeThickness="8" StrokeDashArray="31.416,31.416" StrokeLineCap="Round"
                              StrokeDashOffset="{Binding StrokeDashOffset}"
                              Stroke="{Binding StatusBrush}"
                              IsVisible="{Binding HasDevice}"
                              RenderTransformOrigin="55,55">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="50" RadiusY="50" />
                            </Path.Data>
                        </Path>
                        <PathIcon Data="{Binding IconData}"
                                  Canvas.Left="35" Canvas.Top="35" Width="40" Height="40"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                  Opacity="0.85"
                                  IsVisible="{Binding HasDevice}" />
                        <Border IsVisible="{Binding IsCharging}"
                                Canvas.Left="43" Canvas.Top="-7"
                                Width="24" Height="24" CornerRadius="12"
                                Background="{Binding StatusBrush}">
                            <Path Width="12" Height="14" Stretch="Fill"
                                  Fill="{Binding ChargingBadgeForeground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 12,2 L 4,13 L 10,13 L 8,22 L 18,10 L 12,10 Z" />
                        </Border>
                    </Canvas>
                </Viewbox>
                <Grid x:Name="ValueContainer3" Grid.Row="1" Height="32" Margin="0,4,0,0">
                    <TextBlock HorizontalAlignment="Stretch" TextAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold"
                               Text="{Binding PercentText}"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               Opacity="0.9" />
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
