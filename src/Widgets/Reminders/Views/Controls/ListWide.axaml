<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Reminders.ViewModels"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:local="clr-namespace:Reminders.Views.Controls"
             xmlns:models="clr-namespace:Reminders.Models"
             xmlns:locales="clr-namespace:Reminders.Locales"
             x:Class="Reminders.Views.Controls.ListWide"
             x:DataType="viewModels:RemindersViewModel"
             Margin="12,8,6,6">
    <UserControl.Styles>
        <!-- 一级界面编辑开关：样式键事实见 ListSmall.axaml 注释。
             祖先选择器必须是 local|ListWide（根控件的样式键是它自己的类型）。 -->
        <Style Selector="TextBox">
            <Setter Property="controls:ClickThroughTextBox.AllowEdit" Value="False" />
        </Style>
        <Style Selector="local|ListWide.editable TextBox">
            <Setter Property="controls:ClickThroughTextBox.AllowEdit" Value="True" />
        </Style>
        <!-- 编辑关闭时抹掉 hover 高亮（PART_BorderElement 事实见 ListSmall.axaml）；
             editable 模式下恢复 Fluent 默认 hover 底色。 -->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="local|ListWide.editable TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
        </Style>
        <Style Selector="Button.RemindersAddBtn">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.RemindersAddBtn:pointerover">
            <Setter Property="Background" Value="#22808080" />
        </Style>
        <Style Selector="Button.RemindersAddBtn:pressed">
            <Setter Property="Background" Value="#44808080" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="Auto, *">
        <!-- Left Action Button -->
        <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,4">
            <Button Name="OpenPopupBtn" Classes="RemindersAddBtn"
                    Width="24" Height="24" CornerRadius="12" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Click="OpenPopup" ToolTip.Tip="{x:Static locales:Locale.Reminders_List_Title}">
                <Path Data="M6,1 L6,11 M1,6 L11,6"
                      Stroke="{DynamicResource RemindersBadgeBrush}"
                      StrokeThickness="2" StrokeLineCap="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- Left Big Counter -->
        <TextBlock Grid.Row="1" Grid.Column="0" Name="CountText" Margin="0,-3,12,0" FontSize="32" FontWeight="Bold"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="{Binding Count}"
                   Foreground="{DynamicResource RemindersBadgeBrush}" />

        <!-- Left List Name -->
        <controls:ClickThroughTextBox Grid.Row="2" Grid.Column="0" Name="ListNameBox" Padding="0" Margin="0,0,12,2" 
                                      MinHeight="16" MinWidth="90" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                      Text="{Binding ListName}" LostFocus="ListNameChanged"
                                      Foreground="{DynamicResource RemindersBadgeBrush}" />

        <!-- Right Scrollable List filling full height -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Reminders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ReminderModel">
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Padding="0" Margin="0,-2,0,0" 
                                        DataContext="{Binding}" Click="CompleteReminder" 
                                        Background="Transparent" CornerRadius="12">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Width="16" Height="16" StrokeThickness="1.5"
                                                 Stroke="{DynamicResource RemindersCheckBrush}" />
                                        
                                        <Path Canvas.Left="3" Canvas.Top="3" Width="10" Height="9" Stretch="Fill"
                                              IsVisible="{Binding Completed}" Data="M0,4.5 L3.3,8 L10,0"
                                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                              Stroke="{DynamicResource RemindersCheckBrush}" />
                                    </Canvas>
                                </Button>
                                <controls:ClickThroughTextBox Grid.Row="0" Grid.Column="1" Padding="8,6,0,6" 
                                                              Text="{Binding Title}" 
                                                              TextWrapping="Wrap"
                                                              MinWidth="0"
                                                              x:DataType="models:ReminderModel" DataContext="{Binding}" 
                                                              LostFocus="EditReminder" />
                                <Path Grid.Row="1" Grid.Column="1" Height="1" Stretch="Fill" Opacity="0.12" Margin="8,0"
                                      StrokeThickness="1"
                                      Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" >
                                    <Path.Data>
                                        <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
