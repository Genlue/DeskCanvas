<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Pomodoro.ViewModels"
             xmlns:locales="clr-namespace:Pomodoro.Locales"
             x:Class="Pomodoro.Views.PomodoroView"
             x:DataType="vm:PomodoroViewModel">

    <UserControl.Styles>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#15808080" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="#30808080" />
        </Style>

        <Style Selector="Button.action-btn-large">
            <Setter Property="Background" Value="#15808080" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.action-btn-large:pointerover">
            <Setter Property="Background" Value="#30808080" />
        </Style>

        <Style Selector="Button.primary-play-btn">
            <Setter Property="Background" Value="{Binding PhaseBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-play-btn:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style Selector="Button.primary-play-btn-large">
            <Setter Property="Background" Value="{Binding PhaseBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary-play-btn-large:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style Selector="Button.phase-menu-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.phase-menu-btn:pointerover Border">
            <Setter Property="Background" Value="#35808080" />
        </Style>

        <Style Selector="Button.phase-pill">
            <Setter Property="Background" Value="#12808080" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button.phase-pill:pointerover">
            <Setter Property="Background" Value="#22808080" />
        </Style>
        <Style Selector="Button.phase-pill.active">
            <Setter Property="Background" Value="#30FF5A5F" />
            <Setter Property="Foreground" Value="#FF5A5F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.phase-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button.phase-tab:pointerover">
            <Setter Property="Background" Value="#18808080" />
        </Style>
        <Style Selector="Button.phase-tab.active">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Panel Margin="0">
        <!-- 2x2 Small Layout -->
        <Grid x:Name="SmallLayout" RowDefinitions="Auto,*,Auto" Margin="2,0,2,0">
            <!-- Header (Phase dropdown menu button + counter) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,2,0,4">
                <Button Grid.Column="0" Classes="phase-menu-btn" ToolTip.Tip="点击切换模式" HorizontalAlignment="Left">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="🍅 专注" Click="OnSelectPhaseFromFlyout" Tag="Focus" />
                            <MenuItem Header="☕ 短休" Click="OnSelectPhaseFromFlyout" Tag="ShortBreak" />
                            <MenuItem Header="🌴 长休" Click="OnSelectPhaseFromFlyout" Tag="LongBreak" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <Border Background="#20808080" CornerRadius="8" Padding="6,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="6" Height="6" Fill="{Binding PhaseBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PhaseTitle}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <PathIcon Data="M7 10l5 5 5-5z" Width="8" Height="8" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>

                <Border Grid.Column="1" Background="#15808080" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SessionCounterText}" FontSize="10" FontWeight="SemiBold" Opacity="0.85" />
                </Border>
            </Grid>

            <!-- Center Ring & Countdown -->
            <Viewbox Grid.Row="1" Stretch="Uniform" ClipToBounds="False" Margin="0,2,0,2">
                <Canvas Width="110" Height="110">
                    <!-- Background Track -->
                    <Path StrokeThickness="7" Opacity="0.15" Stroke="{Binding PhaseBrush}">
                        <Path.Data>
                            <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                        </Path.Data>
                    </Path>

                    <!-- Active Arc (Radius 48, Stroke 7 -> dash 43.085) -->
                    <Path StrokeThickness="7" StrokeDashArray="43.085,43.085" StrokeLineCap="Round"
                          StrokeDashOffset="{Binding StrokeDashOffset}"
                          Stroke="{Binding PhaseBrush}"
                          RenderTransformOrigin="55,55">
                        <Path.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Path.RenderTransform>
                        <Path.Data>
                            <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                        </Path.Data>
                    </Path>

                    <!-- Inner Time Text -->
                    <StackPanel Canvas.Left="0" Canvas.Top="34" Width="110" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.5"
                                   TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="{Binding CycleProgressText}"
                                   FontSize="9" Opacity="0.55"
                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Canvas>
            </Viewbox>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,2">
                <!-- Reset -->
                <Button Classes="action-btn" Click="OnResetClicked" ToolTip.Tip="重置">
                    <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Width="12" Height="12" Opacity="0.7" />
                </Button>

                <!-- Primary Play / Pause -->
                <Button Classes="primary-play-btn" Click="OnPlayPauseClicked" ToolTip.Tip="{Binding PlayPauseTooltip}">
                    <PathIcon Data="{Binding PlayPauseIconData}" Width="13" Height="13" />
                </Button>

                <!-- Skip -->
                <Button Classes="action-btn" Click="OnSkipClicked" ToolTip.Tip="跳过此阶段">
                    <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Width="12" Height="12" Opacity="0.7" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 4x2 Wide Layout -->
        <Grid x:Name="WideLayout" ColumnDefinitions="*,*" IsVisible="False" Margin="4,0,4,0">
            <!-- Left: Ring & Play -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,2,8,2">
                <Viewbox Grid.Row="0" Stretch="Uniform" ClipToBounds="False">
                    <Canvas Width="110" Height="110">
                        <Path StrokeThickness="7" Opacity="0.15" Stroke="{Binding PhaseBrush}">
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                            </Path.Data>
                        </Path>
                        <Path StrokeThickness="7" StrokeDashArray="43.085,43.085" StrokeLineCap="Round"
                              StrokeDashOffset="{Binding StrokeDashOffset}"
                              Stroke="{Binding PhaseBrush}"
                              RenderTransformOrigin="55,55">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                            <Path.Data>
                                <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                            </Path.Data>
                        </Path>
                        <StackPanel Canvas.Left="0" Canvas.Top="38" Width="110" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.5"
                                       TextAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        </StackPanel>
                    </Canvas>
                </Viewbox>

                <Button Grid.Row="1" Classes="primary-play-btn" HorizontalAlignment="Center" Margin="0,4,0,0"
                        Click="OnPlayPauseClicked" ToolTip.Tip="{Binding PlayPauseTooltip}">
                    <PathIcon Data="{Binding PlayPauseIconData}" Width="13" Height="13" />
                </Button>
            </Grid>

            <!-- Right: Phase Selection, Cycle info, Actions -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <!-- Phase Pills -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="phase-pill" Classes.active="{Binding IsFocusPhase}"
                            Content="专注" Click="OnSelectPhaseClicked" Tag="Focus" />
                    <Button Classes="phase-pill" Classes.active="{Binding IsShortBreakPhase}"
                            Content="短休" Click="OnSelectPhaseClicked" Tag="ShortBreak" />
                    <Button Classes="phase-pill" Classes.active="{Binding IsLongBreakPhase}"
                            Content="长休" Click="OnSelectPhaseClicked" Tag="LongBreak" />
                </StackPanel>

                <!-- Session & Cycle Info -->
                <Border Background="#14808080" CornerRadius="10" Padding="10,6">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding SessionCounterText}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CycleProgressText}" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <!-- Action Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action-btn" Click="OnResetClicked" ToolTip.Tip="重置">
                        <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Width="12" Height="12" Opacity="0.7" />
                    </Button>
                    <Button Classes="action-btn" Click="OnSkipClicked" ToolTip.Tip="跳过">
                        <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Width="12" Height="12" Opacity="0.7" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 4x4 Large Layout -->
        <Grid x:Name="LargeLayout" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False" Margin="6,2,6,4">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,2,0,6">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding PhaseBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PhaseTitle}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Background="#15808080" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CycleProgressText}" FontSize="10" FontWeight="SemiBold" Opacity="0.85" />
                    </Border>
                    <Border Background="#15808080" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SessionCounterText}" FontSize="10" FontWeight="SemiBold" Opacity="0.85" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Phase Switcher Tabs -->
            <Border Grid.Row="1" Background="#12808080" CornerRadius="12" Padding="3" HorizontalAlignment="Center" Margin="0,4,0,8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="phase-tab" Classes.active="{Binding IsFocusPhase}"
                            Content="🍅 专注" Click="OnSelectPhaseClicked" Tag="Focus" />
                    <Button Classes="phase-tab" Classes.active="{Binding IsShortBreakPhase}"
                            Content="☕ 短休" Click="OnSelectPhaseClicked" Tag="ShortBreak" />
                    <Button Classes="phase-tab" Classes.active="{Binding IsLongBreakPhase}"
                            Content="🌴 长休" Click="OnSelectPhaseClicked" Tag="LongBreak" />
                </StackPanel>
            </Border>

            <!-- Big Ring Gauge & Countdown -->
            <Viewbox Grid.Row="2" Stretch="Uniform" ClipToBounds="False" Margin="0,4,0,8" MaxHeight="190">
                <Canvas Width="110" Height="110">
                    <Path StrokeThickness="7" Opacity="0.15" Stroke="{Binding PhaseBrush}">
                        <Path.Data>
                            <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                        </Path.Data>
                    </Path>
                    <Path StrokeThickness="7" StrokeDashArray="43.085,43.085" StrokeLineCap="Round"
                          StrokeDashOffset="{Binding StrokeDashOffset}"
                          Stroke="{Binding PhaseBrush}"
                          RenderTransformOrigin="55,55">
                        <Path.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Path.RenderTransform>
                        <Path.Data>
                            <EllipseGeometry Center="55,55" RadiusX="48" RadiusY="48" />
                        </Path.Data>
                    </Path>
                    <StackPanel Canvas.Left="0" Canvas.Top="32" Width="110" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="24" FontWeight="SemiBold" LetterSpacing="-0.5"
                                   TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="{Binding PhaseTitle}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding PhaseBrush}"
                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Canvas>
            </Viewbox>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,4,0,4">
                <Button Classes="action-btn-large" Click="OnResetClicked" ToolTip.Tip="重置">
                    <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Width="15" Height="15" Opacity="0.75" />
                </Button>

                <Button Classes="primary-play-btn-large" Click="OnPlayPauseClicked" ToolTip.Tip="{Binding PlayPauseTooltip}">
                    <PathIcon Data="{Binding PlayPauseIconData}" Width="16" Height="16" />
                </Button>

                <Button Classes="action-btn-large" Click="OnSkipClicked" ToolTip.Tip="跳过此阶段">
                    <PathIcon Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Width="15" Height="15" Opacity="0.75" />
                </Button>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
