<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Tools.Models"
        xmlns:locales="clr-namespace:Tools.Locales"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        x:Class="Tools.Views.ClipboardPopupWindow"
        Title="Clipboard Manager"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Width="440"
        Height="540">

    <Window.Styles>
        <Style Selector="Button.tab-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button.tab-pill:pointerover">
            <Setter Property="Background" Value="#15808080" />
        </Style>
        <Style Selector="Button.tab-pill.active">
            <Setter Property="Background" Value="#3034C759" />
            <Setter Property="Foreground" Value="#34C759" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.clip-card">
            <Setter Property="Background" Value="#12808080" />
            <Setter Property="BorderBrush" Value="#15ffffff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.clip-card:pointerover">
            <Setter Property="Background" Value="#25808080" />
        </Style>
        <Style Selector="Border.clip-card.pinned">
            <Setter Property="BorderBrush" Value="#60FF9500" />
            <Setter Property="Background" Value="#1CFF9500" />
        </Style>
        <!-- The search field is a bare caret inside the panel's own inset box. Fluent paints its own
             box in EVERY state (rest, pointer-over, focus), and this window focuses the field on
             open — so the opaque white/blue input box was what the user saw over the glass card.
             Same rule the launcher's search field carries. -->
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.search-box /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.search-box:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Item marks (开发规范 §4.4): geometry, never emoji. The pin is one filled silhouette in
             two states — faint at rest, accent + full opacity once the entry is pinned — so the
             button never changes its own box between states. -->
        <Style Selector="Path.item-mark">
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button:pointerover Path.item-mark">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.pin-btn.pinned Path.item-mark">
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <!-- The shared secondary-panel shell (W7) owns the card, the glass, the header with the
         drag area and the shared close button, and the backdrop-dismiss rule. This window
         declares ONLY business content. The shell's default ContentPadding (16,14,16,12)
         replaces the old content grid margin; the header strip replaces the old title row
         (same 0,0,0,10 spacing) and the drag is confined to it — the list, the search box and
         the tabs never move the window any more. -->
    <controls:SecondaryPanelShell>
        <controls:SecondaryPanelShell.HeaderContent>
            <!-- Dynamic title: count badge next to the localized popup title. -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Static locales:Locale.Tools_Clipboard_PopupTitle}" FontSize="15" FontWeight="Bold" />
                <Border Background="#20808080" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock x:Name="CountBadge" Text="0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
            </StackPanel>
        </controls:SecondaryPanelShell.HeaderContent>

        <!-- Business content: search, category tabs, history items. -->
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Search Box -->
            <Border Grid.Row="0" Background="#14808080" CornerRadius="10" Padding="8,4" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Magnifier as geometry (开发规范 §4.4) — framed on a square canvas so the
                         box centres it (GlyphGeometry.Square). -->
                    <Path Grid.Column="0"
                          Width="13" Height="13"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Stretch="Uniform"
                          Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                          Opacity="0.7"
                          Data="{x:Static models:ToolGlyphs.Search}" />
                    <TextBox Grid.Column="1" x:Name="SearchBox" Classes="search-box"
                             Background="Transparent" BorderThickness="0"
                             PlaceholderText="{x:Static locales:Locale.Tools_Clipboard_SearchWatermark}" FontSize="12"
                             Padding="0,2" VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <!-- Filter Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,10">
                <Button x:Name="TabAll" Classes="tab-pill active" Content="{x:Static locales:Locale.Tools_Clipboard_All}" Click="OnTabClicked" Tag="All" />
                <Button x:Name="TabText" Classes="tab-pill" Content="{x:Static locales:Locale.Tools_Clipboard_Text}" Click="OnTabClicked" Tag="Text" />
                <Button x:Name="TabImage" Classes="tab-pill" Content="{x:Static locales:Locale.Tools_Clipboard_Image}" Click="OnTabClicked" Tag="Image" />
                <Button x:Name="TabFiles" Classes="tab-pill" Content="{x:Static locales:Locale.Tools_Clipboard_Files}" Click="OnTabClicked" Tag="Files" />
            </StackPanel>

            <!-- History Items List -->
            <ScrollViewer Grid.Row="2" x:Name="ItemsScrollViewer">
                <StackPanel>
                    <!-- Empty state placeholder -->
                    <StackPanel x:Name="EmptyPanel" IsVisible="False" Margin="0,40,0,0" HorizontalAlignment="Center" Spacing="8">
                        <Path Width="34" Height="34"
                              HorizontalAlignment="Center"
                              Stretch="Uniform"
                              Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Opacity="0.4"
                              Data="{x:Static models:ToolGlyphs.Clipboard}" />
                        <TextBlock Text="{x:Static locales:Locale.Tools_Clipboard_NoMatches}" FontSize="13" HorizontalAlignment="Center" Opacity="0.5" />
                    </StackPanel>

                    <ItemsControl x:Name="ItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ClipboardItem">
                                <Border Classes="clip-card" Classes.pinned="{Binding IsPinned}"
                                        PointerPressed="OnItemCardPointerPressed" DataContext="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <!-- Type Icon / Thumbnail -->
                                        <Panel Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border Background="#20808080" CornerRadius="8" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                <!-- One geometry per entry type; the mark is a filled
                                                     Path so it takes the theme foreground (P5). -->
                                                <Path Width="16" Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                      Opacity="0.75"
                                                      Data="{Binding TypeIcon}" />
                                            </Border>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </Panel>

                                        <!-- Content Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10" Opacity="0.5" />
                                                <TextBlock Text="·" FontSize="10" Opacity="0.4" />
                                                <TextBlock Text="{Binding RelativeTime}" FontSize="10" Opacity="0.5" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons: Pin & Delete -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Classes="icon-btn pin-btn" Classes.pinned="{Binding IsPinned}"
                                                    Click="OnTogglePinClicked" DataContext="{Binding}"
                                                    ToolTip.Tip="{x:Static locales:Locale.Tools_Clipboard_TogglePin}" AutomationProperties.Name="{x:Static locales:Locale.Tools_Clipboard_TogglePin}">
                                                <Path Classes="item-mark"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      Data="{x:Static models:ToolGlyphs.Pin}" />
                                            </Button>
                                            <Button Classes="icon-btn" Click="OnDeleteItemClicked" DataContext="{Binding}"
                                                    ToolTip.Tip="{x:Static locales:Locale.Tools_Clipboard_DeleteRecord}" AutomationProperties.Name="{x:Static locales:Locale.Tools_Clipboard_DeleteRecord}">
                                                <Path Classes="item-mark"
                                                      Width="9" Height="9"
                                                      Stretch="Uniform"
                                                      Data="{x:Static models:ToolGlyphs.Close}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </controls:SecondaryPanelShell>
</Window>
