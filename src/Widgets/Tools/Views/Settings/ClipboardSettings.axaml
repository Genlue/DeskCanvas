<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Tools.Locales"
             x:Class="Tools.Views.Settings.ClipboardSettings"
             controls:SettingsPage.ScrollOwnership="Host">
    <!-- Scroll ownership: Host — no outer ScrollViewer of its own; the EditWidget content
         viewport is the single vertical scroll owner. -->
    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,2,10,8">
        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_HistoryGroup}" />

        <!-- Max History Count -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Clipboard_MaxHistory}"
                          Subtitle="{x:Static locales:Locale.Tools_Clipboard_MaxHistory_Desc}">
            <controls:LabeledSlider x:Name="MaxCountSlider" Width="180" Minimum="5" Maximum="100" Step="5"
                                    AutomationProperties.Name="{x:Static locales:Locale.Tools_Clipboard_MaxHistory}" />
        </controls:Setting>

        <!-- Auto Copy On Click -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Clipboard_AutoCopy}"
                          Subtitle="{x:Static locales:Locale.Tools_Clipboard_AutoCopy_Desc}">
            <ToggleSwitch x:Name="AutoCopyToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_FormatGroup}" />

        <!-- Capture Text -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Clipboard_CaptureText}">
            <ToggleSwitch x:Name="CaptureTextToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <!-- Capture Images -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Clipboard_CaptureImages}">
            <ToggleSwitch x:Name="CaptureImagesToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <!-- Capture Files -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Clipboard_CaptureFiles}">
            <ToggleSwitch x:Name="CaptureFilesToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_CacheGroup}" />

        <!-- Clear Cache -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Clipboard_Settings_ClearCache}"
                          Subtitle="{x:Static locales:Locale.Tools_Clipboard_Settings_ClearCacheDesc}">
            <Button Classes="dc-toolbar-button" Content="{x:Static locales:Locale.Tools_Clipboard_Settings_ClearNow}" Click="OnClearAllClicked" />
        </controls:Setting>
    </StackPanel>
</UserControl>
