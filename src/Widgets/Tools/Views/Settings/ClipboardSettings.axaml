<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Tools.Locales"
             x:Class="Tools.Views.Settings.ClipboardSettings">
    <UserControl.Styles>
        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TextBlock.setting-desc">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TextBlock.group-header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,16,8">
            <TextBlock Classes="group-header" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_HistoryGroup}" />

            <!-- Max History Count -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Clipboard_MaxHistory}" />
                <TextBlock Grid.Row="1" Classes="setting-desc" Text="{x:Static locales:Locale.Tools_Clipboard_MaxHistory_Desc}" />
                <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Slider x:Name="MaxCountSlider" Minimum="5" Maximum="100" Width="130"
                            TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnMaxCountChanged" />
                    <TextBlock x:Name="MaxCountValueText" VerticalAlignment="Center" Width="32" TextAlignment="Right" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Auto Copy On Click -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Clipboard_AutoCopy}" />
                <TextBlock Grid.Row="1" Classes="setting-desc" Text="{x:Static locales:Locale.Tools_Clipboard_AutoCopy_Desc}" />
                <ToggleSwitch x:Name="AutoCopyToggle" Grid.Column="1" Grid.RowSpan="2" OnContent="" OffContent=""
                              IsCheckedChanged="OnToggleChanged" />
            </Grid>

            <TextBlock Classes="group-header" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_FormatGroup}" />

            <!-- Capture Text -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Clipboard_CaptureText}" />
                <ToggleSwitch x:Name="CaptureTextToggle" Grid.Column="1" OnContent="" OffContent=""
                              IsCheckedChanged="OnToggleChanged" />
            </Grid>

            <!-- Capture Images -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Clipboard_CaptureImages}" />
                <ToggleSwitch x:Name="CaptureImagesToggle" Grid.Column="1" OnContent="" OffContent=""
                              IsCheckedChanged="OnToggleChanged" />
            </Grid>

            <!-- Capture Files -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Clipboard_CaptureFiles}" />
                <ToggleSwitch x:Name="CaptureFilesToggle" Grid.Column="1" OnContent="" OffContent=""
                              IsCheckedChanged="OnToggleChanged" />
            </Grid>

            <TextBlock Classes="group-header" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_CacheGroup}" />

            <!-- Clear Cache -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="setting-label" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_ClearCache}" />
                    <TextBlock Classes="setting-desc" Text="{x:Static locales:Locale.Tools_Clipboard_Settings_ClearCacheDesc}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="action-btn" Content="{x:Static locales:Locale.Tools_Clipboard_Settings_ClearNow}" Click="OnClearAllClicked" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
