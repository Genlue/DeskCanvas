<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Tools.Locales"
             x:Class="Tools.Views.Settings.TranslatorSettings"
             controls:SettingsPage.ScrollOwnership="Host">
    <!-- Scroll ownership: Host — no outer ScrollViewer of its own; the EditWidget content
         viewport is the single vertical scroll owner. The credential text boxes use the
         shared input styling from Styles/Controls/Input.axaml (no local chrome overrides). -->
    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,2,10,8">
        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Translator_Settings_GeneralGroup}" />

        <!-- Default Engine -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Translator_Engine}"
                          Subtitle="{x:Static locales:Locale.Tools_Translator_Engine_Desc}">
            <ComboBox x:Name="DefaultEngineCombo" MinWidth="160" HorizontalAlignment="Right"
                      SelectionChanged="OnEngineSelectionChanged" />
        </controls:Setting>

        <!-- Auto Translate As You Type -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Translator_AutoTranslate}"
                          Subtitle="{x:Static locales:Locale.Tools_Translator_AutoTranslate_Desc}">
            <ToggleSwitch x:Name="AutoTranslateToggle" OnContent="" OffContent=""
                          IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Translator_Settings_BaiduGroup}" />

        <!-- Baidu AppId -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Translator_BaiduAppId}">
            <TextBox x:Name="BaiduAppIdBox" Watermark="{x:Static locales:Locale.Tools_Translator_Settings_BaiduAppIdWatermark}"
                     TextChanged="OnBaiduCredentialsChanged" />
        </controls:Setting>

        <!-- Baidu Secret -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Translator_BaiduSecret}">
            <TextBox x:Name="BaiduSecretBox" PasswordChar="•" Watermark="{x:Static locales:Locale.Tools_Translator_Settings_BaiduSecretWatermark}"
                     TextChanged="OnBaiduCredentialsChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Tools_Translator_Settings_CustomGroup}" />

        <!-- Custom URL -->
        <controls:Setting Title="{x:Static locales:Locale.Tools_Translator_CustomUrl}">
            <TextBox x:Name="CustomUrlBox" Watermark="{x:Static locales:Locale.Tools_Translator_Settings_CustomUrlWatermark}"
                     TextChanged="OnCustomUrlChanged" />
        </controls:Setting>
    </StackPanel>
</UserControl>
