<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FixedWidgets.ViewModels"
             xmlns:controls="clr-namespace:FixedWidgets.Views.Controls"
             xmlns:views="clr-namespace:FixedWidgets.Views"
             x:Class="FixedWidgets.Views.AggregateView"
             x:DataType="vm:AggregateViewModel"
             Margin="0">

    <UserControl.Styles>
        <Style Selector="Ellipse.todayHighlight">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="TextBlock.dayNum">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="TextBlock.dayNum.today">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="TextBlock.dayNum.weekend:not(.today):not(.otherMonth)">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="TextBlock.dayNum.otherMonth">
            <Setter Property="Opacity" Value="0.22" />
        </Style>
    </UserControl.Styles>

    <!-- 严格 50/50 对半分布的根网格，100% 填满卡片内壁，消除任何黑边与外层间隙 -->
    <Grid ColumnDefinitions="*,1,*" Margin="0">

        <!-- ===================== 左半侧：城市 + 天气 + 时间 (自适应大小与 7 等边距对齐) =====================
             注意：三行都套 Viewbox(Stretch=Uniform)，行高一旦成为约束（实际总是如此），
             渲染出来的字号就完全由**行高占比**决定，改 FontSize 不会有任何变化。
             想让温度更大只能调整行权：1.2 / 1.4 / 2.2 = 25% / 29.2% / 45.8%
             （原 1.2 / 1 / 2.2 = 27.3% / 22.7% / 50%，温度偏小）。 -->
        <Grid Grid.Column="0"
              Margin="{Binding LeftMargin}"
              RowDefinitions="1.2*,1.4*,2.2*">

            <!-- 1. 城市名 (自适应大小缩放, 顶端与左端贴齐等距边界) -->
            <Viewbox Grid.Row="0"
                     Stretch="Uniform"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">
                <TextBlock Text="{Binding CityName}"
                           FontWeight="Bold"
                           FontSize="32"
                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Viewbox>

            <!-- 2. 当前温度数值与天气状况图标 (自适应大小缩放, 居中垂直分布, 左端贴齐边界) -->
            <Viewbox Grid.Row="1"
                     Stretch="Uniform"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TemperatureText}"
                               FontWeight="SemiBold"
                               FontSize="26"
                               LetterSpacing="-0.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <Path Data="{Binding WeatherIcon}"
                          Fill="{DynamicResource MacosTealBrush}"
                          Width="24" Height="24"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Opacity="0.9" />
                </StackPanel>
            </Viewbox>

            <!-- 3. 小时分钟时间 (自适应大小缩放, 占据下半区, 底端与左端贴齐边界) -->
            <Viewbox Grid.Row="2"
                     Stretch="Uniform"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom">
                <TextBlock Text="{Binding TimeText}"
                           FontWeight="SemiBold"
                           FontSize="60"
                           FontFamily="Inter, Segoe UI, -apple-system, sans-serif"
                           LetterSpacing="-1.5"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </Viewbox>
        </Grid>

        <!-- ===================== 中央微光分割线 (上下对齐内边距) ===================== -->
        <Rectangle Grid.Column="1"
                   Width="1"
                   Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                   Opacity="0.15"
                   VerticalAlignment="Stretch"
                   Margin="{Binding DividerMargin}" />

        <!-- ===================== 右半侧：严格 1:1 正方形精致月历 (四边等距 Padding) ===================== -->
        <Viewbox Grid.Column="2"
                 Margin="{Binding RightMargin}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Grid Width="130" Height="130"
                  RowDefinitions="Auto,Auto,*">

                <!-- 1. 月历标头：当前年月 -->
                <TextBlock Grid.Row="0"
                           Text="{Binding MonthYearText}"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="{DynamicResource CalendarHeaderBrush}"
                           Margin="0 0 0 4"
                           HorizontalAlignment="Left" />

                <!-- 2. 星期栏 (一 二 三 四 五 六 日) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekHeaders}" Margin="0 0 0 3">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Opacity="0.45"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. 7×5/6 日历点阵 (在正方形轮廓内均匀展开) -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding DayCells}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:DayCellViewModel">
                            <Viewbox Stretch="Uniform" Margin="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="100" Height="100">
                                    <!-- 今日强调色圆圈与数字（严格圆心数字重合，支持镂空） -->
                                    <controls:HollowTodayMark Width="100" Height="100"
                                                              GlyphSize="56"
                                                              GlyphWeight="Bold"
                                                              IsToday="{Binding IsToday}"
                                                              Text="{Binding DayText}"
                                                              Hollow="{Binding $parent[views:AggregateView].((vm:AggregateViewModel)DataContext).HollowTodayNumber}"
                                                              DotBrush="{Binding $parent[views:AggregateView].((vm:AggregateViewModel)DataContext).TodayDotBrush}" />

                                    <!-- 普通日期数字（非今日） -->
                                    <TextBlock Width="100"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="56"
                                               FontWeight="Bold"
                                               Classes="dayNum"
                                               Classes.otherMonth="{Binding !IsCurrentMonth}"
                                               Classes.weekend="{Binding IsWeekend}"
                                               IsVisible="{Binding !IsToday}"
                                               Text="{Binding DayText}" />
                                </Panel>
                            </Viewbox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Viewbox>

    </Grid>

</UserControl>
