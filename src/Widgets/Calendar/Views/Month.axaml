<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             xmlns:controls="clr-namespace:Calendar.Views.Controls"
             xmlns:views="clr-namespace:Calendar.Views"
             x:Class="Calendar.Views.Month"
             x:DataType="viewModels:MonthCalendarViewModel">
    
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="{Binding TextSize, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}" />
        </Style>
        <Style Selector="TextBlock.weekend:not(.today)">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
                <Style Selector="TextBlock.today">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    
    <Panel>
        <!-- Full month grid: L tier (2×2) and larger custom sizes. -->
        <Grid Name="FullMonth" RowDefinitions="Auto,*" ColumnDefinitions="*,13*">
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Month}" 
                       Margin="{Binding MonthMargin, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}"
                       Foreground="{DynamicResource CalendarHeaderBrush}" />
            <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DayViewModel">
                        <Grid>
                            <Viewbox>
                                <Panel Width="100" Height="100">
                                    <controls:HollowTodayMark Width="100" Height="100"
                                                              IsToday="{Binding IsToday}"
                                                              Text="{Binding Day}"
                                                              Hollow="{Binding HollowToday, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}"
                                                              DotBrush="{Binding TodayDotBrush, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}" />
                                    <TextBlock Width="100"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="60"
                                               Classes.weekend="{Binding IsWeekend}"
                                               Classes.today="{Binding IsToday}"
                                               Classes.hollow="{Binding HollowToday, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}"
                                               Text="{Binding Day}"  />
                                </Panel>
                            </Viewbox>
                            
                        </Grid>
                        </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

                <Grid Name="WeekRow" IsVisible="False" RowDefinitions="*,1.4*">
            <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekHeaders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Opacity="0.5" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentWeek}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:DayViewModel">
                        <Grid>
                            <Viewbox>
                                <Panel Width="100" Height="100">
                                    <controls:HollowTodayMark Width="100" Height="100"
                                                              IsToday="{Binding IsToday}"
                                                              Text="{Binding Day}"
                                                              Hollow="{Binding HollowToday, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}"
                                                              DotBrush="{Binding TodayDotBrush, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}" />
                                    <TextBlock Width="100"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="60"
                                               Classes.weekend="{Binding IsWeekend}"
                                               Classes.today="{Binding IsToday}"
                                               Classes.hollow="{Binding HollowToday, RelativeSource={RelativeSource AncestorType={x:Type views:Month}}}"
                                               Text="{Binding Day}" />
                                </Panel>
                            </Viewbox>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

                <Viewbox Name="TodayOnly" Stretch="Uniform" Margin="4" IsVisible="False">
            <Grid RowDefinitions="*,4*" ColumnDefinitions="*,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,2,0" FontWeight="Bold"
                           FontSize="12"
                           Foreground="{DynamicResource CalendarHeaderBrush}"
                           Text="{Binding TodayWeekday}"
                           VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="0" Grid.Column="1" Opacity="0.5" FontWeight="Bold"
                           FontSize="12"
                           Text="{Binding Month}"
                           VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" LetterSpacing="-3"
                           FontSize="44" LineHeight="53" Text="{Binding TodayNumber}" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
        </Viewbox>
    </Panel>
    
</UserControl>
