<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             xmlns:locales="clr-namespace:Calendar.Locales"
             x:Class="Calendar.Views.Controls.ScheduleSmall"
             x:DataType="viewModels:ScheduleViewModel"
             Margin="10,8,10,10">

    <UserControl.Styles>
        <Style Selector="Button.ActionBtn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.EventRowBtn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.EventRowBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Header: Weekday & Day Number + Secondary Panel Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <!-- Clickable date header to open secondary panel -->
            <Button Grid.Column="0" Classes="ActionBtn" Click="OnHeaderClicked" HorizontalAlignment="Left" ToolTip.Tip="{x:Static locales:Locale.Calendar_Schedule_OpenPanel}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding DayOfWeek}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource CalendarHeaderBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" Margin="0,1,0,0">
                        <TextBlock Text="{Binding Day}"
                                   FontSize="30"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding Month}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.55"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Top Right: More count indicator & Open Secondary Panel Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                <Border IsVisible="{Binding HasMoreThanTwoEvents}"
                        Background="{DynamicResource ControlHoverBrush}"
                        CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MoreThanTwoEventsText}"
                               FontSize="9.5" FontWeight="SemiBold" Opacity="0.75" />
                </Border>
                <Button Classes="ActionBtn"
                        Width="22" Height="22" CornerRadius="11"
                        Click="OnOpenPanelClicked"
                        ToolTip.Tip="{x:Static locales:Locale.Calendar_Schedule_OpenPanel}">
                    <Path Data="M4,9 L4,5 C4,4.4477 4.4477,4 5,4 L9,4 M15,4 L19,4 C19.5523,4 20,4.4477 20,5 L20,9 M20,15 L20,19 C20,19.5523 19.5523,20 19,20 L15,20 M9,20 L5,20 C4.4477,20 4,19.5523 4,19 L4,15"
                          Stroke="{DynamicResource TextControlForeground}"
                          StrokeThickness="1.5" StrokeLineCap="Round"
                          Width="11" Height="11" Stretch="Uniform"
                          Opacity="0.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body: Up to 2 Schedule Events or Empty State -->
        <Panel Grid.Row="1">
            <!-- When there are events: show up to 2 events -->
            <ItemsControl IsVisible="{Binding HasEvents}"
                          ItemsSource="{Binding SmallEvents}"
                          VerticalAlignment="Bottom">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:ScheduleItemViewModel">
                        <Button Classes="EventRowBtn" Click="OnEventItemClicked"
                                Tag="{Binding Id}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,2">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Category Accent Color Pill Bar -->
                                <Border Grid.Column="0"
                                        Width="3" CornerRadius="1.5"
                                        Background="{Binding ColorBrush}"
                                        Margin="0,2,6,2"
                                        VerticalAlignment="Stretch" />

                                <!-- Event Details: Title & Time/Location -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0.5">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{Binding SmallSummaryText}"
                                               FontSize="10"
                                               Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- When no events -->
            <StackPanel IsVisible="{Binding !HasEvents}" VerticalAlignment="Center" Spacing="2" Margin="0,4,0,0">
                <TextBlock Text="{x:Static locales:Locale.Calendar_Schedule_NoEvents}"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Opacity="0.55" />
                <TextBlock Text="今天全天无日程安排"
                           FontSize="10.5"
                           Opacity="0.35" />
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
