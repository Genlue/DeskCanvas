<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             x:Class="Calendar.Views.Date"
             x:DataType="viewModels:DateCalendarViewModel">
    <Viewbox Stretch="Uniform">
        <Grid RowDefinitions="*,4*" ColumnDefinitions="*,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,2,0" FontWeight="Bold"
                       Foreground="{DynamicResource CalendarHeaderBrush}" 
                       Text="{Binding DayOfWeek}" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="0" Grid.Column="1" Opacity="0.5" FontWeight="Bold"
                       Text="{Binding Month}" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Left" />
            <!-- 日号：交给内层 Viewbox（Uniform）负责 —— 行 1 整格就是它的容器，
                 容器本身永不被截断，数字在其中等比拉伸，直到宽/高任一边贴到容器
                 边缘为止，即"填满可用空间"。
                 此前用 RenderTransform 横向拉伸 8%：它不参与布局，文字按自然宽度
                 测量居中后视觉再变宽，墨迹溢出布局盒，经外层 Viewbox 放大后正好
                 被卡片右缘裁掉 —— 这就是右侧截断的根源，已移除。
                 行盒约束同前：LineHeight 不能小于字体自然行高（约 1.2 × FontSize），
                 否则 Avalonia 按行盒把字形底部平切；上/下负 Margin（-12/-8）只收
                 行盒的空白区（顶部空行与底部降部），墨迹仍留在布局盒内。
                 LetterSpacing=-3 会在末字符之后也计入间距，使测量宽度比墨迹短
                 3px，故右缘补 3px Margin 抵消，保证墨迹不出布局盒。 -->
            <Viewbox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Stretch="Uniform">
                <TextBlock LetterSpacing="-3" FontSize="50" LineHeight="60"
                           Text="{Binding Day}" FontWeight="SemiBold" Margin="0,-12,3,-8" />
            </Viewbox>
        </Grid>
    </Viewbox>
</UserControl>
