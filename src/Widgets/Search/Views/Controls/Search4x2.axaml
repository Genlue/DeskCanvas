<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Search.ViewModels"
             xmlns:services="using:Search.Services"
             xmlns:models="using:Search.Models"
             xmlns:locales="clr-namespace:Search.Locales"
             mc:Ignorable="d" d:DesignWidth="312" d:DesignHeight="152"
             x:Class="Search.Views.Controls.Search4x2"
             x:DataType="vm:SearchViewModel">

    <UserControl.Styles>
        <Style Selector="Button.engine-btn">
            <Setter Property="Background" Value="{DynamicResource SearchEngineButtonBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.engine-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.cat-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button.cat-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.dock-circle">
            <Setter Property="Background" Value="{DynamicResource SearchDockButtonBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource WidgetCardBorderBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style Selector="Button.dock-circle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchPillBorderBrush}" />
        </Style>
        <Style Selector="TextBox.search-input">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TextBox.search-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="10,7" RowDefinitions="Auto, Auto, Auto" VerticalAlignment="Center">
        <!-- Row 0: Top Header with Engine Selector & Category Pills -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,4" VerticalAlignment="Center">
            <!-- Left: Engine Selector Button -->
            <Button Grid.Column="0"
                    Classes="engine-btn"
                    Height="28"
                    Click="OnEngineSelectorClicked"
                    ToolTip.Tip="{x:Static locales:Locale.Search_Switch_Engine_Tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <PathIcon Data="{Binding EngineIconPath}"
                              Foreground="{Binding EngineColor}"
                              Width="15" Height="15"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EngineName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <PathIcon Data="{x:Static services:SearchIconProvider.ChevronDown}"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Width="9" Height="9"
                              VerticalAlignment="Center"
                              Opacity="0.7"/>
                </StackPanel>
            </Button>

            <!-- Right: Category Filter Pills -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="3"
                        HorizontalAlignment="Right"
                        Margin="4,0,0,0">
                <Button Classes="cat-pill" Content="{x:Static locales:Locale.Search_Category_All}" Tag="全部" Click="OnCategoryClicked"/>
                <Button Classes="cat-pill" Content="{x:Static locales:Locale.Search_Category_General}" Tag="通用" Click="OnCategoryClicked"/>
                <Button Classes="cat-pill" Content="{x:Static locales:Locale.Search_Category_Dev}" Tag="开发者" Click="OnCategoryClicked"/>
                <Button Classes="cat-pill" Content="{x:Static locales:Locale.Search_Category_AI}" Tag="AI 智能" Click="OnCategoryClicked"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Spotlight Search Input Bar -->
        <Border Grid.Row="1"
                Height="38"
                CornerRadius="19"
                Background="{DynamicResource SearchPillBackground}"
                BorderBrush="{DynamicResource SearchPillBorderBrush}"
                BorderThickness="1"
                Padding="6,2"
                Margin="0,6">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalAlignment="Center">
                <!-- Search Icon Prefix -->
                <PathIcon Grid.Column="0"
                          Data="{x:Static services:SearchIconProvider.DefaultSearchIcon}"
                          Foreground="{DynamicResource SearchMagnifierBrush}"
                          Width="14" Height="14"
                          Margin="4,0,2,0"
                          VerticalAlignment="Center"
                          Opacity="0.85"/>

                <!-- Search Input -->
                <TextBox Grid.Column="1"
                         Name="SearchInputBox"
                         Classes="search-input"
                         Text="{Binding QueryText, Mode=TwoWay}"
                         Watermark="{Binding SearchPlaceholder}"
                         KeyDown="OnInputKeyDown"/>

                <!-- Clear Button -->
                <Button Grid.Column="2"
                        Classes="cat-pill"
                        Width="22" Height="22"
                        CornerRadius="11"
                        Padding="0"
                        Margin="2,0"
                        IsVisible="{Binding HasQuery}"
                        Click="OnClearClicked"
                        ToolTip.Tip="{x:Static locales:Locale.Search_Clear}">
                    <PathIcon Data="{x:Static services:SearchIconProvider.ClearIcon}"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Width="10" Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Button>

                <!-- Search Action Button -->
                <Button Grid.Column="3"
                        Classes="engine-btn"
                        Width="30" Height="30"
                        CornerRadius="15"
                        Padding="0"
                        Margin="2,0,1,0"
                        Background="{DynamicResource SearchButtonBrush}"
                        Click="OnSearchActionClicked"
                        ToolTip.Tip="{x:Static locales:Locale.Search_Button}">
                    <PathIcon Data="{x:Static services:SearchIconProvider.DefaultSearchIcon}"
                              Foreground="{DynamicResource AccentContrastForegroundBrush}"
                              Width="13" Height="13"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Row 2: Bottom Dock with Compact Icons & History Button -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,2,0,0" VerticalAlignment="Center">
            <!-- Left: Engine Icons Dock (Scrollable with mouse wheel) -->
            <ScrollViewer Grid.Column="0"
                          Name="DockScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          ClipToBounds="True"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding DisplayEngines}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchEngine">
                            <Button Classes="dock-circle"
                                    Tag="{Binding}"
                                    Click="OnQuickEngineClicked"
                                    ToolTip.Tip="{Binding Name}">
                                <PathIcon Data="{Binding SvgPath}"
                                          Foreground="{Binding IconColor}"
                                          Width="14" Height="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Right: Recent Searches Dropdown Button -->
            <Button Grid.Column="1"
                    Name="HistoryButton"
                    Classes="engine-btn"
                    Height="28"
                    Margin="4,0,0,0"
                    IsVisible="{Binding HasHistory}"
                    Click="OnHistoryClicked"
                    ToolTip.Tip="{x:Static locales:Locale.Search_History}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static services:SearchIconProvider.HistoryIcon}"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Width="12" Height="12"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static locales:Locale.Search_History_Short}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
