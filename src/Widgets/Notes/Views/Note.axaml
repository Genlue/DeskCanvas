<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:uWidgets.Views.Controls;assembly=uWidgets"
             xmlns:locales="clr-namespace:Notes.Locales"
             x:Class="Notes.Views.Note"
             Margin="0"
             Foreground="{DynamicResource NotesTextBrush}">
    <UserControl.Styles>
        <Style Selector="Border:not(:pointerover) ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="Border:pointerover ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- 彻底禁用卡内 TextBox 内嵌 ScrollViewer 的横向滚动（标题不换行溢出时
             也不会出现横向滚动条；控件级样式晚于 Widget 窗口样式应用，能压过其悬停 Auto） -->
        <Style Selector="TextBox /template/ ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="Button.NotesPanelBtn">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.NotesPanelBtn:pointerover">
            <Setter Property="Background" Value="#22808080" />
        </Style>
        <Style Selector="Button.NotesPanelBtn:pressed">
            <Setter Property="Background" Value="#44808080" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <!-- Content area background spanning row 1, 2 and 3: Light is pure white, Dark is pure black -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource NotesPaperBackground}" />
        <!-- Colored header bar: title (editable when the widget setting allows) + secondary panel button -->
        <Border Grid.Row="0" Name="HeaderBorder" CornerRadius="0">
            <Grid ColumnDefinitions="*, Auto">
                <controls:ClickThroughTextBox Name="TitleBox" CornerRadius="0" Height="44"
                                              VerticalContentAlignment="Center" LostFocus="UpdateTitle"
                                              Foreground="{DynamicResource NotesTitleForegroundBrush}"
                                              FontSize="16" FontWeight="SemiBold"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <Button Grid.Column="1" Name="OpenPanelBtn" Classes="NotesPanelBtn"
                        Width="26" Height="26" CornerRadius="13" Padding="0" Margin="0,0,9,0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Click="OpenPopupClick" ToolTip.Tip="{x:Static locales:Locale.Notes_Panel_Open}">
                    <Path Data="M2,7 L2,2 L7,2 M2.7,2.7 L7,7 M14,9 L14,14 L9,14 M13.3,13.3 L9,9"
                          Stroke="{DynamicResource NotesTitleForegroundBrush}"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
        <Path Grid.Row="1" Name="Divider" Height="1" Margin="0,5,0,0" Stretch="Fill"
              Opacity="0.5" StrokeThickness="1"
              Stroke="{DynamicResource NotesDividerBrush}" >
            <Path.Data>
                <LineGeometry StartPoint="0,0" EndPoint="1,0"/>
            </Path.Data>
        </Path>
        <Grid Grid.Row="2" Name="BodyArea" MinHeight="0">
            <ScrollViewer Name="RenderScroll" IsVisible="False">
                <ContentControl Name="RenderedHost" />
            </ScrollViewer>
            <ScrollViewer Name="FileScroll" IsVisible="False">
                <StackPanel Name="FilePanel" Margin="0,2,0,0" />
            </ScrollViewer>
            <controls:ClickThroughTextBox Name="ContentBox" MinHeight="0" AcceptsReturn="True"
                                          Background="Transparent"
                                          Foreground="{DynamicResource NotesTextBrush}"
                                          TextWrapping="Wrap" IsVisible="False" LostFocus="UpdateContent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Grid>
        <TextBlock Grid.Row="3" Name="UpdatedText" Padding="12,0,12,8" FontSize="12" Opacity="0.5"
                   Foreground="{DynamicResource NotesUpdatedBrush}" />
    </Grid>
</UserControl>
