<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        xmlns:views="clr-namespace:Dice.Views"
        xmlns:locales="clr-namespace:Dice.Locales"
        x:Class="Dice.Views.DicePopupWindow"
        Title="{x:Static locales:Locale.Dice_PopupTitle}"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Width="460"
        Height="540">

    <Window.Styles>
        <Style Selector="Button.action-pill">
            <Setter Property="Background" Value="#1C808080" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.action-pill:pointerover">
            <Setter Property="Background" Value="#32808080" />
        </Style>
        <Style Selector="Button.count-btn">
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#20ffffff" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.count-btn.active">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <controls:SecondaryPanelShell>
        <controls:SecondaryPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Static locales:Locale.Dice_PopupHeader}" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </StackPanel>
        </controls:SecondaryPanelShell.HeaderContent>

        <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
            <!-- Controls Card -->
            <Border Grid.Row="0" Background="#14808080" BorderBrush="#1Cffffff" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <!-- Dice Count Row -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{x:Static locales:Locale.Dice_CountLabel}" VerticalAlignment="Center" FontSize="13" Opacity="0.8" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="Count1Btn" Classes="count-btn" Content="1" Click="OnCountSelect" Tag="1"/>
                            <Button x:Name="Count2Btn" Classes="count-btn" Content="2" Click="OnCountSelect" Tag="2"/>
                            <Button x:Name="Count3Btn" Classes="count-btn" Content="3" Click="OnCountSelect" Tag="3"/>
                            <Button x:Name="Count4Btn" Classes="count-btn" Content="4" Click="OnCountSelect" Tag="4"/>
                            <Button x:Name="Count5Btn" Classes="count-btn" Content="5" Click="OnCountSelect" Tag="5"/>
                            <Button x:Name="Count6Btn" Classes="count-btn" Content="6" Click="OnCountSelect" Tag="6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dice Type Row -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{x:Static locales:Locale.Dice_TypeLabel}" VerticalAlignment="Center" FontSize="13" Opacity="0.8" Margin="0,0,12,0"/>
                        <ComboBox x:Name="TypeComboBox" Grid.Column="1" Width="140" SelectionChanged="OnTypeChanged">
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD6}" Tag="6"/>
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD4}" Tag="4"/>
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD8}" Tag="8"/>
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD10}" Tag="10"/>
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD12}" Tag="12"/>
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD20}" Tag="20"/>
                            <ComboBoxItem Content="{x:Static locales:Locale.Dice_TypeD100}" Tag="100"/>
                        </ComboBox>
                    </Grid>

                    <!-- Big Roll Button -->
                    <Button x:Name="RollActionBtn"
                            Background="{DynamicResource SystemControlHighlightAccentBrush}"
                            Foreground="{DynamicResource AccentContrastForegroundBrush}"
                            CornerRadius="10" Padding="0,10" FontWeight="SemiBold" FontSize="14"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Cursor="Hand" Click="OnRollClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="🎲" FontSize="16"/>
                            <TextBlock x:Name="RollButtonText" Text="{x:Static locales:Locale.Dice_RollNow}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Result Banner -->
            <Border Grid.Row="1" Background="#16808080" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{x:Static locales:Locale.Dice_LatestResult}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LatestValuesText" Grid.Column="1" Text="[ 3, 5 ]" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}"/>
                    <TextBlock x:Name="LatestSumText" Grid.Column="2" Text="{x:Static locales:Locale.Dice_SumPlaceholder}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- History Section -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Text="{x:Static locales:Locale.Dice_HistoryTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.9"/>
                    <Button Grid.Column="1" Classes="action-pill" Content="{x:Static locales:Locale.Dice_ClearHistory}" Click="OnClearHistoryClicked"/>
                </Grid>

                <ListBox x:Name="HistoryListBox" Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:DiceHistoryItemViewModel">
                            <Border Background="#10808080" BorderBrush="#14ffffff" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ValuesSummary}" FontSize="13" FontWeight="Medium" Margin="12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SumSummary}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </controls:SecondaryPanelShell>
</Window>
