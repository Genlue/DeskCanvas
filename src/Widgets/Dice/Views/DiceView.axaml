<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dice.Views.Controls"
             xmlns:locales="clr-namespace:Dice.Locales"
             x:Class="Dice.Views.DiceView"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">

    <UserControl.Styles>
        <!--  Ghost 图标按钮：透明底，:pointerover 提亮（跟随主题 token）  -->
        <Style Selector="Button.ghost-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.ghost-btn:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PillHoverBackground}" />
        </Style>

        <!--  主按钮：唯一强调色  -->
        <Style Selector="Button.roll-pill">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentContrastForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetPillCornerRadius}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  Header 总和 pill：中性灰底，蓝只留给主按钮  -->
        <Style Selector="Border.sum-pill">
            <Setter Property="Background" Value="{DynamicResource PillBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetPillCornerRadius}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent" PointerPressed="OnCardPointerPressed">
        <!-- 1x1 Cell Layout -->
        <Grid x:Name="CellLayout" RowDefinitions="*,Auto" Margin="6" IsVisible="False">
            <!--  Viewbox + DownOnly：1x1 单元格比骰面还小时把整个骰面等比缩下来。
                  只靠 MaxWidth/MaxHeight 不够——骰面有固定 48 的自持尺寸，格子更小时它会
                  直接顶出卡片，被卡片裁掉的就是骰面边缘的那几个点。  -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2">
                <controls:DiceFaceControl x:Name="CellDiceFace" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         MaxWidth="64" MaxHeight="64"/>
            </Viewbox>
            <TextBlock Grid.Row="1" Text="{x:Static locales:Locale.Dice_TapToRoll}" FontSize="10" Opacity="0.55" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </Grid>

        <!-- 2x2 Small Layout -->
        <Grid x:Name="SmallLayout" RowDefinitions="Auto,*,Auto" Margin="12,10" IsVisible="True">
            <!-- Header -->
            <!-- Header：标题占 * 列并截断，总和 pill 与详情按钮保持 Auto——
                 窄卡片下先截断标题，绝不把按钮挤出卡片（旧版 Auto 标题列会把
                 详情按钮整个顶出可视区）。 -->
            <Grid x:Name="SmallHeader" Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{x:Static locales:Locale.Dice_Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                <Border x:Name="SmallSumPill" Grid.Column="1" Classes="sum-pill" Margin="0,0,4,0" MaxWidth="140">
                    <TextBlock x:Name="SmallSumText" Text="{x:Static locales:Locale.Dice_SumPlaceholder}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Grid.Column="2" Classes="ghost-btn" Click="OnExpandDetailsClicked" ToolTip.Tip="{x:Static locales:Locale.Dice_DetailsTip}">
                    <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12"/>
                </Button>
            </Grid>

            <!-- Dice Tray：骰子数量与骰面尺寸由 DiceTrayPanel 按可用空间自适应 -->
            <controls:DiceTrayPanel x:Name="SmallDiceTray" Grid.Row="1" MaxFaceSize="48"/>

            <!-- Bottom Action -->
            <Button x:Name="SmallRollButton" Grid.Row="2" Classes="roll-pill" HorizontalAlignment="Center" Click="OnRollActionClicked">
                <TextBlock x:Name="SmallRollText" Text="{x:Static locales:Locale.Dice_RollAction}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- 4x2 Wide Layout：整宽骰盘（不再带右侧历史栏） -->
        <Grid x:Name="WideLayout" RowDefinitions="Auto,*,Auto" Margin="14,10" IsVisible="False">
            <Grid x:Name="WideHeader" Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{x:Static locales:Locale.Dice_Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                <Border x:Name="WideSumPill" Grid.Column="1" Classes="sum-pill" Margin="0,0,4,0" MaxWidth="140">
                    <TextBlock x:Name="WideSumText" Text="{x:Static locales:Locale.Dice_SumPlaceholder}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button Grid.Column="2" Classes="ghost-btn" Click="OnExpandDetailsClicked" ToolTip.Tip="{x:Static locales:Locale.Dice_DetailsTip}">
                    <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12"/>
                </Button>
            </Grid>

            <controls:DiceTrayPanel x:Name="WideDiceTray" Grid.Row="1" MaxFaceSize="64"/>

            <Button x:Name="WideRollButton" Grid.Row="2" Classes="roll-pill" HorizontalAlignment="Center" Click="OnRollActionClicked">
                <TextBlock Text="{x:Static locales:Locale.Dice_RollAction}"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
