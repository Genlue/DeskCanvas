<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dice.Views.Controls.DiceFaceControl">
    <UserControl.Resources>
        <!--  组件语义色：中式骰子 1 点红。MacosRedBrush 仅在 Colorful 主题中定义，
             为保证浅色/深色/玻璃等全部外观下可读，这里按明暗变体本地提供。  -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DiceFaceOneDotBrush" Color="#D70015" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DiceFaceOneDotBrush" Color="#FF453A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  中性玻璃骰面：无描边、圆角 10、极轻投影。
         尺寸由 code-behind 的 FaceSize 写入（Width/Height/CornerRadius/Padding）。
         骰面内的点阵与数字全部画在固定 36x36 的设计基准里，再由 Viewbox 等比缩放到
         实际内容区——骰面被压到多小，点阵/数字都按同一比例收缩，永远不会比骰面大而被
         卡片裁掉。旧实现手算点径与字号（9*scale / 24*scale），D20/D100 这类多位数字
         在小骰面上会撑破骰面，正是 2x2 下"点数溢出被截断"的来源。
         Margin=4 为投影留呼吸空间：blur 2 无偏移的最大溢出 2px < 4px，
         否则阴影画出宿主槽位被直角边界截断（四角"被方框拦截"的观感）。
         投影 offsetY=0（对称光晕）：带偏移的阴影会让视觉包络下移，点阵看起来不居中。  -->
    <Border x:Name="FaceBorder"
            Width="48" Height="48"
            Background="{DynamicResource PillBackground}"
            CornerRadius="10"
            BoxShadow="0 0 2 0 #14000000"
            Margin="4"
            Padding="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <!--  设计基准 36x36（= 48 - 2*6 padding）；Viewbox 把整块内容等比缩放到实际内容区。  -->
        <Viewbox x:Name="ContentScaler" Stretch="Uniform" StretchDirection="Both"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Panel x:Name="ContentPanel" Width="36" Height="36">
                <!-- Numbers mode：宽度锁定设计基准，字号由 code-behind 按位数收敛，
                     三位数（D100）也不会超出 36 的设计宽度。  -->
                <TextBlock x:Name="NumberText"
                           Width="36"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           FontSize="24"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                <!-- D6 Dots Grid -->
                <Grid x:Name="DotsGrid" IsVisible="False"
                      RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                    <Ellipse x:Name="DotTL" Grid.Row="0" Grid.Column="0" Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotML" Grid.Row="1" Grid.Column="0" Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotBL" Grid.Row="2" Grid.Column="0" Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!--  中式传统红：仅 1 点显示（由 code-behind 控制可见性）  -->
                    <Ellipse x:Name="DotCenterAccent" Grid.Row="1" Grid.Column="1" Width="10" Height="10" Fill="{DynamicResource DiceFaceOneDotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                    <Ellipse x:Name="DotCenter" Grid.Row="1" Grid.Column="1" Width="10" Height="10" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Ellipse x:Name="DotTR" Grid.Row="0" Grid.Column="2" Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotMR" Grid.Row="1" Grid.Column="2" Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotBR" Grid.Row="2" Grid.Column="2" Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Panel>
        </Viewbox>
    </Border>
</UserControl>
