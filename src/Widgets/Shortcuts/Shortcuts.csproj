<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <OutputPath>..\..\DeskCanvas\bin\$(Configuration)\net10.0\Widgets</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <NoWarn>$(NoWarn);AVLN3001;CA1416</NoWarn>
        <RootNamespace>Shortcuts</RootNamespace>
        <AssemblyName>Shortcuts</AssemblyName>
        <Version>1.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" PrivateAssets="all" ExcludeAssets="runtime">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Drawing.Common" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DeskCanvas.Core\DeskCanvas.Core.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
        <ProjectReference Include="..\..\DeskCanvas\DeskCanvas.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Locales\Locale.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Locale.Designer.cs</LastGenOutput>
            <LogicalName>Shortcuts.Locales.Locale.resources</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Update="Locales\Locale.zh-Hans.resx">
            <LogicalName>Shortcuts.Locales.Locale.zh-Hans.resources</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Locales\Locale.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Locale.resx</DependentUpon>
            <Generator>PublicResXFileCodeGenerator</Generator>
        </Compile>
    </ItemGroup>

</Project>
