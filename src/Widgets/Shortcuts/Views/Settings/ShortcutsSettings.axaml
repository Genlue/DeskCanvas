<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Shortcuts.Locales"
             x:Class="Shortcuts.Views.Settings.ShortcutsSettings"
             controls:SettingsPage.ScrollOwnership="Host">

    <StackPanel Orientation="Vertical" Spacing="5" Margin="0,0,10,0">
        <controls:Setting Title="{x:Static locales:Locale.Shortcuts_Settings_MaxTiles}">
            <ComboBox x:Name="MaxTilesCombo" MinWidth="180" SelectionChanged="OnMaxTilesChanged" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Shortcuts_Settings_Confirm}">
            <ToggleSwitch x:Name="ConfirmSwitch" IsCheckedChanged="OnConfirmChanged"
                          OnContent="" OffContent="" />
        </controls:Setting>

        <controls:Setting Title="{x:Static locales:Locale.Shortcuts_Settings_Edit}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="ShortcutCombo" MinWidth="150" />
                <Button x:Name="OpenEditorButton"
                        Content="{x:Static locales:Locale.Shortcuts_Settings_Open}"
                        Click="OnOpenEditorClicked" />
            </StackPanel>
        </controls:Setting>

        <TextBlock Text="{x:Static locales:Locale.Shortcuts_Settings_Hint}"
                   FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,6,0,0" />

        <!-- AI 帮写：把「生成工作流 JSON」这件事交给任意对话模型。
             规范由代码生成（ActionCatalog + 端口表），新增动作/端口会自动出现在提示词里。 -->
        <Border Margin="0,12,0,0"
                Padding="14,12"
                CornerRadius="10"
                Background="{DynamicResource SettingsFloatingCardBackground}"
                BorderBrush="{DynamicResource SettingsFloatingCardBorder}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Static locales:Locale.Shortcuts_Ai_Title}"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static locales:Locale.Shortcuts_Ai_Desc}"
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="CopySpecButton"
                            Content="{x:Static locales:Locale.Shortcuts_Spec_Copy}"
                            Click="OnCopySpecClicked" />
                    <Button x:Name="ImportJsonButton"
                            Content="{x:Static locales:Locale.Shortcuts_Canvas_Import}"
                            Click="OnImportJsonClicked" />
                    <Button x:Name="PreviewSpecButton"
                            Content="{x:Static locales:Locale.Shortcuts_Spec_Preview}"
                            Click="OnPreviewSpecClicked" />
                </StackPanel>
                <TextBox x:Name="SpecPreview"
                         IsVisible="False"
                         Height="260"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="AiStatusText"
                           FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
