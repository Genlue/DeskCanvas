<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Hitokoto.Locales"
             x:Class="Hitokoto.Views.Settings.HitokotoSettings"
             controls:SettingsPage.ScrollOwnership="Host">

    <!-- 滚动契约：Host —— 页面不再自带外层 ScrollViewer，唯一竖向滚动所有者是宿主 EditWidget
         的内容视口。分组标题走共享 dc-section-header；cat-check 只约束分类复选框的间距与字号，
         是本页业务布局而非通用基础样式，允许保留。 -->

    <UserControl.Styles>
        <Style Selector="CheckBox.cat-check">
            <Setter Property="Margin" Value="0,2,12,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,2,8,10">
        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Hitokoto_SectionAppearance}" />

        <controls:Setting x:Name="StyleModeSetting" Title="{x:Static locales:Locale.Hitokoto_StyleMode}" Subtitle="{x:Static locales:Locale.Hitokoto_StyleMode_Subtitle}">
            <ComboBox x:Name="StyleModeCombo" MinWidth="168" SelectionChanged="OnStyleModeChanged" />
        </controls:Setting>

        <controls:Setting x:Name="FramelessSetting" Title="{x:Static locales:Locale.Hitokoto_Frameless}" Subtitle="{x:Static locales:Locale.Hitokoto_Frameless_Subtitle}">
            <ToggleSwitch x:Name="FramelessToggle" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting x:Name="AutoHideActionsSetting" Title="{x:Static locales:Locale.Hitokoto_AutoHideActions}" Subtitle="{x:Static locales:Locale.Hitokoto_AutoHideActions_Subtitle}">
            <ToggleSwitch x:Name="AutoHideActionsToggle" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting x:Name="ShowCategorySetting" Title="{x:Static locales:Locale.Hitokoto_ShowCategory}" Subtitle="{x:Static locales:Locale.Hitokoto_ShowCategory_Subtitle}">
            <ToggleSwitch x:Name="ShowCategoryToggle" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting x:Name="ShowAttributionSetting" Title="{x:Static locales:Locale.Hitokoto_ShowAttribution}" Subtitle="{x:Static locales:Locale.Hitokoto_ShowAttribution_Subtitle}">
            <ToggleSwitch x:Name="ShowAttributionToggle" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting x:Name="ShowLikesSetting" Title="{x:Static locales:Locale.Hitokoto_ShowLikes}" Subtitle="{x:Static locales:Locale.Hitokoto_ShowLikes_Subtitle}">
            <ToggleSwitch x:Name="ShowLikesToggle" IsCheckedChanged="OnToggleChanged" />
        </controls:Setting>

        <controls:Setting x:Name="FontFamilySetting" Title="{x:Static locales:Locale.Hitokoto_FontFamily}" Subtitle="{x:Static locales:Locale.Hitokoto_FontFamily_Subtitle}">
            <ComboBox x:Name="FontFamilyCombo" MinWidth="168" SelectionChanged="OnFontFamilyChanged" />
        </controls:Setting>

        <controls:Setting x:Name="FontSizeSetting" Title="{x:Static locales:Locale.Hitokoto_FontSize}" Subtitle="{x:Static locales:Locale.Hitokoto_FontSize_Subtitle}">
            <NumericUpDown x:Name="FontSizeBox" MinWidth="128" Minimum="0" Maximum="28"
                           Increment="1" FormatString="F0" ParsingNumberStyle="Integer"
                           ValueChanged="OnNumericChanged" />
        </controls:Setting>

        <TextBlock Classes="dc-section-header" Text="{x:Static locales:Locale.Hitokoto_SectionFilter}" />

        <controls:Setting x:Name="IntervalSetting" Title="{x:Static locales:Locale.Hitokoto_Interval}" Subtitle="{x:Static locales:Locale.Hitokoto_Interval_Subtitle}">
            <ComboBox x:Name="IntervalCombo" MinWidth="168" SelectionChanged="OnIntervalChanged" />
        </controls:Setting>

        <controls:Setting x:Name="CategoriesSetting" Title="{x:Static locales:Locale.Hitokoto_Categories}" Subtitle="{x:Static locales:Locale.Hitokoto_Categories_Subtitle}">
            <Button x:Name="ResetCategoriesBtn" Content="{x:Static locales:Locale.Hitokoto_ResetCategories}" FontSize="11" Click="OnResetCategoriesClicked" />
        </controls:Setting>

        <!-- 分类复选框容器：#12808080 是本页业务容器的浅色底（分类胶囊面板），非通用灰文本色 -->
        <Border Background="#12808080" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,8" Margin="2,0,2,4">
            <WrapPanel x:Name="CategoriesWrap" Orientation="Horizontal" />
        </Border>

        <controls:Setting x:Name="MinLengthSetting" Title="{x:Static locales:Locale.Hitokoto_MinLength}" Subtitle="{x:Static locales:Locale.Hitokoto_MinLength_Subtitle}">
            <NumericUpDown x:Name="MinLengthBox" MinWidth="128" Minimum="0" Maximum="80"
                           Increment="5" FormatString="F0" ParsingNumberStyle="Integer"
                           ValueChanged="OnNumericChanged" />
        </controls:Setting>

        <controls:Setting x:Name="MaxLengthSetting" Title="{x:Static locales:Locale.Hitokoto_MaxLength}" Subtitle="{x:Static locales:Locale.Hitokoto_MaxLength_Subtitle}">
            <NumericUpDown x:Name="MaxLengthBox" MinWidth="128" Minimum="10" Maximum="120"
                           Increment="5" FormatString="F0" ParsingNumberStyle="Integer"
                           ValueChanged="OnNumericChanged" />
        </controls:Setting>

        <controls:Setting x:Name="CustomApiSetting" Title="{x:Static locales:Locale.Hitokoto_CustomApi}" Subtitle="{x:Static locales:Locale.Hitokoto_CustomApi_Subtitle}">
            <!-- Watermark 是官方接口地址示例（示例数据，合法例外），不是界面文案 -->
            <TextBox x:Name="CustomApiBox" MinWidth="210" PlaceholderText="https://v1.hitokoto.cn/"
                     LostFocus="OnCustomApiLostFocus" />
        </controls:Setting>
    </StackPanel>
</UserControl>
