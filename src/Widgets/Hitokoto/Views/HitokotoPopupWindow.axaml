<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        xmlns:ui="using:DeskCanvas.UI.Controls"
        x:Class="Hitokoto.Views.HitokotoPopupWindow"
        Title="一言 · 灵感收纳箱"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Width="480"
        Height="560">

    <Window.Styles>
        <Style Selector="Border.quote-item-card">
            <Setter Property="Background" Value="{DynamicResource CardSubtleFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardSubtleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardSubtleCornerRadius}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style Selector="Border.quote-item-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource PillHoverBackground}" />
        </Style>
    </Window.Styles>

    <!-- The shared secondary-panel shell (W7) owns the card, the glass, the header with the
         drag area and the shared close button, and the backdrop-dismiss rule. This window
         declares ONLY business content. The shell's default ContentPadding (16,14,16,12)
         replaces the old content grid margin (18,15,18,14 — 2 DIP narrower each side, the
         deliberate convergence); the header strip replaces the old title row and the drag is
         confined to it — the spotlight card, the search box, the tabs and the list never move
         the window any more. The dynamic title (headline + category badge) lives in the
         HeaderContent slot, like the Clipboard pilot's counter badge. -->
    <controls:SecondaryPanelShell>
        <controls:SecondaryPanelShell.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="一言 · 灵感收纳箱" FontSize="15" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Classes="dc-badge" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentCategoryBadge" Text="一言" />
                </Border>
            </StackPanel>
        </controls:SecondaryPanelShell.HeaderContent>

        <Panel>
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <!-- Row 0: Current Quote Spotlight Card -->
                <Border Grid.Row="0" Classes="dc-card-box" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="SpotlightMetaText" Text="hitokoto.cn" FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="OpenWebBtn" Classes="action-pill" Padding="8,2" FontSize="11"
                                    Content="网页详情" Click="OnOpenWebClicked" />
                        </Grid>

                        <TextBlock x:Name="SpotlightQuoteText" Text="往者不可谏，来者犹可追。"
                                   FontSize="15" FontWeight="Medium" TextWrapping="Wrap" LineHeight="23" />

                        <TextBlock x:Name="SpotlightFromText" Text="—— 孔子《论语·微子篇》"
                                   FontSize="12" Opacity="0.75" HorizontalAlignment="Right" />

                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button x:Name="SpotlightNextBtn" Classes="action-pill" Margin="0,0,6,4"
                                    Content="换一句" Click="OnNextQuoteClicked" />
                            <Button x:Name="SpotlightLikeBtn" Classes="action-pill" Margin="0,0,6,4"
                                    Content="点赞 (0)" Click="OnLikeCurrentClicked" />
                            <Button x:Name="SpotlightFavBtn" Classes="action-pill" Margin="0,0,6,4"
                                    Content="收藏" Click="OnToggleFavCurrentClicked" />
                            <Button x:Name="CopyPlainBtn" Classes="action-pill" Margin="0,0,6,4"
                                    Content="复制文本" Click="OnCopyPlainClicked" />
                            <Button x:Name="CopyMarkdownBtn" Classes="action-pill" Margin="0,0,0,4"
                                    Content="复制 Markdown" Click="OnCopyMarkdownClicked" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Row 1: Search Box -->
                <Border Grid.Row="1" Background="{DynamicResource CardSubtleFill}" CornerRadius="{DynamicResource CardSubtleCornerRadius}" Padding="10,5" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Data="{x:Static ui:CommonGlyphs.Search}" Width="13" Height="13"
                              Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Opacity="0.7" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0"
                                 PlaceholderText="搜索收藏或偶遇过的句子、出处、作者..." FontSize="12"
                                 Padding="0,2" VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />
                    </Grid>
                </Border>

                <!-- Row 2: Tabs (Favorites / History) -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="TabFavorites" Classes="tab-pill active" Content="本地收藏 (0)"
                                Click="OnTabClicked" Tag="Favorites" />
                        <Button x:Name="TabHistory" Classes="tab-pill" Content="最近偶遇 (0)"
                                Click="OnTabClicked" Tag="History" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="ClearHistoryBtn" Classes="action-pill"
                            Content="清空历史" FontSize="11" Padding="8,3"
                            IsVisible="False" Click="OnClearHistoryClicked" />
                </Grid>

                <!-- Row 3: Items List -->
                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ItemsStack" Orientation="Vertical" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyStateText"
                               Text="暂无收藏句子，点击上方「收藏」即可收入摘抄本"
                               FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="False" />
                </Grid>
            </Grid>

            <!-- Toast Banner: an overlay at the bottom of the business content (the shell's card
                 itself is off limits — the window no longer owns any card-level chrome). -->
            <Border x:Name="ToastBanner" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{DynamicResource SystemControlHighlightAccentBrush}"
                    CornerRadius="14" Padding="14,5" Margin="0,0,0,16"
                    IsVisible="False" ZIndex="30">
                <TextBlock x:Name="ToastText" Text="已复制" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentContrastForegroundBrush}" />
            </Border>
        </Panel>
    </controls:SecondaryPanelShell>
</Window>
