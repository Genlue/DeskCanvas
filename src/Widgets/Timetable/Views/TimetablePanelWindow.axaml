<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        x:Class="Timetable.Views.TimetablePanelWindow"
        Title="Timetable"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Width="580"
        Height="670">


    <Panel Background="Transparent" PointerPressed="OnRootPointerPressed">
        <Border x:Name="CardBorder"
                Margin="0"
                CornerRadius="18"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                ClipToBounds="True">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
            </Border.RenderTransform>

            <Panel>
                <controls:LiquidGlassSurface x:Name="LiquidGlassSurfaceControl" CornerRadius="18" Margin="0" IsVisible="False" />

                <Grid RowDefinitions="Auto,*" Margin="20,16,20,16">
                    <!-- Header: title + week badge + close -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitleText" FontSize="15" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Background="#20808080" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock x:Name="WeekBadgeText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="CloseButton" Classes="icon-btn" Content="✕"
                                Click="OnCloseClicked" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>

                    <!-- Scrollable body: the full week grid, then the course notes. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Spacing="12" Margin="0,0,6,0">
                            <Grid x:Name="PanelGridHost" />
                            <Border x:Name="NotesCard" Background="#12808080" CornerRadius="10"
                                    Padding="12,9" IsVisible="False">
                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <TextBlock x:Name="NotesHeaderText" FontSize="12" FontWeight="SemiBold" Opacity="0.75" />
                                    <StackPanel x:Name="NotesPanel" Orientation="Vertical" Spacing="4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Panel>
        </Border>
    </Panel>
</Window>
