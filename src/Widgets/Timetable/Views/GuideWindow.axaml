<views:HostDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Timetable.Views"
        xmlns:ui="using:DeskCanvas.UI.Controls"
        x:Class="Timetable.Views.GuideWindow"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Width="652" Height="692" MinWidth="492" MinHeight="452">

    <!-- 导入指南: shared dialog chrome (card + draggable header + Escape). Window size is the old
         card size plus 2 × the shell's shadow gutter, so the content keeps its 588 DIP width. -->
    <ui:DialogShell>
        <ui:DialogShell.HeaderContent>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HintText" FontSize="{DynamicResource FontSizeCaption}"
                           Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
        </ui:DialogShell.HeaderContent>

        <Grid RowDefinitions="*,Auto">
            <Border Grid.Row="0" Background="{DynamicResource CardSubtleFill}" CornerRadius="8" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="GuideText" TextWrapping="Wrap"
                                         FontSize="12.5" LineHeight="19" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <Button x:Name="CopyPromptButton" HorizontalAlignment="Left" Click="OnCopyPromptClicked" />
                <Button Grid.Column="1" x:Name="CloseButton" Click="OnCloseClicked" />
            </Grid>
        </Grid>
    </ui:DialogShell>
</views:HostDialogWindow>
