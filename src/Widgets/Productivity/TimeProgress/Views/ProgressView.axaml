<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Progress.Controls"
             xmlns:viewModels="clr-namespace:Progress.ViewModels"
             x:Class="Progress.Views.ProgressView"
             x:DataType="viewModels:ProgressViewModel">

    <Grid RowDefinitions="Auto,*" Margin="4">
        <!-- Header Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8" IsVisible="{Binding ShowHeader}">
            <!-- Title -->
            <TextBlock Text="{Binding TitleText}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Progress & Percentage -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}"
                           FontSize="10.5"
                           Opacity="0.65"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ShowCount}"/>

                <TextBlock Text="{Binding PercentageText}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Opacity="0.9"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ShowPercentage}"/>
            </StackPanel>
        </Grid>

        <!-- Dot Matrix -->
        <controls:DotMatrixControl Classes="elem-shadow"
                                   Grid.Row="1"
                                   TotalDots="{Binding TotalDots}"
                                   PassedDots="{Binding PassedDots}"
                                   HasCurrentDot="{Binding HasCurrentDot}"
                                   PassedBrush="{Binding PassedBrush}"
                                   CurrentBrush="{Binding CurrentBrush}"
                                   RemainingBrush="{Binding RemainingBrush}"
                                   DotShape="{Binding DotShape}"
                                   PreferredColumns="{Binding PreferredColumns}"
                                   DotTooltipFunc="{Binding DotTooltipFunc}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
