<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             xmlns:locales="clr-namespace:Calendar.Locales"
             x:Class="Calendar.Views.Controls.ScheduleLarge"
             x:DataType="viewModels:ScheduleViewModel"
             Margin="10,8,10,10">

    <UserControl.Styles>
        <Style Selector="Button.ActionBtn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.DayBtn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DayBtn:pointerover">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button.EventItemBtn">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.EventItemBtn:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MonthYear}"
                                   FontSize="15"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding WeekNumberText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                                        <Button Grid.Column="1" Classes="ActionBtn"
                            CornerRadius="8" Padding="6,2"
                            Click="OnOpenPanelClicked"
                            ToolTip.Tip="{x:Static locales:Locale.Calendar_Schedule_OpenPanel}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="M4,9 L4,5 C4,4.4477 4.4477,4 5,4 L9,4 M15,4 L19,4 C19.5523,4 20,4.4477 20,5 L20,9 M20,15 L20,19 C20,19.5523 19.5523,20 19,20 L15,20 M9,20 L5,20 C4.4477,20 4,19.5523 4,19 L4,15"
                                  Stroke="{DynamicResource TextControlForeground}"
                                  StrokeThickness="1.5" StrokeLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="管理" FontSize="11" FontWeight="SemiBold" Opacity="0.75" />
                        </StackPanel>
                    </Button>
                </Grid>

                                <UniformGrid Columns="7">
                    <TextBlock Text="一" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="二" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="三" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="四" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="五" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource CalendarHeaderBrush}" />
                    <TextBlock Text="六" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.35" />
                    <TextBlock Text="日" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Opacity="0.35" />
                </UniformGrid>

                                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="viewModels:ScheduleDayViewModel">
                            <Button Classes="DayBtn" Click="OnDayItemClicked" Tag="{Binding Date}">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <Panel Width="22" Height="22">
                                                                                <Ellipse IsVisible="{Binding IsToday}"
                                                 Fill="{DynamicResource CalendarHeaderBrush}"
                                                 Width="22" Height="22" />
                                        <TextBlock Text="{Binding Day}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsToday}" />
                                        <TextBlock Text="{Binding Day}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsToday}"
                                                   Foreground="{DynamicResource AccentContrastForegroundBrush}" />
                                    </Panel>
                                                                        <Ellipse IsVisible="{Binding HasEvents}"
                                             Width="3.5" Height="3.5"
                                             Fill="{Binding DotBrush}"
                                             HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

                <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="{Binding SelectedDateTitle}"
                           FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedDateEvents.Count, StringFormat='共 {0} 项'}"
                           FontSize="11" Opacity="0.5" />
            </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="5">
                    <ItemsControl ItemsSource="{Binding SelectedDateEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="viewModels:ScheduleItemViewModel">
                                <Button Classes="EventItemBtn" HorizontalAlignment="Stretch"
                                        Tag="{Binding Id}" Click="OnEventItemClicked" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                <Border Grid.Column="0" Width="3.5" CornerRadius="2"
                                                Background="{Binding ColorBrush}"
                                                Margin="0,0,8,0" VerticalAlignment="Stretch" />

                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding TimeRangeText}"
                                                           FontSize="10.5" Opacity="0.6" FontWeight="SemiBold" />
                                                <TextBlock Text="·" FontSize="10.5" Opacity="0.4"
                                                           IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{Binding Location}"
                                                           FontSize="10.5" Opacity="0.5"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>
                                        </StackPanel>

                                                                                <Border Grid.Column="2" VerticalAlignment="Center"
                                                CornerRadius="4" Padding="5,1.5"
                                                Background="{DynamicResource ControlHoverBrush}"
                                                IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Opacity="0.8" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                                        <StackPanel IsVisible="{Binding !SelectedDateEvents.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" Margin="0,16,0,0">
                        <TextBlock Text="该日期无日程安排" FontSize="12" FontWeight="Bold" Opacity="0.5" HorizontalAlignment="Center" />
                        <TextBlock Text="可点击上方「管理」添加新日程" FontSize="11" Opacity="0.4" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
