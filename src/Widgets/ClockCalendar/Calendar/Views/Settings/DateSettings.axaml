<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
             xmlns:locales="clr-namespace:Calendar.Locales"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             x:Class="Calendar.Views.Settings.DateSettings"
             x:DataType="viewModels:DateSettingsViewModel"
             controls:SettingsPage.ScrollOwnership="Host">
    <StackPanel Orientation="Vertical" Spacing="6" Margin="{DynamicResource SettingsPagePadding}">
        <controls:Setting Title="{x:Static locales:Locale.Calendar_ShowLunar}"
                          Subtitle="{x:Static locales:Locale.Calendar_ShowLunar_Subtitle}">
            <ToggleSwitch IsChecked="{Binding ShowLunar}" OnContent="" OffContent="" />
        </controls:Setting>
    </StackPanel>
</UserControl>