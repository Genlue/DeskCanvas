<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Calendar.Views.Controls"
             xmlns:viewModels="clr-namespace:Calendar.ViewModels"
             x:Class="Calendar.Views.Date"
             x:DataType="viewModels:DateCalendarViewModel"
             Margin="0">
    <!-- Full-bleed card; local Margin=0 overrides the host inset. -->
    <Border Background="{DynamicResource CalendarCardBackground}"
            CornerRadius="{DynamicResource WidgetCardCornerRadius}"
            ClipToBounds="True">
        <controls:DateFace x:Name="Face"
                           Header="{Binding Header}"
                           Day="{Binding Day}"
                           Lunar="{Binding LunarDate}"
                           ShowLunar="{Binding ShowLunar}"
                           HeaderBrush="{DynamicResource CalendarHeaderBrush}"
                           DayBrush="{DynamicResource WidgetForeground}"
                           LunarBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Border>
</UserControl>