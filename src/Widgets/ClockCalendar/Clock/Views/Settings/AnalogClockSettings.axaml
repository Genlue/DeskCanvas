<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskCanvas.Views.Controls;assembly=DeskCanvas"
        xmlns:locales="clr-namespace:Clock.Locales"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:viewModels="clr-namespace:Clock.ViewModels"
        x:Class="Clock.Views.Settings.AnalogClockSettings"
        x:DataType="viewModels:AnalogClockSettingsViewModel"
        controls:SettingsPage.ScrollOwnership="Host">
    <!-- Scroll ownership: Host — the page has no outer ScrollViewer of its own, the EditWidget
         content viewport is the single vertical scroll owner. -->
    <StackPanel Orientation="Vertical" Spacing="5" Margin="0 0 10 0">
        <controls:Setting Title="{x:Static locales:Locale.Clock_ShowSeconds}">
            <ToggleSwitch IsChecked="{Binding ShowSeconds}"/>
        </controls:Setting>

        <controls:Setting IsVisible="{Binding Show24HoursSetting}" Title="{x:Static locales:Locale.Clock_Use24Hours}">
            <ToggleSwitch IsChecked="{Binding Use24Hours}"/>
        </controls:Setting>

        <controls:Setting IsVisible="{Binding ShowDateSetting}" Title="{x:Static locales:Locale.Clock_ShowDate}">
            <ToggleSwitch IsChecked="{Binding ShowDate}"/>
        </controls:Setting>

        <controls:Setting IsVisible="{Binding ShowDialOpaqueSetting}"
                          Title="{x:Static locales:Locale.Clock_DialOpaque}">
            <ToggleSwitch IsChecked="{Binding IsDialOpaque}"/>
        </controls:Setting>

        <StackPanel Orientation="Vertical" Spacing="5" IsVisible="{Binding ShowDialColorSetting}">
            <!-- 表盘颜色模式：跟随背景 / 黑白 / 自定义 -->
            <controls:Setting Title="{x:Static locales:Locale.Clock_DialColor_Title}">
                <!-- MinWidth, not Width: the option list grows with the locale instead of
                     clipping; MinWidth only guarantees the row's usable floor. -->
                <ComboBox MinWidth="130" HorizontalAlignment="Right"
                          ItemsSource="{Binding DialColorModes}"
                          SelectedItem="{Binding DialColorMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:DialColorModeOption">
                            <TextBlock Text="{Binding Name}" Margin="0 4" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:Setting>

            <!-- 自定义模式下的明暗双色：alpha 不参与表盘着色，故两行恒写不透明 RGB -->
            <controls:Setting IsVisible="{Binding ShowDialColorPickers}"
                              Title="{x:Static locales:Locale.Clock_DialColor_Dark}">
                <controls:ColorInput Name="DialColorDarkInput" ColorFormat="Rgb" AlphaPolicy="ForceOpaque"
                                     AutomationProperties.Name="{x:Static locales:Locale.Clock_DialColor_Dark}" />
            </controls:Setting>

            <controls:Setting IsVisible="{Binding ShowDialColorPickers}"
                              Title="{x:Static locales:Locale.Clock_DialColor_Light}">
                <controls:ColorInput Name="DialColorLightInput" ColorFormat="Rgb" AlphaPolicy="ForceOpaque"
                                     AutomationProperties.Name="{x:Static locales:Locale.Clock_DialColor_Light}" />
            </controls:Setting>
        </StackPanel>

        <controls:Setting Title="{x:Static locales:Locale.Clock_LocalTimeZone}">
            <ToggleSwitch IsChecked="{Binding UseLocalTimeZone}"/>
        </controls:Setting>
        <controls:Setting IsVisible="{Binding ShowTimeZones}" Title="{x:Static locales:Locale.Clock_TimeZone}">
            <ComboBox ItemsSource="{Binding TimeZones}" MinWidth="130" SelectedValue="{Binding TimeZone}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="system:TimeZoneInfo">
                        <TextBlock Text="{Binding  DisplayName}" Margin="0 4" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:Setting>
    </StackPanel>
</UserControl>
