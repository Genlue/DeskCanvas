<Project>

  <!--
    Central Package Management (CPM): all package versions live here.
    Projects reference packages WITHOUT a Version attribute.
    Bump a version in one place -> every project (app, core, widgets) follows.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 全家桶：主程序与所有小组件共用同一版本 -->
    <PackageVersion Include="Avalonia" Version="11.1.3" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="11.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="11.1.3" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.1.3" />
    <PackageVersion Include="SkiaSharp" Version="2.88.8" />

    <!-- .NET 官方包 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageVersion Include="System.Management" Version="8.0.0" />

    <!-- 小组件第三方依赖 -->
    <PackageVersion Include="TimeZoneNames" Version="6.0.0" />
    <PackageVersion Include="Markdig" Version="0.34.0" />
  </ItemGroup>

</Project>
